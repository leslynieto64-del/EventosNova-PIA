ly=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="105.0" y="320.0" width="270.0" height="136.5" as="geometry" /></mxCell><mxCell id="Contrato" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Contrato&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620.0" y="170.0" width="360.0" height="114.0" as="geometry" /></mxCell><mxCell id="AnexoContrato" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;AnexoContrato&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• formaliza cambio, servicio adicional o sustitución&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="680.0" y="360.0" width="240.0" height="89.0" as="geometry" /></mxCell><mxCell id="Evento" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Evento&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1290.0" y="170.0" width="280.0" height="143.5" as="geometry" /></mxCell><mxCell id="SolicitudCancelacion" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;SolicitudCancelacion&lt;/b&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1180.0" y="360.0" width="240.0" height="84.5" as="geometry" /></mxCell><mxCell id="ServicioContratado" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;ServicioContratado&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• configuración operativa vigente&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1440.0" y="360.0" width="240.0" height="104.5" as="geometry" /></mxCell><mxCell id="Cliente" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad de referencia»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Cliente&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• clienteId&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.6;dashed=1;dashPattern=6 4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="610.0" width="170.0" height="73.0" as="geometry" /></mxCell><mxCell id="Proveedor" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad de referencia»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Proveedor&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• proveedorId&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.6;dashed=1;dashPattern=6 4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1780.0" y="560.0" width="190.0" height="73.0" as="geometry" /></mxCell><mxCell id="SolicitudCambio" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;SolicitudCambio&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="760.0" y="630.0" width="400.0" height="202.5" as="geometry" /></mxCell><mxCell id="SolicitudServicioAdicional" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;SolicitudServicioAdicional&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• proveedorId del proveedor que prestará el servicio&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="280.0" y="630.0" width="400.0" height="252.0" as="geometry" /></mxCell><mxCell id="SustitucionProveedor" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;SustitucionProveedor&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• servicio afectado: eventoId + servicioContratadoId&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1240.0" y="630.0" width="440.0" height="134.0" as="geometry" /></mxCell><mxCell id="AlternativaPropuesta" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:13.5px&quot;&gt;AlternativaPropuesta (lista)&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• proveedorId · DisponibilidadProveedor · ImpactoModificacion&lt;br&gt;• decisionCliente y autorizacionAdministracion : Decision (si hay impacto)&lt;br&gt;• papel de «proveedor alternativo» (GL-030); no es entidad&lt;/div&gt;" style="rounded=1;arcSize=22;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.2;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270.0" y="778.0" width="380.0" height="135.5" as="geometry" /></mxCell><mxCell id="EstadoCuenta" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;EstadoCuenta&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• Saldo general = saldo pendiente del contrato original + importes adicionales de sustitución que deben integrarse al saldo general. Cálculo derivado, sin duplicar obligaciones.&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="700.0" y="1056.0" width="580.0" height="89.0" as="geometry" /></mxCell><mxCell id="ObligacionPago" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;ObligacionPago&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• origen: contrato, solicitud o sustitución (ID)&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="580.0" y="1180.0" width="300.0" height="134.0" as="geometry" /></mxCell><mxCell id="Pago" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Pago&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• aplica a una sola obligación&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="910.0" y="1180.0" width="230.0" height="104.5" as="geometry" /></mxCell><mxCell id="Devolucion" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Devolucion&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• motivoDevolucion, fecha y comprobante&lt;br&gt;• ≤ 5 días hábiles tras el cierre (SE-012)&lt;br&gt;• Devolución A (anticipo): ≤ 5 días hábiles desde la referencia&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1170.0" y="1180.0" width="230.0" height="152.5" as="geometry" /></mxCell><mxCell id="EvaluarRegularizacionDeSolicitudes" value="&lt;i style=&quot;font-size:11px;color:#166534&quot;&gt;«Domain Service»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;EvaluarRegularizacionDeSolicitudes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;Entradas: saldo y cargos moratorios (EstadoCuenta), estado del Evento&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;y condición temporal que informa la propia solicitud&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=22;fixedSize=1;whiteSpace=wrap;html=1;spacingLeft=18;spacingRight=18;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40.0" y="1030.0" width="440.0" height="84.0" as="geometry" /></mxCell><mxCell id="EvaluarImpactoCambio" value="&lt;i style=&quot;font-size:11px;color:#166534&quot;&gt;«Domain Service»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;EvaluarImpactoCambio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;Compara la configuración vigente del Evento con la modificación&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;propuesta → ImpactoModificacion&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=22;fixedSize=1;whiteSpace=wrap;html=1;spacingLeft=18;spacingRight=18;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1470.0" y="1030.0" width="490.0" height="84.0" as="geometry" /></mxCell><mxCell id="v0-lghex" value="&lt;b style=&quot;font-size:14px&quot;&gt;Domain Service&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=22;fixedSize=1;whiteSpace=wrap;html=1;spacingLeft=18;spacingRight=18;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="54.0" y="1266.0" width="170.0" height="40.0" as="geometry" /></mxCell><mxCell id="Coordinador" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Actor»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Coordinador&lt;/b&gt;&lt;div style=&quot;