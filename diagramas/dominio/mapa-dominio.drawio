<mxfile host="app.diagrams.net" agent="Etapa3-EventosNova" version="24.7.17" type="device"><diagram id="p-all" name="00 — TODAS LAS VISTAS"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="7080" pageHeight="4331" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="all-title" value="&lt;b&gt;Eventos Nova · Mapa de dominio — todas las vistas&lt;/b&gt;" style="text;html=1;fontFamily=Inter;fontSize=56;fontColor=#0F172A;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="2400" height="80" as="geometry" /></mxCell><mxCell id="all-sub" value="Cinco diagramas editables a escala real: 1 Vista general · 2 Detalle A · 3 Detalle B · 4 Detalle C · 5 Detalle D. Cada vista es un grupo: doble clic para editar sus elementos. Las páginas 01–05 contienen las mismas vistas por separado. Modelo v1.4." style="text;html=1;fontFamily=Inter;fontSize=26;fontColor=#475569;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="3600" height="44" as="geometry" /></mxCell><mxCell id="all-sec1" value="" style="rounded=1;arcSize=1;absoluteArcSize=1;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="2060" height="1600" as="geometry" /></mxCell><mxCell id="all-sec1-t" value="&lt;b&gt;1 · Vista general del mapa de dominio&lt;/b&gt;" style="text;html=1;fontFamily=Inter;fontSize=40;fontColor=#1E3A8A;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="80" y="275" width="2000" height="70" as="geometry" /></mxCell><mxCell id="v1-grupo" value="" style="group;" vertex="1" connectable="0" parent="1"><mxGeometry x="80" y="380" width="2000" height="1450" as="geometry" /></mxCell><mxC