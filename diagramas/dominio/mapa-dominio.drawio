tartArrow=none;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="v4-grupo" source="v4-s4" target="v4-s7"><mxGeometry relative="1" as="geometry"><mxPoint x="1160.0" y="1396.0" as="sourcePoint" /><mxPoint x="1160.0" y="1412.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v4-vC-l31-lbl" value="no" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=11;fontStyle=0;fontColor=#475569;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="v4-grupo"><mxGeometry x="1168.0" y="1394.0" width="26.1" height="20.0" as="geometry" /></mxCell><mxCell id="v4-vC-l32" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=10.5;strokeColor=#475569;strokeWidth=1.4;fontColor=#475569;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;startArrow=none;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="v4-grupo" source="v4-s3" target="v4-s5"><mxGeometry relative="1" as="geometry"><mxPoint x="1270.0" y="1224.0" as="sourcePoint" /><mxPoint x="1400.0" y="1222.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v4-vC-l32-lbl" value="no" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=10.5;fontStyle=0;fontColor=#475569;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="v4-grupo"><mxGeometry x="1317.3" y="1204.2" width="25.4" height="19.5" as="geometry" /></mxCell><mxCell id="v4-vC-l33" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=10.5;strokeColor=#475569;strokeWidth=1.4;fontColor=#475569;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;startArrow=none;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="v4-grupo" source="v4-s4" target="v4-s6"><mxGeometry relative="1" as="geometry"><mxPoint x="1270.0" y="1348.0" as="sourcePoint" /><mxPoint x="1400.0" y="1348.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v4-vC-l33-lbl" value="sí" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=10.5;fontStyle=0;fontColor=#475569;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="v4-grupo"><mxGeometry x="1319.6" y="1328.2" width="20.8" height="19.5" as="geometry" /></mxCell><mxCell id="v4-vC-l34" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=10.5;strokeColor=#475569;strokeWidth=1.4;fontColor=#475569;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;startArrow=none;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="v4-grupo" source="v4-s7" target="v4-s8"><mxGeometry relative="1" as="geometry"><mxPoint x="1300.0" y="1440.0" as="sourcePoint" /><mxPoint x="1400.0" y="1440.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v4-vC-lsl1" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;startArrow=none;endArrow=block;endFill=1;" edge="1" parent="v4-grupo"><mxGeometry relative="1" as="geometry"><mxPoint x="302.0" y="1586.0" as="sourcePoint" /><mxPoint x="362.0" y="1586.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v4-vC-lsl2" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#B91C1C;strokeWidth=1.3;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=5 3;startArrow=none;endArrow=block;endFill=1;" edge="1" parent="v4-grupo"><mxGeometry relative="1" as="geometry"><mxPoint x="560.0" y="1586.0" as="sourcePoint" /><mxPoint x="620.0" y="1586.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v4-vC-lsl3" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#475569;strokeWidth=1.5;fontColor=#475569;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=7 5;startArrow=none;endArrow=open;endFill=0;" edge="1" parent="v4-grupo"><mxGeometry relative="1" as="geometry"><mxPoint x="840.0" y="1586.0" as="sourcePoint" /><mxPoint x="900.0" y="1586.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="all-sec5" value="" style="rounded=1;arcSize=1;absoluteArcSize=1;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="2270" y="2252" width="2060" height="1909" as="geometry" /></mxCell><mxCell id="all-sec5-t" value="&lt;b&gt;5 · Detalle D — Domain Events y coordinación&lt;/b&gt;" style="text;html=1;fontFamily=Inter;fontSize=40;fontColor=#1E3A8A;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2300" y="2267" width="2000" height="70" as="geometry" /></mxCell><mxCell id="v5-grupo" value="" style="group;" vertex="1" connectable="0" parent="1"><mxGeometry x="2300" y="2372" width="2000" height="1759" as="geometry" /></mxCell><mxCell id="v5-D-r0" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Se informa al Coordinador que puede iniciar la formalización; prepararContrato() parte de la versión aceptada. No se crea el Contrato automáticamente (CA-014, CA-015).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="160.0" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r1" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Reacción en transacción propia: crea EstadoCuenta si no existe y la obligación Anticipo (al menos 30 %, 3 días hábiles), sin duplicarla en un reintento (BN-009).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="223.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r2" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Anticipo: se invoca confirmarContratacion(), que es idempotente. Solicitud: se informa al Coordinador, que vuelve a consultar el pago antes de confirmar (CA-019, CA-041, CA-067, CA-080).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="287.0" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r3" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Dos reacciones independientes, cada una en su propia transacción: Evento → En organización; EstadoCuenta registra la obligación SaldoContratoOriginal (GL-009).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="350.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r4" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Reacción en transacción propia: Evento → Cerrado sin contratación, nunca Cancelado. Si falla, queda pendiente de reintento (CA-021, SE-011). Otra reacción, también en transacción propia: EstadoCuenta deja Sin efecto el anticipo Pendiente (el Liquidado se conserva) y registra la devolución A Pendiente de lo recibido como anticipo (C-04, GL-061, CA-102).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="414.0" width="790.0" height="55.5" as="geometry"/></mxCell><mxCell id="v5-D-r5" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Reacción en transacción propia: la solicitud o sustitución de origen guarda anexoId; requisito para confirmar o, en servicio adicional, para comunicar el pago (CA-051, CA-068, CA-082).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="477.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r6" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Reacción en transacción propia: Evento aplica los datos y las condiciones aprobados en la solicitud (aplicarCambioConfirmado), una sola vez (BN-006, CA-041).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="573.0" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r7" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Reacción en transacción propia: Evento incorpora el ServicioContratado con el proveedor y las condiciones aprobadas, sin duplicarlo (CA-079, CA-082).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="636.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r8" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Seguimiento de servicios pendientes y búsqueda de alternativa; Evento no cambia (CA-046, CA-047, US-012).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="700.0" width="790.0" height="85.5" as="geometry" /></mxCell><mxCell id="v5-D-r9" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Reacción en transacción propia: Evento actualiza el proveedor asignado del ServicioContratado (CA-051, CA-053).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="793.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r10" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ La aplicación cierra cada cambio, servicio adicional y sustitución pendiente a través de su propia raíz, una transacción por cierre (CA-070, CA-071, CA-096).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="857.0" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r11" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ GestionPagosService aplica SE-012 en EstadoCuenta: cobros exclusivos sin efecto y devolución pendiente si el Evento no está cancelado (CA-070).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="920.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r12" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ GestionPagosService aplica SE-012 en EstadoCuenta (CA-071).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="984.0" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r13" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ GestionPagosService aplica SE-012 solo al importe adicional de la sustitución (CA-096, CA-097).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="1047.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r14" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ GestionPagosService aplica SE-012 en EstadoCuenta (CA-067).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="1111.0" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r15" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ GestionPagosService aplica SE-012 en EstadoCuenta (CA-080).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="1174.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r16" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Se activa el protocolo de cobro (recordatorio y cargos moratorios con ventana de 24 h naturales). Las nuevas solicitudes de cambio y servicio adicional quedan Detenidas al evaluarse con EvaluarRegularizacionDeSolicitudes (BN-005, SE-006, CA-025, CA-066, CA-072).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="1270.0" width="790.0" height="66.5" as="geometry" /></mxCell><mxCell id="v5-D-r17" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Se avisa al Coordinador y al Cliente que el saldo quedó regularizado (sin aviso de cancelación) y se retoman las solicitudes detenidas por su propia raíz, comprobando de nuevo saldo, moratorios, Evento y condiciones (CA-027, CA-066, CA-072).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="1344.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r18" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Sin escritura: se informa al Coordinador. La cancelación no es automática: el Coordinador la registra después con registrarCancelacionPorFaltaDeRegularizacion(), indica el motivo e informa a los involucrados (BN-005, BN-008, CA-027).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="1408.0" width="790.0" height="70.5" as="geometry" /></mxCell><mxCell id="v5-D-r19" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Único punto que comunica la cancelación (solicitada por el Cliente o registrada por el Coordinador por falta de regularización) a Cliente, Administración y proveedores; después Administración registra la revisión y el no reembolso (CA-087, CA-089–CA-091). Otra reacción cierra cada solicitud en trámite con el motivo «Evento cancelado»; las confirmadas no se cierran (BN-008).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="1486.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r20" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Consulta y seguimiento: distingue eventos realizados de cancelados (BN-010).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="1550.0" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-r21" value="&lt;span style=&quot;font-size:11px&quot;&gt;→ Se informa al Coordinador para comunicar el resultado al Cliente (CA-098).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="760.0" y="1613.5" width="790.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-aud" value="&lt;b style=&quot;font-size:13px&quot;&gt;Eventos de auditoría (opcionales)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• VersionPropuestaGenerada — Historial de versiones (CA-009).&lt;br&gt;• PropuestaCerradaPorNoAceptacion — El Evento no reacciona: sigue En gestión (SE-011).&lt;br&gt;• CambioSolicitado — Registro de la solicitud y su fecha (CA-037).&lt;br&gt;• ViabilidadCambioEvaluada — Resultado de la consulta a proveedores (CA-060).&lt;br&gt;• ServicioAdicionalSolicitado — Registro y anticipación (SE-004).&lt;br&gt;• AlternativaProveedorEncontrada — Encontrar no es confirmar (CA-075, CA-047).&lt;br&gt;• AlternativaRechazadaPorCliente — La sustitución sigue pendiente (CA-054).&lt;br&gt;• AlternativaNoAutorizadaPorAdministracion — La sustitución sigue pendiente (CA-050).&lt;br&gt;• CargosMoratoriosComunicados — La ventana de 24 h queda guardada en el PlazoPago de la obligación CargosMoratorios.&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="1580.0" y="132.0" width="380.0" height="317.0" as="geometry" /></mxCell><mxCell id="v5-D-des" value="&lt;b style=&quot;font-size:13px&quot;&gt;Candidatos descartados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;• SolicitudDePagoComunicada: No es Domain Event: la comunicación crea la ObligacionPago con PlazoPago.inicio = fecha de comunicación. Ningún otro agregado necesita reaccionar en ese momento.&lt;br&gt;• AnticipoRegistrado: Redundante: es un pago registrado con ConceptoPago = Anticipo.&lt;br&gt;• ObligacionPagoLiquidada (genérico): Lo sustituyen PagoVerificado y SaldoVencidoRegularizado, que sí tienen consumidores.&lt;br&gt;• CambioRechazado (genérico): Ambiguo: no distingue Cliente, Administración ni viabilidad. Esos resultados son estados de la solicitud.&lt;br&gt;• ConfiguracionEventoActualizada: Duplica CambioConfirmado, ServicioAdicionalConfirmado y SustitucionProveedorConfirmada.&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v5-grupo"><mxGeometry x="1580.0" y="465.0" width="380.0" height="270.5" as="geometry" /></mxCell><mxCell id="v5-D-e0" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;PropuestaAceptada&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;margin-top:4px&quot;&gt;• Hecho: El Cliente aceptó la versión vigente.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="330.0" y="160.0" width="380.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-o0" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Propuesta&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="40.0" y="160.0" width="250.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-e1" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;ContratoFirmado&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;margin-top:4px&quot;&gt;• Hecho: Se registró la firma.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="330.0" y="223.5" width="380.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-o1" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Contrato&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="40.0" y="223.5" width="250.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-e2" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;PagoVerificado&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;margin-top:4px&quot;&gt;• Hecho: Administración verificó un pago.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="330.0" y="287.0" width="380.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-o2" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;EstadoCuenta&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="40.0" y="287.0" width="250.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-e3" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;ContratacionConfirmada&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;margin-top:4px&quot;&gt;• Hecho: Se cumplieron las condiciones de confirmación.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="330.0" y="350.5" width="380.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-o3" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Contrato&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="40.0" y="350.5" width="250.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-e4" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;ProcesoContratacionCerrado&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;margin-top:4px&quot;&gt;• Hecho: El proceso terminó sin confirmarse.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="330.0" y="414.0" width="380.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-o4" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Contrato&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="40.0" y="414.0" width="250.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-e5" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;AnexoContratoRegistrado&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;margin-top:4px&quot;&gt;• Hecho: Se registró un anexo.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="330.0" y="477.5" width="380.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-o5" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Contrato&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="40.0" y="477.5" width="250.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-e6" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;CambioConfirmado&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;margin-top:4px&quot;&gt;• Hecho: El cambio cumplió todos los requisitos.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="330.0" y="573.0" width="380.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-o6" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;SolicitudCambio&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="40.0" y="573.0" width="250.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-e7" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;ServicioAdicionalConfirmado&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;margin-top:4px&quot;&gt;• Hecho: El servicio adicional quedó confirmado.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="330.0" y="636.5" width="380.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-o7" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;SolicitudServicioAdicional&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="40.0" y="636.5" width="250.0" height="55.5" as="geometry" /></mxCell><mxCell id="v5-D-e8" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;ProveedorNoDisponible&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;margin-top:4px&quot;&gt;• Hecho: Se registró la indisponibilidad o cancelación del proveedor; la SustitucionProveedor se crea en estado En búsqueda de alternativa.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="330.0" y="700.0" width="380.0" height="85.5" as="geometry" /></mxCell><mxCell id="v5-D-o8" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;SustitucionProveedor&lt;/b&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="40.0" y="700.0" width="250.0" height="85.5" as="geometry" /></mxCell><mxCell id="v5-D-e9" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;SustitucionProveedorConfirmada&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:11px;margin-top:4px&quot;&gt;• Hecho: El reemplazo quedó confirmado.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v5-grupo"><mxGeometry x="330.0" y="793.5" width="380.0" h