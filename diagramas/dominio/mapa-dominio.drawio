ign=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1938.0" y="860.5" width="216.6" height="20.0" as="geometry" /></mxCell><mxCell id="vB-l76" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;startArrow=none;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sum3" target="sum4"><mxGeometry relative="1" as="geometry"><mxPoint x="1930.0" y="941.5" as="sourcePoint" /><mxPoint x="1930.0" y="999.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="vB-l76-lbl" value="anexo + pago previo si aplica" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=11;fontStyle=0;fontColor=#6D28D9;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1938.0" y="960.5" width="174.3" height="20.0" as="geometry" /></mxCell><mxCell id="vB-l77" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;startArrow=none;endArrow=block;endFill=1;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="sum0" target="sum3"><mxGeometry relative="1" as="geometry"><mxPoint x="1810.0" y="620.5" as="sourcePoint" /><mxPoint x="1810.0" y="920.5" as="targetPoint" /><Array as="points"><mxPoint x="1792.0" y="620.5" /><mxPoint x="1792.0" y="920.5" /></Array></mxGeometry></mxCell><mxCell id="vB-l82" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#B91C1C;strokeWidth=1.3;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=5 3;startArrow=none;endArrow=block;endFill=1;exitX=1.000;exitY=0.700;exitDx=0;exitDy=0;entryX=1.000;entryY=0.300;entryDx=0;entryDy=0;" edge="1" parent="1" source="sum1" target="sum0"><mxGeometry relative="1" as="geometry"><mxPoint x="2050.0" y="728.9" as="sourcePoint" /><mxPoint x="2050.0" y="612.1" as="targetPoint" /><Array as="points"><mxPoint x="2074.0" y="728.9" /><mxPoint x="2074.0" y="612.1" /></Array></mxGeometry></mxCell><mxCell id="vB-l84" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#B91C1C;strokeWidth=1.3;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=5 3;startArrow=none;endArrow=block;endFill=1;exitX=1.000;exitY=0.700;exitDx=0;exitDy=0;entryX=1.000;entryY=0.300;entryDx=0;entryDy=0;" edge="1" parent="1" source="sum2" target="sum0"><mxGeometry relative="1" as="geometry"><mxPoint x="2050.0" y="828.9" as="sourcePoint" /><mxPoint x="2050.0" y="612.1" as="targetPoint" /><Array as="points"><mxPoint x="2096.0" y="828.9" /><mxPoint x="2096.0" y="612.1" /></Array></mxGeometry></mxCell><mxCell id="vB-l87" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#B91C1C;strokeWidth=1.3;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=5 3;startArrow=none;endArrow=block;endFill=1;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" target="su-ini"><mxGeometry relative="1" as="geometry"><mxPoint x="2110.0" y="920.5" as="sourcePoint" /><mxPoint x="2180.0" y="920.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="vB-lsl1" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;startArrow=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="302.0" y="1691.0" as="sourcePoint" /><mxPoint x="362.0" y="1691.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="vB-lsl2" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#B91C1C;strokeWidth=1.3;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=5 3;startArrow=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560.0" y="1691.0" as="sourcePoint" /><mxPoint x="620.0" y="1691.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="vB-lsl3" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#475569;strokeWidth=1.5;fontColor=#475569;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=7 5;startArrow=none;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840.0" y="1691.0" as="sourcePoint" /><mxPoint x="900.0" y="1691.0" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="04 — Detalle C: Gestión financiera"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1621" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="C-ec" value="&lt;i style=&quot;font-size:12px;color:#475569&quot;&gt;«Aggregate»&lt;/i&gt; &lt;b style=&quot;font-size:17px&quot;&gt;EstadoCuenta&lt;/b&gt;" style="rounded=1;arcSize=28;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;dashed=1;dashPattern=9 5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="124.0" width="1060.0" height="466.0" as="geometry" /></mxCell><mxCell id="C-ec-sub" value="refs: contratoId · eventoId — un estado de cuenta por contrato (decisión de diseño)" style="text;html=1;whiteSpace=nowrap;fontFamily=Inter;fontSize=11.5;fontColor=#64748B;align=right;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="600.5" y="136.0" width="491.5" height="18" as="geometry" /></mxCell><mxCell id="C-sm1" value="&lt;i style=&quot;font-size:12.5px;color:#64748B&quot;&gt;EstadoObligacionPago · GL-049, GL-053, SE-012&lt;/i&gt;" style="rounded=1;arcSize=36;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.2;dashed=1;dashPattern=3 4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="626.0" width="760.0" height="300.0" as="geometry" /></mxCell><mxCell id="C-sm2" value="&lt;i style=&quot;font-size:12.5px;color:#64748B&quot;&gt;EstadoPago · GL-046, GL-052, CA-019&lt;/i&gt;" style="rounded=1;arcSize=36;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.2;dashed=1;dashPattern=3 4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="840.0" y="626.0" width="540.0" height="300.0" as="geometry" /></mxCell><mxCell id="C-sm3" value="&lt;i style=&quot;font-size:12.5px;color:#64748B&quot;&gt;EstadoDevolucion · SE-012, GL-057, GL-061, CA-097, CA-098, CA-102–CA-105&lt;/i&gt;" style="rounded=1;arcSize=36;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.2;dashed=1;dashPattern=3 4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="1420.0" y="626.0" width="540.0" height="300.0" as="geometry"/></mxCell><mxCell id="C-f1" value="&lt;i style=&quot;font-size:12.5px;color:#64748B&quot;&gt;Regularización del saldo vencido del contrato original · BN-005, GL-054, CA-025, CA-027&lt;/i&gt;" style="rounded=1;arcSize=36;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.2;dashed=1;dashPattern=3 4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="962.0" width="900.0" height="520.0" as="geometry" /></mxCell><mxCell id="C-f2" value="&lt;i style=&quot;font-size:12.5px;color:#64748B&quot;&gt;Operación no realizada — SE-012 · CA-070, CA-071, CA-096, CA-097, CA-098&lt;/i&gt;" style="rounded=1;arcSize=36;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.2;dashed=1;dashPattern=3 4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="980.0" y="962.0" width="980.0" height="520.0" as="geometry" /></mxCell><mxCell id="C-conc" value="&lt;b style=&quot;font-size:13px&quot;&gt;ConceptoPago — conceptos económicos diferenciados (BN-005, CA-026)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;• Anticipo (GL-011): al menos el 30 % del costo total de la propuesta aceptada; plazo de 3 días hábiles tras la firma.&lt;br&gt;• SaldoContratoOriginal (GL-012): Liquidación como máximo 3 días hábiles antes del evento.&lt;br&gt;• SustitucionProveedor (GL-056): Identifica la obligación por el importe adicional de una sustitución aprobada; ese importe se integra una sola vez al saldo general. No convierte la raíz SustitucionProveedor en una cantidad.&lt;br&gt;• Cambio (GL-019, BN-005): Costos adicionales de un cambio; concepto independiente.&lt;br&gt;• CargoCambioTardio (GL-025): Cargo propio de Eventos Nova; tarifa vigente al registrar la solicitud.&lt;br&gt;• CargosMoratorios (GL-051): Importe según el contrato; separado del saldo principal vencido.&lt;br&gt;• ServicioAdicional (GL-015, BN-004): Costo del proveedor; sin cargo propio de Eventos Nova.&lt;br&gt;• La devolución no es un ConceptoPago: es la entidad Devolucion, que referencia la obligación y su concepto.&lt;/span&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.2;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1140.0" y="124.0" width="820.0" height="182.0" as="geometry"/></mxCell><mxCell id="C-reg" value="&lt;b style=&quot;font-size:13px&quot;&gt;Reglas que protege el límite de EstadoCuenta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;• Pagar un concepto no liquida otro; cada pago se aplica a una sola obligación.&lt;br&gt;• Un pago del saldo con fecha posterior a su límite se verifica y cuenta para la regularización, pero no lo liquida; desde el límite el saldo está vencido de hecho, aunque su vencimiento no se haya registrado, y detiene las solicitudes nuevas (C-06, CA-113, GL-049, SE-006).&lt;br&gt;• El importe adicional de sustitución se integra una sola vez al saldo general; si se aprueba después del límite de 3 días hábiles, no hereda una fecha vencida: se paga y verifica antes de confirmar el reemplazo y no vence automáticamente (GL-056, CA-052).&lt;br&gt;• Regularizar exige saldo vencido y cargos moratorios verificados, pagados dentro de las 24 h naturales comunicadas; Administración registra el resultado una sola vez.&lt;br&gt;• Cerrar una solicitud no cancela obligaciones del contrato original ni de otros conceptos (SE-012).&lt;br&gt;• Solo hay dos devoluciones, SE-012 y devolución A: un pago genera como máximo una y nunca por más de lo recibido (C-11).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1140.0" y="322.0" width="820.0" height="170" as="geometry"/></mxCell><mxCell id="C-devn" value="&lt;span style=&quot;font-size:10.5px&quot;&gt;• Se crea Pendiente si hubo importes recibidos exclusivamente por la operación no realizada y el Evento no está cancelado (SE-012), o por el anticipo recibido de una contratación cerrada sin confirmarse (devolución A, GL-061).&lt;br&gt;• DevolucionRegistrada se emite al pasar a Efectuada, nunca antes.&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1460.0" y="812.0" width="460.0" height="82.0" as="geometry"/></mxCell><mxCell id="C-f1n" value="&lt;span style=&quot;font-size:11px&quot;&gt;• Mientras haya saldo vencido sin regularizar, las nuevas solicitudes quedan detenidas (GL-049).&lt;br&gt;• Un pago posterior a la ventana no evita la cancelación, aunque aún no se haya registrado formalmente (BN-005, CA-027).&lt;br&gt;• Al vencer la ventana, Administración revisa los pagos, registra el resultado e informa al Coordinador (GL-054, CA-027).&lt;br&gt;• Si no hubo regularización, el Coordinador registra formalmente la cancelación, indica el motivo e informa a los involucrados; no es automática (BN-005, BN-008).&lt;br&gt;• Saldo vencido y cargos moratorios son obligaciones distintas (GL-051).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420.0" y="1012.0" width="490.0" height="128.5" as="geometry" /></mxCell><mxCell id="C-f2n" value="&lt;span style=&quot;font-size:11px&quot;&gt;• En una sustitución se devuelve solo el importe adicional atribuible al reemplazo.&lt;br&gt;• No se devuelven ni modifican pagos del contrato original ni otros conceptos.&lt;br&gt;• Se registra solicitud, concepto, importe, motivo, fecha y comprobante; Administración informa al Coordinador.&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1650.0" y="1012.0" width="290.0" height="128.5" as="geometry" /></mxCell><mxCell id="C-root" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;EstadoCuenta&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• Saldo general = saldo pendiente del contrato original + importes adicionales de sustitución que deben integrarse al saldo general. Cálculo derivado, sin duplicar obligaciones. (GL-012, GL-056)&lt;br&gt;• situación de regularización del saldo vencido (BN-005, GL-054)&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250.0" y="174.0" width="640.0" height="105.0" as="geometry" /></mxCell><mxCell id="C-obl" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;ObligacionPago&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• origen: contrato, solicitudCambioId, solicitudServicioAdicionalId o sustitucionProveedorId&lt;br&gt;• importe debido, fecha límite y estado (GL-053)&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60.0" y="320.0" width="340.0" height="182.0" as="geometry" /></mxCell><mxCell id="C-pago" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Pago&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• importe, fecha del pago y concepto (GL-046)&lt;br&gt;• se aplica a una sola obligación (CA-026)&lt;br&gt;• pagado ≠ registrado ≠ verificado (GL-052)&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="430.0" y="320.0" width="300.0" height="136.5" as="geometry" /></mxCell><mxCell id="C-dev" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Entidad»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Devolucion&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• solicitudId y concepto devuelto, o pago de anticipo (devolución A)&lt;br&gt;• motivoDevolucion · fecha · comprobante (CA-098)&lt;br&gt;• SE-012: ≤ 5 días hábiles tras el cierre, una vez verificado&lt;br&gt;• Devolución A: ≤ 5 días hábiles desde la fecha de referencia (GL-061)&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="760.0" y="320.0" width="320.0" height="168.5" as="geometry" /></mxCell><mxCell id="o1" value="Pendiente" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="80.0" y="746.0" width="150.0" height="40.0" as="geometry" /></mxCell><mxCell id="o2" value="Vencida" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="330.0" y="676.0" width="150.0" height="40.0" as="geometry" /></mxCell><mxCell id="o3" value="Liquidada" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="600.0" y="746.0" width="150.0" height="40.0" as="geometry" /></mxCell><mxCell id="o4" value="Sin efecto" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="330.0" y="846.0" width="150.0" height="40.0" as="geometry" /></mxCell><mxCell id="g1" value="Registrado" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="880.0" y="746.0" width="150.0" height="40.0" as="geometry" /></mxCell><mxCell id="g2" value="Verificado" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="1180.0" y="686.0" width="170.0" height="40.0" as="geometry" /></mxCell><mxCell id="g3" value="Importe incorrecto" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="1180.0" y="816.0" width="170.0" height="40.0" as="geometry" /></mxCell><mxCell id="d1" value="Pendiente" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="1460.0" y="746.0" width="150.0" height="40.0" as="geometry" /></mxCell><mxCell id="d2" value="Efectuada" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="1760.0" y="746.0" width="160.0" height="40.0" as="geometry" /></mxCell><mxCell id="r1" value="SaldoContratoOriginal → Vencida (plazo: 3 días hábiles antes del evento)" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70.0" y="1012.0" width="260.0" height="46.0" as="geometry" /></mxCell><mxCell id="r2" value="Protocolo de cobro: recordatorio y comunicación de CargosMoratorios (importe según contrato)" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70.0" y="1102.0" width="260.0" height="58.0" as="geometry" /></mxCell><mxCell id="r3" value="Obligación CargosMoratorios: PlazoPago = 24 h naturales desde la comunicación" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70.0" y="1202.0" width="260.0" height="46.0" as="geometry" /></mxCell><mxCell id="r4" value="¿Saldo y moratorios verificados y pagados dentro de la ventana?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=11;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="90.0" y="1288.0" width="220.0" height="110.0" as="geometry" /></mxCell><mxCell id="r5" value="SaldoVencidoRegularizado → aviso de regularización; se retoman la organización y las solicitudes que cumplan sus condiciones" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#15803D;strokeWidth=1.6;fontFamily=Inter;fontColor=#0F172A;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="420.0" y="1302.0" width="220.0" height="80.0" as="geometry" /></mxCell><mxCell id="r6" value="PlazoRegularizacionVencido → se informa al Coordinador, que registra la cancelación (no automática)" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.6;fontFamily=Inter;fontColor=#0F172A;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="680.0" y="1302.0" width="230.0" height="80.0" as="geometry" /></mxCell><mxCell id="s1" value="Solicitud de cambio, servicio adicional o sustitución cerrada sin confirmarse ni realizarse" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1010.0" y="1012.0" width="300.0" height="58.0" as="geometry" /></mxCell><mxCell id="s2" value="Cobros pendientes exclusivos de esa solicitud → Sin efecto" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1010.0" y="1102.0" width="300.0" height="46.0" as="geometry" /></mxCell><mxCell id="s3" value="¿Se recibieron importes exclusivamente por esa operación?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=11;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1050.0" y="1176.0" width="220.0" height="96.0" as="geometry" /></mxCell><mxCell id="s4" value="¿El Evento está cancelado?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=11;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1050.0" y="1300.0" width="220.0" height="96.0" as="geometry" /></mxCell><mxCell id="s5" value="Sin devolución: nada que devolver" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1400.0" y="1192.0" width="200.0" height="60.0" as="geometry" /></mxCell><mxCell id="s6" value="Política de no reembolso; no hay devolución por SE-012" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.6;fontFamily=Inter;fontColor=#0F172A;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1400.0" y="1318.0" width="220.0" height="60.0" as="geometry" /></mxCell><mxCell id="s7" value="Devolucion Pendiente (≤ 5 días hábiles tras el cierre, una vez verificado)" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#15803D;strokeWidth=1.6;fontFamily=Inter;fontColor=#0F172A;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1020.0" y="1412.0" width="280.0" height="56.0" as="geometry" /></mxCell><mxCell id="s8" value="Devolucion Efectuada → DevolucionRegistrada" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#15803D;strokeWidth=1.6;fontFamily=Inter;fontColor=#0F172A;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1400.0" y="1412.0" width="260.0" height="56.0" as="geometry" /></mxCell><mxCell id="vC-ls1" value="Estado" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=11;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="40.0" y="1571.0" width="110.0" height="30.0" as="geometry" /></mxCell><mxCell id="vC-ls2" value="Estado final" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11;fontColor=#2E1065;" vertex="1" parent="1"><mxGeometry x="164.0" y="1571.0" width="120.0" height="30.0" as="geometry" /></mxCell><mxCell id="vC-ls4" value="decisión" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=11;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1050.0" y="1565.0" width="120.0" height="42.0" as="geometry" /></mxCell><mxCell id="C-obl-c0" value="ConceptoPago" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontStyle=0;arcSize=50;" vertex="1" parent="1"><mxGeometry x="70.0" y="439.0" width="108.4" height="23.5" as="geometry" /></mxCell><mxCell id="C-obl-c1" value="Importe" style="rounded=1;arcSize=22;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontStyle=0;arcSize=50;" vertex="1" parent="1"><mxGeometry x="184.4" y="439.0" width="67.2" height="23.5" as="geometry" /></mxCell><mxCell id="C-obl-c2" value="PlazoPago" style="rounded=1;arcSize=22;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontStyle=0;arcSize=50;" vertex="1" parent="1"><mxGeometry x="257.5" y="439.0" width="83.4" height="23.5" as="geometry" /></mxCell><mxCell id="C-obl-c3" value="EstadoObligacionPago" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontStyle=0;arcSize=50;" vertex="1" parent="1"><mxGeometry x="70.0" y="468.5" width="153.9" height="23.5" as="geometr