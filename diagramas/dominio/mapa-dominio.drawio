hazada por el Cliente" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="1360.0" y="799.5" width="230.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-scx-No autorizada" value="No autorizada" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="1360.0" y="899.5" width="230.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-scx-Cerrada por falta de pago" value="Cerrada por falta de pago" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="1360.0" y="1199.5" width="230.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sc-ini" value="Cerrada por inicio del evento" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="1360.0" y="1334.5" width="230.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sum0" value="En búsqueda de alternativa" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="1810.0" y="599.5" width="240.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sum1" value="Pendiente de aprobación del Cliente" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;f