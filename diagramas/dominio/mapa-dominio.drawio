Cell><mxCell id="v2-vA-l25-lbl" value="ContratacionConfirmada" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=11;fontStyle=0;fontColor=#6D28D9;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="v2-grupo"><mxGeometry x="1510.0" y="755.0" width="149.5" height="20.0" as="geometry" /></mxCell><mxCell id="v2-vA-l26" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;startArrow=none;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="v2-grupo" source="v2-v2" target="v2-v3"><mxGeometry relative="1" as="geometry"><mxPoint x="1502.0" y="840.0" as="sourcePoint" /><mxPoint x="1502.0" y="894.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v2-vA-l26-lbl" value="llega T: inicio automático (CA-109)" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=11;fontStyle=0;fontColor=#6D28D9;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="v2-grupo"><mxGeometry x="1500.0" y="857.0" width="208.6" height="20.0" as="geometry" /></mxCell><mxCell id="v2-vA-l27" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;startArrow=none;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="v2-grupo" source="v2-v3" target="v2-v4"><mxGeometry relative="1" as="geometry"><mxPoint x="1502.0" y="934.0" as="sourcePoint" /><mxPoint x="1502.0" y="984.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v2-vA-l27-lbl" value="se realizó y concluyó + fecha" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=11;fontStyle=0;fontColor=#6D28D9;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="v2-grupo"><mxGeometry x="1510.0" y="949.0" width="174.6" height="20.0" as="geometry" /></mxCell><mxCell id="v2-vA-l28" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=10.5;strokeColor=#B91C1C;strokeWidth=1.3;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=5 3;startArrow=none;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="v2-grupo" source="v2-v1" target="v2-v5"><mxGeometry relative="1" as="geometry"><mxPoint x="1602.0" y="710.0" as="sourcePoint" /><mxPoint x="1762.0" y="710.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v2-vA-l28-lbl" value="ProcesoContratacionCerrado&lt;br&gt;o llegada de T (CA-110)" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSize=10.5;fontStyle=0;fontColor=#B91C1C;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="v2-grupo"><mxGeometry x="1598.1" y="673.2" width="167.7" height="33.5" as="geometry"/></mxCell><mxCell id="v2-vA-l29" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#B91C1C;strokeWidth=1.3;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=5 3;startArrow=none;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="v2-grupo" source="v2-v2" target="v2-v6"><mxGeometry relative="1" as="geometry"><mxPoint x="1602.0" y="820.0" as="sourcePoint" /><mxPoint x="1762.0" y="820.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v2-vA-lsl1" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#6D28D9;strokeWidth=1.5;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;startArrow=none;endArrow=block;endFill=1;" edge="1" parent="v2-grupo"><mxGeometry relative="1" as="geometry"><mxPoint x="302.0" y="1429.0" as="sourcePoint" /><mxPoint x="362.0" y="1429.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v2-vA-lsl2" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#B91C1C;strokeWidth=1.3;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=5 3;startArrow=none;endArrow=block;endFill=1;" edge="1" parent="v2-grupo"><mxGeometry relative="1" as="geometry"><mxPoint x="560.0" y="1429.0" as="sourcePoint" /><mxPoint x="620.0" y="1429.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v2-vA-lsl3" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Inter;fontSize=11.5;strokeColor=#475569;strokeWidth=1.5;fontColor=#475569;labelBackgroundColor=#FFFFFF;endSize=9;startSize=12;dashed=1;dashPattern=7 5;startArrow=none;endArrow=open;endFill=0;" edge="1" parent="v2-grupo"><mxGeometry relative="1" as="geometry"><mxPoint x="840.0" y="1429.0" as="sourcePoint" /><mxPoint x="900.0" y="1429.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="all-sec3" value="" style="rounded=1;arcSize=1;absoluteArcSize=1;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="4490" y="260" width="2540" height="1876.0" as="geometry" /></mxCell><mxCell id="all-sec3-t" value="&lt;b&gt;3 · Detalle B — Solicitudes y proveedores&lt;/b&gt;" style="text;html=1;fontFamily=Inter;fontSize=40;fontColor=#1E3A8A;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="4520" y="275" width="2480" height="70" as="geometry" /></mxCell><mxCell id="v3-grupo" value="" style="group;" vertex="1" connectable="0" parent="1"><mxGeometry x="4520" y="380" width="2480" height="1726.0" as="geometry" /></mxCell><mxCell id="v3-B-f0" value="&lt;i style=&quot;font-size:12px;color:#475569&quot;&gt;«Aggregate»&lt;/i&gt; &lt;b style=&quot;font-size:17px&quot;&gt;SolicitudServicioAdicional&lt;/b&gt;" style="rounded=1;arcSize=28;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;dashed=1;dashPattern=9 5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="v3-grupo"><mxGeometry x="40.0" y="124.0" width="760.0" height="327.5" as="geometry" /></mxCell><mxCell id="v3-B-f1" value="&lt;i style=&quot;font-size:12px;color:#475569&quot;&gt;«Aggregate»&lt;/i&gt; &lt;b style=&quot;font-size:17px&quot;&gt;SolicitudCambio&lt;/b&gt;" style="rounded=1;arcSize=28;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;dashed=1;dashPattern=9 5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="v3-grupo"><mxGeometry x="860.0" y="124.0" width="760.0" height="327.5" as="geometry" /></mxCell><mxCell id="v3-B-f2" value="&lt;i style=&quot;font-size:12px;color:#475569&quot;&gt;«Aggregate»&lt;/i&gt; &lt;b style=&quot;font-size:17px&quot;&gt;SustitucionProveedor&lt;/b&gt;" style="rounded=1;arcSize=28;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;dashed=1;dashPattern=9 5;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="v3-grupo"><mxGeometry x="1680.0" y="124.0" width="760.0" height="327.5" as="geometry" /></mxCell><mxCell id="v3-B-fl0" value="&lt;i style=&quot;font-size:12.5px;color:#64748B&quot;&gt;Estados de SolicitudServicioAdicional · SE-004, CA-071–CA-083&lt;/i&gt;" style="rounded=1;arcSize=36;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.2;dashed=1;dashPattern=3 4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="v3-grupo"><mxGeometry x="40.0" y="487.5" width="760.0" height="959.0" as="geometry" /></mxCell><mxCell id="v3-B-fl1" value="&lt;i style=&quot;font-size:12.5px;color:#64748B&quot;&gt;Estados de SolicitudCambio · CA-037–CA-070&lt;/i&gt;" style="rounded=1;arcSize=36;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.2;dashed=1;dashPattern=3 4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="v3-grupo"><mxGeometry x="860.0" y="487.5" width="760.0" height="959.0" as="geometry" /></mxCell><mxCell id="v3-B-fl2" value="&lt;i style=&quot;font-size:12.5px;color:#64748B&quot;&gt;Estados de SustitucionProveedor · SE-001, CA-046–CA-054, CA-096&lt;/i&gt;" style="rounded=1;arcSize=36;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.2;dashed=1;dashPattern=3 4;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;container=0;" vertex="1" parent="v3-grupo"><mxGeometry x="1680.0" y="487.5" width="760.0" height="959.0" as="geometry" /></mxCell><mxCell id="v3-sc-note" value="&lt;span style=&quot;font-size:10.5px&quot;&gt;• El anexo es obligatorio en ambas rutas viables, aunque no se alteren costos ni condiciones (BN-003).&lt;br&gt;• Cargo tardío (&amp;lt; 7 días, tarifa vigente al registrar) solo si es viable, aceptado y se realiza; costos de proveedores por separado (CA-062, CA-063).&lt;br&gt;• Ningún cierre actualiza la configuración del Evento.&lt;br&gt;• «En evaluación» no es un estado alcanzable: la viabilidad se evalúa desde Registrada (AR-05).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v3-grupo"><mxGeometry x="1360.0" y="989.5" width="230.0" height="191.0" as="geometry" /></mxCell><mxCell id="v3-su-note1" value="&lt;span style=&quot;font-size:10.5px&quot;&gt;• Sin alternativa disponible: se informa al Cliente y sigue la búsqueda (CA-048).&lt;br&gt;• Rechazo del Cliente (CA-054) o de Administración (CA-050): se registra en AlternativaPropuesta y se vuelve a buscar.&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v3-grupo"><mxGeometry x="2180.0" y="529.5" width="230.0" height="125.0" as="geometry" /></mxCell><mxCell id="v3-su-note2" value="&lt;span style=&quot;font-size:10.5px&quot;&gt;• Costo aprobado después del límite de 3 días hábiles: se paga y verifica antes de confirmar; no vence automáticamente ni tiene otro plazo fijo (SE-001, CA-052).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v3-grupo"><mxGeometry x="2180.0" y="1007.5" width="230.0" height="95.0" as="geometry" /></mxCell><mxCell id="v3-B-cond0" value="&lt;b style=&quot;font-size:13px&quot;&gt;Condiciones clave&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;• Ventana de elegibilidad: ≥ 5 días naturales al registrar y durante la búsqueda de proveedor (SE-004, CA-077, CA-083).&lt;br&gt;• Si se encontró una alternativa dentro de la ventana, la elegibilidad no se pierde porque durante la aprobación del Cliente, la autorización de Administración o la ventana de pago resten &amp;lt; 5 días; se conserva mientras el Evento no inicie y se cumplan las demás condiciones (SE-004, CA-080, CA-082).&lt;br&gt;• Al registrar y al retomar: EvaluarRegularizacionDeSolicitudes combina saldo y moratorios verificados, estado del Evento y la condición temporal que informa la solicitud. La pausa por saldo vencido no invalida la elegibilidad ya obtenida; si aún no se había obtenido, se verifica de nuevo el mínimo de 5 días (CA-072).&lt;br&gt;• El anexo se registra después de ambas decisiones y antes de comunicar el pago (SE-004, CA-082). Cobros y devoluciones de una solicitud cerrada sin realizarse: SE-012.&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v3-grupo"><mxGeometry x="40.0" y="1476.5" width="760.0" height="160" as="geometry" /></mxCell><mxCell id="v3-B-cond1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Condiciones clave&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;• Cargo propio: ninguno con ≥ 7 días; con &amp;lt; 7 días solo si es viable, aceptado y realizado (CA-061, CA-062).&lt;br&gt;• El cargo por cambio tardío por sí solo no exige autorización de Administración (BN-003).&lt;br&gt;• Rechazos y cierres conservan la última configuración confirmada (CA-042, CA-044, CA-069, CA-070).&lt;br&gt;• La modificación propuesta (DatosEvento y CondicionesServicio) se aplica al Evento solo al confirmar (BN-006, CA-041).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v3-grupo"><mxGeometry x="860.0" y="1476.5" width="760.0" height="160" as="geometry" /></mxCell><mxCell id="v3-B-cond2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Condiciones clave&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;• El proveedor original sigue vigente hasta SustitucionProveedorConfirmada (GL-036, GL-038).&lt;br&gt;• EvaluarImpactoCambio determina si se requieren aprobaciones (CA-049, CA-053).&lt;br&gt;• Si no se realiza y el Evento no está cancelado, se devuelve solo el importe adicional (SE-012, CA-097).&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="v3-grupo"><mxGeometry x="1680.0" y="1476.5" width="760.0" height="160" as="geometry" /></mxCell><mxCell id="v3-B-SSA" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;SolicitudServicioAdicional&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• refs: eventoId · contratoId · anexoId · estadoCuentaId · proveedorId&lt;br&gt;• Importe = costo del proveedor; sin cargo propio de Eventos Nova (BN-004)&lt;br&gt;• decisionCliente (primero) y autorizacionAdministracion (después): siempre obligatorias (GL-044)&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v3-grupo"><mxGeometry x="70.0" y="172.0" width="700.0" height="195.5" as="geometry" /></mxCell><mxCell id="v3-B-SC" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;SolicitudCambio&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• refs: eventoId · contratoId · anexoId · estadoCuentaId&lt;br&gt;• TarifaCargoTardio: la vigente al registrar la solicitud (BN-003)&lt;br&gt;• Importe del proveedor separado del cargo por cambio tardío (CA-063)&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v3-grupo"><mxGeometry x="890.0" y="172.0" width="700.0" height="195.5" as="geometry" /></mxCell><mxCell id="v3-B-SUS" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Aggregate Root»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;SustitucionProveedor&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• refs: eventoId + servicioContratadoId · contratoId · anexoId · estadoCuentaId&lt;br&gt;• Importe: costo adicional → saldo general, una sola vez (GL-056)&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.6;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v3-grupo"><mxGeometry x="1710.0" y="172.0" width="700.0" height="120.5" as="geometry" /></mxCell><mxCell id="v3-B-ALT" value="&lt;i style=&quot;font-size:11px;color:#475569&quot;&gt;«Value Object»&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;AlternativaPropuesta (0..*, CA-054)&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:4px&quot;&gt;• proveedorId — papel de proveedor alternativo (GL-030)&lt;br&gt;• DisponibilidadProveedor · ImpactoModificacion&lt;br&gt;• decisionCliente y autorizacionAdministracion : Decision — solo si la alternativa tiene impacto&lt;/div&gt;" style="rounded=1;arcSize=22;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.2;fontFamily=Inter;fontColor=#0F172A;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=8;" vertex="1" parent="v3-grupo"><mxGeometry x="1800.0" y="308.5" width="520.0" height="119.0" as="geometry" /></mxCell><mxCell id="v3-sam0" value="Registrada" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="170.0" y="599.5" width="240.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sam1" value="En búsqueda de proveedor" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="170.0" y="699.5" width="240.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sam2" value="Pendiente de aprobación del Cliente" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="170.0" y="799.5" width="240.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sam3" value="Pendiente de autorización" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="170.0" y="899.5" width="240.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sam4" value="Autorizada" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="170.0" y="999.5" width="240.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sam5" value="Pendiente de pago" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="170.0" y="1099.5" width="240.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sam6" value="Confirmada" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=12;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="170.0" y="1199.5" width="240.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sa-det" value="Detenida por saldo vencido — se retoma si se regulariza a tiempo (CA-072)" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=1.4;fontFamily=Inter;fontColor=#0F172A;fontSize=11;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="540.0" y="529.5" width="230.0" height="54.0" as="geometry" /></mxCell><mxCell id="v3-sax-np" value="No procedente — &amp;lt; 5 días al registrar (CA-083) o sin alternativa a tiempo (CA-077)" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="540.0" y="592.5" width="230.0" height="56.0" as="geometry" /></mxCell><mxCell id="v3-sax-No se realizará" value="No se realizará" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="540.0" y="754.5" width="230.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sax-No aprobada" value="No aprobada" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="540.0" y="814.5" width="230.0" height="42.0" as="geometry" /></mxCell><mxCell id="v3-sax-No autorizada" value="No autorizada" style="rounded=1;arcSize=24;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2.2;fontFamily=Inter;fontColor=#0F172A;fontSize=11.5;fontColor=#2E1065;" vertex="1" parent="v3-grupo"><mxGeometry x="540.0" y="914.5" width="230.0" height="42.0" as="geometry" /></mxCell><mxCel