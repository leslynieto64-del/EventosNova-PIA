      <bpmndi:BPMNShape id="SP03_Gw7_di" bpmnElement="SP03_Gw7" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" bioc:stroke="#263238" color:border-color="#263238"><dc:Bounds x="1757" y="550" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1752" y="511" width="170" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
