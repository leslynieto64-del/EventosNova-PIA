<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_SP03" targetNamespace="https://eventosnova.example/bpmn" exporter="Eventos Nova (generador del equipo)" exporterVersion="1.0">
  <bpmn:signal id="Signal_EventoIniciado" name="Evento iniciado" />
  <bpmn:signal id="Signal_EventoCancelado" name="Evento cancelado" />
  <bpmn:signal id="Signal_SaldoRegularizado" name="Saldo vencido regularizado" />
  <bpmn:collaboration id="Collab_SP03">
    <bpmn:documentation>Cambio después de la contratación y antes del inicio: saldo vencido, 7 días naturales y cargo por cambio tardío, viabilidad con proveedores, aprobaciones, anexo, 24 horas naturales para que el Cliente pague, cierre por inicio o cancelación del Evento y aplicación de lo confirmado (BN-003, BN-006, BN-008, SE-002, SE-003, SE-005, SE-006, SE-008, SE-012; US-017 a US-020, US-023, US-024; CA-037 a CA-045, CA-059 a CA-070).</bpmn:documentation>
    <bpmn:participant id="Part_SP03_Cliente" name="Cliente" />
    <bpmn:participant id="Part_SP03_Proveedor" name="Proveedor" />
    <bpmn:participant id="Part_SP03_EN" name="Eventos Nova" processRef="Proc_SP03_Cambio" />
    <bpmn:messageFlow id="SP03_M01" name="Solicitud de cambio" sourceRef="Part_SP03_Cliente" targetRef="SP03_Inicio" />
    <bpmn:messageFlow id="SP03_M02" name="Aviso de saldo vencido" sourceRef="SP03_Detener" targetRef="Part_SP03_Cliente" />
    <bpmn:messageFlow id="SP03_M03" name="Consulta de viabilidad" sourceRef="SP03_Viabilidad" targetRef="Part_SP03_Proveedor" />
    <bpmn:messageFlow id="SP03_M04" name="Viabilidad, costo y condiciones" sourceRef="Part_SP03_Proveedor" targetRef="SP03_Viabilidad" />
    <bpmn:messageFlow id="SP03_M05" name="Cambio, costos y condiciones" sourceRef="SP03_Presentar" targetRef="Part_SP03_Cliente" />
    <bpmn:messageFlow id="SP03_M06" name="Aprobación o rechazo" sourceRef="Part_SP03_Cliente" targetRef="SP03_Presentar" />
    <bpmn:messageFlow id="SP03_M07" name="Solicitud de pago (24 h)" sourceRef="SP03_SolPago" targetRef="Part_SP03_Cliente" />
    <bpmn:messageFlow id="SP03_M08" name="Pago" sourceRef="Part_SP03_Cliente" targetRef="SP03_PagoRecibido" />
    <bpmn:messageFlow id="SP03_M09" name="Modificación confirmada" sourceRef="SP03_Comunicar" targetRef="Part_SP03_Proveedor" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_SP03_Cambio" name="Gestión de una solicitud de cambio" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SP03">
      <bpmn:lane id="Lane_SP03_Coord" name="Coordinador">
        <bpmn:flowNodeRef>SP03_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwOrg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_NoOrg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinNoOrg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwFecha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_NoFecha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinNoFecha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Tramitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_IniSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_USaldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwSaldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Detener</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Regularizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Gw7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_SinCargo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_ConCargo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_U7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Viabilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwViable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_NoViable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinNoViable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwImpacto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Presentar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Rechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinRechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_NoAutorizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinNoAut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_UAprob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Anexo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwImportes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_SolPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_EspPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Plazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FaltaPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinFaltaPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_PagoRecibido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_UPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinConfirmada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_CerrarCan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_CerrarIni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwResultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinSinCobros</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_NoAplicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Aplicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_Comunicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinAplicada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_UCierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_DevImp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_FinImportes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SP03_Admin" name="Administración">
        <bpmn:flowNodeRef>SP03_Autorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwAdmin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_RevisarPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_GwEnPlazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_UVer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03_VerificarPago</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SP03_Inicio" name="Solicitud de cambio del Cliente">
      <bpmn:documentation>CA-059 (US-023)</bpmn:documentation>
      <bpmn:outgoing>SP03_F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP03_Inicio_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="SP03_GwOrg" name="¿El Evento está En organización?">
      <bpmn:documentation>CA-039: después de contratar y antes del inicio.</bpmn:documentation>
      <bpmn:incoming>SP03_F01</bpmn:incoming>
      <bpmn:outgoing>SP03_F02</bpmn:outgoing>
      <bpmn:outgoing>SP03_F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP03_NoOrg" name="Informar al Cliente que el cambio no procede">
      <bpmn:documentation>CA-039</bpmn:documentation>
      <bpmn:incoming>SP03_F02</bpmn:incoming>
      <bpmn:outgoing>SP03_F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP03_FinNoOrg" name="No procede">
      <bpmn:incoming>SP03_F03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP03_GwFecha" name="¿El cambio reprograma la fecha del evento?">
      <bpmn:documentation>BRD, fuera del alcance: solo puede cambiarse la hora del mismo día (GL-019).</bpmn:documentation>
      <bpmn:incoming>SP03_F04</bpmn:incoming>
      <bpmn:outgoing>SP03_F05</bpmn:outgoing>
      <bpmn:outgoing>SP03_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP03_NoFecha" name="Informar al Cliente que reprogramar la fecha está fuera del alcance">
      <bpmn:incoming>SP03_F05</bpmn:incoming>
      <bpmn:outgoing>SP03_F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP03_FinNoFecha" name="No procede (fecha fuera del alcance)">
      <bpmn:incoming>SP03_F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SP03_Tramitar" name="Tramitar la solicitud de cambio (solicitud en trámite)">
      <bpmn:documentation>Mientras la solicitud está en trámite, las señales «Evento iniciado» y «Evento cancelado» la cierran.</bpmn:documentation>
      <bpmn:incoming>SP03_F07</bpmn:incoming>
      <bpmn:outgoing>SP03_F53</bpmn:outgoing>
      <bpmn:startEvent id="SP03_IniSub" name="Solicitud admitida">
        <bpmn:outgoing>SP03_F08</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP03_Registrar" name="Registrar la solicitud de cambio con su fecha y su anticipación al evento">
        <bpmn:documentation>BN-003; CA-037 (US-017)</bpmn:documentation>
        <bpmn:incoming>SP03_F08</bpmn:incoming>
        <bpmn:outgoing>SP03_F09</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_USaldo">
        <bpmn:incoming>SP03_F09</bpmn:incoming>
        <bpmn:incoming>SP03_F13</bpmn:incoming>
        <bpmn:outgoing>SP03_F10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP03_GwSaldo" name="¿Existe saldo vencido del contrato original?">
        <bpmn:documentation>BN-003, SE-006: se verifica antes de tramitar.</bpmn:documentation>
        <bpmn:incoming>SP03_F10</bpmn:incoming>
        <bpmn:outgoing>SP03_F11</bpmn:outgoing>
        <bpmn:outgoing>SP03_F14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Detener" name="Detener la gestión e informar al Cliente que debe regularizar el saldo y los cargos moratorios">
        <bpmn:documentation>CA-066 (Detenida por saldo vencido)</bpmn:documentation>
        <bpmn:incoming>SP03_F11</bpmn:incoming>
        <bpmn:outgoing>SP03_F12</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="SP03_Regularizado" name="Saldo vencido regularizado">
        <bpmn:documentation>CA-066: Administración verificó la liquidación dentro de las 24 horas naturales.</bpmn:documentation>
        <bpmn:incoming>SP03_F12</bpmn:incoming>
        <bpmn:outgoing>SP03_F13</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP03_Regularizado_def" signalRef="Signal_SaldoRegularizado" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP03_Gw7" name="¿Se solicitó con 7 días naturales o más de anticipación?">
        <bpmn:documentation>BN-003, SE-003, SE-005</bpmn:documentation>
        <bpmn:incoming>SP03_F14</bpmn:incoming>
        <bpmn:outgoing>SP03_F15</bpmn:outgoing>
        <bpmn:outgoing>SP03_F16</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_SinCargo" name="Registrar que no aplica el cargo de Eventos Nova">
        <bpmn:documentation>CA-061</bpmn:documentation>
        <bpmn:incoming>SP03_F15</bpmn:incoming>
        <bpmn:outgoing>SP03_F17</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP03_ConCargo" name="Registrar la tarifa vigente del cargo por cambio tardío (se cobra solo si el cambio se realiza)">
        <bpmn:documentation>CA-062, SE-005, GL-025</bpmn:documentation>
        <bpmn:incoming>SP03_F16</bpmn:incoming>
        <bpmn:outgoing>SP03_F18</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_U7">
        <bpmn:incoming>SP03_F17</bpmn:incoming>
        <bpmn:incoming>SP03_F18</bpmn:incoming>
        <bpmn:outgoing>SP03_F19</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Viabilidad" name="Consultar la viabilidad con los proveedores involucrados y evaluar el impacto en servicios, costos y condiciones">
        <bpmn:documentation>CA-060, CA-063, CA-064; SE-002, SE-003: el costo adicional del proveedor se registra aparte del cargo por cambio tardío.</bpmn:documentation>
        <bpmn:incoming>SP03_F19</bpmn:incoming>
        <bpmn:outgoing>SP03_F20</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_GwViable" name="¿El cambio es viable?">
        <bpmn:incoming>SP03_F20</bpmn:incoming>
        <bpmn:outgoing>SP03_F21</bpmn:outgoing>
        <bpmn:outgoing>SP03_F23</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_NoViable" name="Informar al Cliente, registrar la solicitud como no procedente y conservar la última configuración confirmada">
        <bpmn:documentation>CA-065, CA-069, SE-008: no se cobra el cargo por cambio tardío.</bpmn:documentation>
        <bpmn:incoming>SP03_F21</bpmn:incoming>
        <bpmn:outgoing>SP03_F22</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_FinNoViable" name="No procedente">
        <bpmn:incoming>SP03_F22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP03_GwImpacto" name="¿Afecta los costos o las condiciones acordadas?">
        <bpmn:documentation>CA-038</bpmn:documentation>
        <bpmn:incoming>SP03_F23</bpmn:incoming>
        <bpmn:outgoing>SP03_F24</bpmn:outgoing>
        <bpmn:outgoing>SP03_F25</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Presentar" name="Presentar el cambio con sus costos y condiciones al Cliente y registrar su decisión">
        <bpmn:documentation>CA-040, CA-043 (US-018, US-019)</bpmn:documentation>
        <bpmn:incoming>SP03_F25</bpmn:incoming>
        <bpmn:outgoing>SP03_F26</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_GwCliente" name="¿El Cliente aprueba el cambio?">
        <bpmn:incoming>SP03_F26</bpmn:incoming>
        <bpmn:outgoing>SP03_F27</bpmn:outgoing>
        <bpmn:outgoing>SP03_F29</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Rechazo" name="Registrar el rechazo del Cliente y conservar la última configuración confirmada">
        <bpmn:documentation>CA-042</bpmn:documentation>
        <bpmn:incoming>SP03_F27</bpmn:incoming>
        <bpmn:outgoing>SP03_F28</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_FinRechazo" name="Rechazada por el Cliente">
        <bpmn:incoming>SP03_F28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP03_Autorizar" name="Autorizar o rechazar el cambio">
        <bpmn:documentation>CA-044, CA-045 (US-020)</bpmn:documentation>
        <bpmn:incoming>SP03_F29</bpmn:incoming>
        <bpmn:outgoing>SP03_F30</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_GwAdmin" name="¿Administración autoriza?">
        <bpmn:incoming>SP03_F30</bpmn:incoming>
        <bpmn:outgoing>SP03_F31</bpmn:outgoing>
        <bpmn:outgoing>SP03_F33</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_NoAutorizado" name="Registrar el rechazo de Administración, informar al Cliente y conservar la última configuración confirmada">
        <bpmn:documentation>CA-044</bpmn:documentation>
        <bpmn:incoming>SP03_F31</bpmn:incoming>
        <bpmn:outgoing>SP03_F32</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_FinNoAut" name="No autorizada">
        <bpmn:incoming>SP03_F32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP03_UAprob">
        <bpmn:incoming>SP03_F24</bpmn:incoming>
        <bpmn:incoming>SP03_F33</bpmn:incoming>
        <bpmn:outgoing>SP03_F34</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Anexo" name="Documentar el cambio aprobado en un anexo vinculado al contrato original">
        <bpmn:documentation>BN-003; CA-068</bpmn:documentation>
        <bpmn:incoming>SP03_F34</bpmn:incoming>
        <bpmn:outgoing>SP03_F35</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_GwImportes" name="¿Genera nuevos importes por pagar?">
        <bpmn:incoming>SP03_F35</bpmn:incoming>
        <bpmn:outgoing>SP03_F36</bpmn:outgoing>
        <bpmn:outgoing>SP03_F37</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_SolPago" name="Comunicar la solicitud de pago: costo del proveedor y cargo por cambio tardío como conceptos separados">
        <bpmn:documentation>CA-067, SE-006: el Cliente tiene 24 horas naturales desde esta comunicación.</bpmn:documentation>
        <bpmn:incoming>SP03_F36</bpmn:incoming>
        <bpmn:outgoing>SP03_F38</bpmn:outgoing>
      </bpmn:task>
      <bpmn:eventBasedGateway id="SP03_EspPago">
        <bpmn:incoming>SP03_F38</bpmn:incoming>
        <bpmn:outgoing>SP03_F39</bpmn:outgoing>
        <bpmn:outgoing>SP03_F40</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SP03_Plazo" name="24 horas naturales: plazo del Cliente para pagar">
        <bpmn:documentation>BN-003, CA-067: plazo para que el Cliente efectúe el pago, no para registrarlo.</bpmn:documentation>
        <bpmn:incoming>SP03_F39</bpmn:incoming>
        <bpmn:outgoing>SP03_F41</bpmn:outgoing>
      <bpmn:timerEventDefinition id="SP03_Plazo_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP03_RevisarPago" name="Revisar los pagos y comprobar si el Cliente pagó dentro de las 24 horas">
        <bpmn:documentation>BN-003, CA-067: decide la fecha en que el Cliente pagó, no la del registro o la verificación.</bpmn:documentation>
        <bpmn:incoming>SP03_F41</bpmn:incoming>
        <bpmn:outgoing>SP03_F42</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_GwEnPlazo" name="¿El Cliente efectuó el pago dentro de las 24 horas?">
        <bpmn:incoming>SP03_F42</bpmn:incoming>
        <bpmn:outgoing>SP03_F43</bpmn:outgoing>
        <bpmn:outgoing>SP03_F45</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_FaltaPago" name="Cerrar la solicitud por falta de pago, registrar el motivo e informar al Cliente">
        <bpmn:documentation>BN-003, CA-067: se conserva la última configuración confirmada.</bpmn:documentation>
        <bpmn:incoming>SP03_F43</bpmn:incoming>
        <bpmn:outgoing>SP03_F44</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_FinFaltaPago" name="Cerrada por falta de pago">
        <bpmn:incoming>SP03_F44</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="SP03_PagoRecibido" name="Pago del Cliente recibido">
        <bpmn:incoming>SP03_F40</bpmn:incoming>
        <bpmn:outgoing>SP03_F46</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP03_PagoRecibido_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP03_UVer">
        <bpmn:incoming>SP03_F45</bpmn:incoming>
        <bpmn:incoming>SP03_F46</bpmn:incoming>
        <bpmn:outgoing>SP03_F47</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_VerificarPago" name="Registrar y verificar el pago, aunque sea después de las 24 horas">
        <bpmn:documentation>CA-041, CA-067: un pago efectuado a tiempo no se trata como falta de pago por la demora administrativa.</bpmn:documentation>
        <bpmn:incoming>SP03_F47</bpmn:incoming>
        <bpmn:outgoing>SP03_F48</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_UPago">
        <bpmn:incoming>SP03_F37</bpmn:incoming>
        <bpmn:incoming>SP03_F48</bpmn:incoming>
        <bpmn:outgoing>SP03_F49</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Confirmar" name="Verificar el anexo y, cuando aplique, el pago verificado, y confirmar el cambio">
        <bpmn:documentation>CA-041, CA-068 (Confirmada)</bpmn:documentation>
        <bpmn:incoming>SP03_F49</bpmn:incoming>
        <bpmn:outgoing>SP03_F50</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_FinConfirmada" name="Cambio confirmado">
        <bpmn:incoming>SP03_F50</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP03_F08" sourceRef="SP03_IniSub" targetRef="SP03_Registrar" />
      <bpmn:sequenceFlow id="SP03_F09" sourceRef="SP03_Registrar" targetRef="SP03_USaldo" />
      <bpmn:sequenceFlow id="SP03_F10" sourceRef="SP03_USaldo" targetRef="SP03_GwSaldo" />
      <bpmn:sequenceFlow id="SP03_F11" name="Sí" sourceRef="SP03_GwSaldo" targetRef="SP03_Detener" />
      <bpmn:sequenceFlow id="SP03_F12" sourceRef="SP03_Detener" targetRef="SP03_Regularizado" />
      <bpmn:sequenceFlow id="SP03_F13" sourceRef="SP03_Regularizado" targetRef="SP03_USaldo" />
      <bpmn:sequenceFlow id="SP03_F14" name="No" sourceRef="SP03_GwSaldo" targetRef="SP03_Gw7" />
      <bpmn:sequenceFlow id="SP03_F15" name="Sí" sourceRef="SP03_Gw7" targetRef="SP03_SinCargo" />
      <bpmn:sequenceFlow id="SP03_F16" name="No" sourceRef="SP03_Gw7" targetRef="SP03_ConCargo" />
      <bpmn:sequenceFlow id="SP03_F17" sourceRef="SP03_SinCargo" targetRef="SP03_U7" />
      <bpmn:sequenceFlow id="SP03_F18" sourceRef="SP03_ConCargo" targetRef="SP03_U7" />
      <bpmn:sequenceFlow id="SP03_F19" sourceRef="SP03_U7" targetRef="SP03_Viabilidad" />
      <bpmn:sequenceFlow id="SP03_F20" sourceRef="SP03_Viabilidad" targetRef="SP03_GwViable" />
      <bpmn:sequenceFlow id="SP03_F21" name="No" sourceRef="SP03_GwViable" targetRef="SP03_NoViable" />
      <bpmn:sequenceFlow id="SP03_F22" sourceRef="SP03_NoViable" targetRef="SP03_FinNoViable" />
      <bpmn:sequenceFlow id="SP03_F23" name="Sí" sourceRef="SP03_GwViable" targetRef="SP03_GwImpacto" />
      <bpmn:sequenceFlow id="SP03_F24" name="No" sourceRef="SP03_GwImpacto" targetRef="SP03_UAprob" />
      <bpmn:sequenceFlow id="SP03_F25" name="Sí" sourceRef="SP03_GwImpacto" targetRef="SP03_Presentar" />
      <bpmn:sequenceFlow id="SP03_F26" sourceRef="SP03_Presentar" targetRef="SP03_GwCliente" />
      <bpmn:sequenceFlow id="SP03_F27" name="No" sourceRef="SP03_GwCliente" targetRef="SP03_Rechazo" />
      <bpmn:sequenceFlow id="SP03_F28" sourceRef="SP03_Rechazo" targetRef="SP03_FinRechazo" />
      <bpmn:sequenceFlow id="SP03_F29" name="Sí" sourceRef="SP03_GwCliente" targetRef="SP03_Autorizar" />
      <bpmn:sequenceFlow id="SP03_F30" sourceRef="SP03_Autorizar" targetRef="SP03_GwAdmin" />
      <bpmn:sequenceFlow id="SP03_F31" name="No" sourceRef="SP03_GwAdmin" targetRef="SP03_NoAutorizado" />
      <bpmn:sequenceFlow id="SP03_F32" sourceRef="SP03_NoAutorizado" targetRef="SP03_FinNoAut" />
      <bpmn:sequenceFlow id="SP03_F33" name="Sí" sourceRef="SP03_GwAdmin" targetRef="SP03_UAprob" />
      <bpmn:sequenceFlow id="SP03_F34" sourceRef="SP03_UAprob" targetRef="SP03_Anexo" />
      <bpmn:sequenceFlow id="SP03_F35" sourceRef="SP03_Anexo" targetRef="SP03_GwImportes" />
      <bpmn:sequenceFlow id="SP03_F36" name="Sí" sourceRef="SP03_GwImportes" targetRef="SP03_SolPago" />
      <bpmn:sequenceFlow id="SP03_F37" name="No" sourceRef="SP03_GwImportes" targetRef="SP03_UPago" />
      <bpmn:sequenceFlow id="SP03_F38" sourceRef="SP03_SolPago" targetRef="SP03_EspPago" />
      <bpmn:sequenceFlow id="SP03_F39" sourceRef="SP03_EspPago" targetRef="SP03_Plazo" />
      <bpmn:sequenceFlow id="SP03_F40" sourceRef="SP03_EspPago" targetRef="SP03_PagoRecibido" />
      <bpmn:sequenceFlow id="SP03_F41" sourceRef="SP03_Plazo" targetRef="SP03_RevisarPago" />
      <bpmn:sequenceFlow id="SP03_F42" sourceRef="SP03_RevisarPago" targetRef="SP03_GwEnPlazo" />
      <bpmn:sequenceFlow id="SP03_F43" name="No" sourceRef="SP03_GwEnPlazo" targetRef="SP03_FaltaPago" />
      <bpmn:sequenceFlow id="SP03_F44" sourceRef="SP03_FaltaPago" targetRef="SP03_FinFaltaPago" />
      <bpmn:sequenceFlow id="SP03_F45" name="Sí" sourceRef="SP03_GwEnPlazo" targetRef="SP03_UVer" />
      <bpmn:sequenceFlow id="SP03_F46" sourceRef="SP03_PagoRecibido" targetRef="SP03_UVer" />
      <bpmn:sequenceFlow id="SP03_F47" sourceRef="SP03_UVer" targetRef="SP03_VerificarPago" />
      <bpmn:sequenceFlow id="SP03_F48" sourceRef="SP03_VerificarPago" targetRef="SP03_UPago" />
      <bpmn:sequenceFlow id="SP03_F49" sourceRef="SP03_UPago" targetRef="SP03_Confirmar" />
      <bpmn:sequenceFlow id="SP03_F50" sourceRef="SP03_Confirmar" targetRef="SP03_FinConfirmada" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="SP03_BCancelado" name="Evento cancelado" attachedToRef="SP03_Tramitar">
      <bpmn:documentation>Caso A (BN-008): la solicitud sigue en trámite cuando se cancela el Evento.</bpmn:documentation>
      <bpmn:outgoing>SP03_F51</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP03_BCancelado_def" signalRef="Signal_EventoCancelado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP03_CerrarCan" name="Cerrar la solicitud con el motivo «Evento cancelado» (Cerrada por evento cancelado)">
      <bpmn:documentation>BN-008, SE-007, CA-087: no se confirma ni se realiza.</bpmn:documentation>
      <bpmn:incoming>SP03_F51</bpmn:incoming>
      <bpmn:outgoing>SP03_F62</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="SP03_BIniciado" name="Evento iniciado" attachedToRef="SP03_Tramitar">
      <bpmn:documentation>CA-070: lo no confirmado antes del inicio se cierra.</bpmn:documentation>
      <bpmn:outgoing>SP03_F52</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP03_BIniciado_def" signalRef="Signal_EventoIniciado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP03_CerrarIni" name="Cerrar la solicitud como «Cerrada por inicio del evento»">
      <bpmn:documentation>CA-070</bpmn:documentation>
      <bpmn:incoming>SP03_F52</bpmn:incoming>
      <bpmn:outgoing>SP03_F63</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="SP03_GwResultado" name="¿Cómo terminó el trámite?">
      <bpmn:incoming>SP03_F53</bpmn:incoming>
      <bpmn:outgoing>SP03_F54</bpmn:outgoing>
      <bpmn:outgoing>SP03_F55</bpmn:outgoing>
      <bpmn:outgoing>SP03_F64</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP03_FinSinCobros" name="Cerrada en el trámite, sin cobros pendientes">
      <bpmn:documentation>No procedente, rechazada por el Cliente o no autorizada: se conserva la última configuración confirmada.</bpmn:documentation>
      <bpmn:incoming>SP03_F54</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP03_GwCancel" name="¿El Evento fue cancelado antes de aplicar el cambio?">
      <bpmn:documentation>Se evalúa al aplicar la operación confirmada (BN-006, BN-008).</bpmn:documentation>
      <bpmn:incoming>SP03_F55</bpmn:incoming>
      <bpmn:outgoing>SP03_F56</bpmn:outgoing>
      <bpmn:outgoing>SP03_F59</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP03_NoAplicar" name="No aplicar el cambio en el Evento cancelado; la solicitud conserva su confirmación y su historial">
      <bpmn:documentation>Caso B (BN-008): no se modifica la configuración del Evento cancelado ni se cierra la solicitud.</bpmn:documentation>
      <bpmn:incoming>SP03_F56</bpmn:incoming>
      <bpmn:outgoing>SP03_F57</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP03_Revision" name="Registrar para revisión que la operación no pudo aplicarse por la cancelación (registro técnico en «Revisión»)">
      <bpmn:documentation>Caso B (BN-008): sin devoluciones, nuevas obligaciones ni cambios en el saldo; rige la política de no reembolso (SE-012). «Revisión» es el estado técnico del registro del Outbox, no un estado de negocio ni un trámite humano adicional.</bpmn:documentation>
      <bpmn:incoming>SP03_F57</bpmn:incoming>
      <bpmn:outgoing>SP03_F58</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP03_FinRevision" name="Confirmada, no aplicada: en revisión">
      <bpmn:incoming>SP03_F58</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="SP03_Aplicar" name="Aplicar el cambio a la configuración vigente, aunque el Evento ya haya iniciado (O-02)">
      <bpmn:documentation>Caso C (BN-006, O-02): el Evento sigue activo; si ya inició, se aplica porque se confirmó antes del inicio.</bpmn:documentation>
      <bpmn:incoming>SP03_F59</bpmn:incoming>
      <bpmn:outgoing>SP03_F60</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP03_Comunicar" name="Comunicar la modificación a los proveedores y a las personas involucradas">
      <bpmn:documentation>BN-006</bpmn:documentation>
      <bpmn:incoming>SP03_F60</bpmn:incoming>
      <bpmn:outgoing>SP03_F61</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP03_FinAplicada" name="Confirmada y aplicada al Evento">
      <bpmn:incoming>SP03_F61</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP03_UCierre">
      <bpmn:incoming>SP03_F62</bpmn:incoming>
      <bpmn:incoming>SP03_F63</bpmn:incoming>
      <bpmn:incoming>SP03_F64</bpmn:incoming>
      <bpmn:outgoing>SP03_F65</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SP03_DevImp" name="Resolver los importes de la operación no realizada (SE-012)" calledElement="Proc_SP08_Devolucion">
      <bpmn:documentation>Cobros exclusivos sin efecto; devolución solo si el Evento no está cancelado (SE-012).</bpmn:documentation>
      <bpmn:incoming>SP03_F65</bpmn:incoming>
      <bpmn:outgoing>SP03_F66</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="SP03_FinImportes" name="Solicitud cerrada sin realizarse: importes resueltos">
      <bpmn:incoming>SP03_F66</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SP03_F01" sourceRef="SP03_Inicio" targetRef="SP03_GwOrg" />
    <bpmn:sequenceFlow id="SP03_F02" name="No" sourceRef="SP03_GwOrg" targetRef="SP03_NoOrg" />
    <bpmn:sequenceFlow id="SP03_F03" sourceRef="SP03_NoOrg" targetRef="SP03_FinNoOrg" />
    <bpmn:sequenceFlow id="SP03_F04" name="Sí" sourceRef="SP03_GwOrg" targetRef="SP03_GwFecha" />
    <bpmn:sequenceFlow id="SP03_F05" name="Sí" sourceRef="SP03_GwFecha" targetRef="SP03_NoFecha" />
    <bpmn:sequenceFlow id="SP03_F06" sourceRef="SP03_NoFecha" targetRef="SP03_FinNoFecha" />
    <bpmn:sequenceFlow id="SP03_F07" name="No" sourceRef="SP03_GwFecha" targetRef="SP03_Tramitar" />
    <bpmn:sequenceFlow id="SP03_F51" sourceRef="SP03_BCancelado" targetRef="SP03_CerrarCan" />
    <bpmn:sequenceFlow id="SP03_F52" sourceRef="SP03_BIniciado" targetRef="SP03_CerrarIni" />
    <bpmn:sequenceFlow id="SP03_F53" sourceRef="SP03_Tramitar" targetRef="SP03_GwResultado" />
    <bpmn:sequenceFlow id="SP03_F54" name="Cerrada sin cobros pendientes" sourceRef="SP03_GwResultado" targetRef="SP03_FinSinCobros" />
    <bpmn:sequenceFlow id="SP03_F55" name="Confirmada" sourceRef="SP03_GwResultado" targetRef="SP03_GwCancel" />
    <bpmn:sequenceFlow id="SP03_F56" name="Sí (caso B)" sourceRef="SP03_GwCancel" targetRef="SP03_NoAplicar" />
    <bpmn:sequenceFlow id="SP03_F57" sourceRef="SP03_NoAplicar" targetRef="SP03_Revision" />
    <bpmn:sequenceFlow id="SP03_F58" sourceRef="SP03_Revision" targetRef="SP03_FinRevision" />
    <bpmn:sequenceFlow id="SP03_F59" name="No: Evento activo (caso C)" sourceRef="SP03_GwCancel" targetRef="SP03_Aplicar" />
    <bpmn:sequenceFlow id="SP03_F60" sourceRef="SP03_Aplicar" targetRef="SP03_Comunicar" />
    <bpmn:sequenceFlow id="SP03_F61" sourceRef="SP03_Comunicar" targetRef="SP03_FinAplicada" />
    <bpmn:sequenceFlow id="SP03_F62" sourceRef="SP03_CerrarCan" targetRef="SP03_UCierre" />
    <bpmn:sequenceFlow id="SP03_F63" sourceRef="SP03_CerrarIni" targetRef="SP03_UCierre" />
    <bpmn:sequenceFlow id="SP03_F64" name="Cerrada por falta de pago" sourceRef="SP03_GwResultado" targetRef="SP03_UCierre" />
    <bpmn:sequenceFlow id="SP03_F65" sourceRef="SP03_UCierre" targetRef="SP03_DevImp" />
    <bpmn:sequenceFlow id="SP03_F66" sourceRef="SP03_DevImp" targetRef="SP03_FinImportes" />
  </bpmn:process>
