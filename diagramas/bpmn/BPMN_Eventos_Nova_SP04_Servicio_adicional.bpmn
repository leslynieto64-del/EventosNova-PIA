<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_SP04" targetNamespace="https://eventosnova.example/bpmn" exporter="Eventos Nova (generador del equipo)" exporterVersion="1.0">
  <bpmn:signal id="Signal_EventoIniciado" name="Evento iniciado" />
  <bpmn:signal id="Signal_EventoCancelado" name="Evento cancelado" />
  <bpmn:signal id="Signal_SaldoRegularizado" name="Saldo vencido regularizado" />
  <bpmn:collaboration id="Collab_SP04">
    <bpmn:documentation>Servicio adicional: solo con la contratación confirmada (C-14, CA-101), la solicitud se registra y se verifica en orden (Evento no cancelado ni iniciado, al menos 5 días naturales y saldo vencido; solo el primer motivo, O-01), disponibilidad y costo del proveedor sin cargo de Eventos Nova, búsqueda con espera del Cliente, aprobación del Cliente, autorización obligatoria de Administración, anexo, 24 horas naturales para que el Cliente pague y cierre «No autorizada» (BN-004, BN-006, BN-008, SE-004, SE-006, SE-012; US-012 a US-016, US-022, US-025; CA-071 a CA-083, CA-099 a CA-101).</bpmn:documentation>
    <bpmn:participant id="Part_SP04_Cliente" name="Cliente" />
    <bpmn:participant id="Part_SP04_Proveedor" name="Proveedor" />
    <bpmn:participant id="Part_SP04_EN" name="Eventos Nova" processRef="Proc_SP04_ServicioAdicional" />
    <bpmn:messageFlow id="SP04_M01" name="Solicitud de servicio adicional" sourceRef="Part_SP04_Cliente" targetRef="SP04_Inicio" />
    <bpmn:messageFlow id="SP04_M14" name="Aviso: servicio adicional no registrado" sourceRef="SP04_NoRegistrar" targetRef="Part_SP04_Cliente" />
    <bpmn:messageFlow id="SP04_M02" name="Aviso de saldo vencido" sourceRef="SP04_Detener" targetRef="Part_SP04_Cliente" />
    <bpmn:messageFlow id="SP04_M03" name="Consulta de disponibilidad" sourceRef="SP04_Actuales" targetRef="Part_SP04_Proveedor" />
    <bpmn:messageFlow id="SP04_M04" name="Disponibilidad, costo y condiciones" sourceRef="Part_SP04_Proveedor" targetRef="SP04_Actuales" />
    <bpmn:messageFlow id="SP04_M05" name="Consulta a proveedor alternativo" sourceRef="SP04_Buscar" targetRef="Part_SP04_Proveedor" />
    <bpmn:messageFlow id="SP04_M06" name="Disponibilidad, costo y condiciones" sourceRef="Part_SP04_Proveedor" targetRef="SP04_Buscar" />
    <bpmn:messageFlow id="SP04_M07" name="Aviso: se necesita más tiempo" sourceRef="SP04_MasTiempo" targetRef="Part_SP04_Cliente" />
    <bpmn:messageFlow id="SP04_M08" name="Acepta o no esperar" sourceRef="Part_SP04_Cliente" targetRef="SP04_MasTiempo" />
    <bpmn:messageFlow id="SP04_M09" name="Costo y condiciones" sourceRef="SP04_Presentar" targetRef="Part_SP04_Cliente" />
    <bpmn:messageFlow id="SP04_M10" name="Aprobación o rechazo" sourceRef="Part_SP04_Cliente" targetRef="SP04_Presentar" />
    <bpmn:messageFlow id="SP04_M11" name="Solicitud de pago (24 h)" sourceRef="SP04_SolPago" targetRef="Part_SP04_Cliente" />
    <bpmn:messageFlow id="SP04_M12" name="Pago" sourceRef="Part_SP04_Cliente" targetRef="SP04_PagoRecibido" />
    <bpmn:messageFlow id="SP04_M13" name="Servicio confirmado" sourceRef="SP04_Comunicar" targetRef="Part_SP04_Proveedor" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_SP04_ServicioAdicional" name="Gestión de una solicitud de servicio adicional" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SP04">
      <bpmn:lane id="Lane_SP04_Coord" name="Coordinador">
        <bpmn:flowNodeRef>SP04_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwContr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwEvento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_NoProcEv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinNoProcEv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Tramitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_IniSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_URet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Gw5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_NoProc5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinNoProc5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwSaldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Detener</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Regularizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Actuales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwActual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_UBusca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Buscar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwAlt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_MasTiempo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwEspera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_NoRealiza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinNoRealiza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Gw5b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_NoProcBusq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinNoProcBusq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_UAlt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Presentar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_NoAprob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinNoAprob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_NoAut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinNoAut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Anexo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_SolPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_EspPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Plazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FaltaPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinFaltaPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_PagoRecibido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinConfirmada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_CerrarCan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_CerrarIni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwResultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinSinCobros</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_NoAplicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Aplicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_Comunicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinAplicada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_UCierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_DevImp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_FinImportes</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>SP04_NoRegistrar</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>SP04_FinNoRegistrada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SP04_Admin" name="Administración">
        <bpmn:flowNodeRef>SP04_Autorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwAdmin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_RevisarPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_GwEnPlazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_UVer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04_VerificarPago</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SP04_Inicio" name="Solicitud de servicio adicional del Cliente">
      <bpmn:documentation>US-025</bpmn:documentation>
      <bpmn:outgoing>SP04_F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP04_Inicio_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="SP04_GwContr" name="¿La contratación está confirmada?">
      <bpmn:documentation>C-14, GL-015, BN-004, SE-004, CA-101: un servicio adicional solo puede registrarse con la contratación confirmada. Con el Evento En gestión o Cerrado sin contratación no se registra la solicitud ni se evalúan el estado del Evento, el plazo mínimo o el saldo vencido. Un Evento Cancelado o En ejecución tuvo la contratación confirmada: la solicitud se registra y se resuelve en la compuerta siguiente (CA-099, CA-100).</bpmn:documentation>
      <bpmn:incoming>SP04_F01</bpmn:incoming>
      <bpmn:outgoing>SP04_F67</bpmn:outgoing>
      <bpmn:outgoing>SP04_F68</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP04_NoRegistrar" name="No registrar la solicitud e informar al Cliente que un servicio adicional solo puede registrarse con la contratación confirmada">
      <bpmn:documentation>CA-101: el Coordinador no registra la solicitud e informa al Cliente; no se evalúan el plazo mínimo ni el saldo vencido.</bpmn:documentation>
      <bpmn:incoming>SP04_F68</bpmn:incoming>
      <bpmn:outgoing>SP04_F69</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP04_FinNoRegistrada" name="Solicitud no registrada (contratación no confirmada)">
      <bpmn:incoming>SP04_F69</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP04_GwEvento" name="¿El Evento está cancelado o ya inició?">
      <bpmn:documentation>SE-004, O-01: después de registrar la solicitud, primero se verifica el Evento; si está cancelado o ya inició, la solicitud queda No procedente y se registra solo este motivo (CA-099, CA-100).</bpmn:documentation>
      <bpmn:incoming>SP04_F06</bpmn:incoming>
      <bpmn:outgoing>SP04_F02</bpmn:outgoing>
      <bpmn:outgoing>SP04_F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP04_NoProcEv" name="Registrar la solicitud como no procedente (Evento cancelado o iniciado) e informar al Cliente">
      <bpmn:documentation>SE-004, O-01, CA-099, CA-100: primer motivo, Evento cancelado o Evento iniciado; el Coordinador informa al Cliente.</bpmn:documentation>
      <bpmn:incoming>SP04_F02</bpmn:incoming>
      <bpmn:outgoing>SP04_F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP04_FinNoProcEv" name="No procedente">
      <bpmn:incoming>SP04_F03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="SP04_Registrar" name="Registrar la solicitud de servicio adicional con su fecha">
      <bpmn:documentation>BN-004, SE-004, O-01 (US-025): con la contratación confirmada (C-14, CA-101), la solicitud se registra antes de verificar el Evento, el plazo y el saldo.</bpmn:documentation>
      <bpmn:incoming>SP04_F67</bpmn:incoming>
      <bpmn:outgoing>SP04_F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="SP04_Tramitar" name="Tramitar la solicitud de servicio adicional (solicitud en trámite)">
      <bpmn:documentation>Mientras la solicitud está en trámite, las señales «Evento iniciado» y «Evento cancelado» la cierran.</bpmn:documentation>
      <bpmn:incoming>SP04_F04</bpmn:incoming>
      <bpmn:outgoing>SP04_F53</bpmn:outgoing>
      <bpmn:startEvent id="SP04_IniSub" name="Solicitud admitida">
        <bpmn:outgoing>SP04_F05</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP04_URet">
        <bpmn:incoming>SP04_F05</bpmn:incoming>
        <bpmn:incoming>SP04_F13</bpmn:incoming>
        <bpmn:outgoing>SP04_F07</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP04_Gw5" name="¿Faltan al menos 5 días naturales para el evento?">
        <bpmn:documentation>BN-004, SE-004, O-01: el plazo se verifica después del Evento y antes que el saldo; se registra solo el primer motivo.</bpmn:documentation>
        <bpmn:incoming>SP04_F07</bpmn:incoming>
        <bpmn:outgoing>SP04_F08</bpmn:outgoing>
        <bpmn:outgoing>SP04_F10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_NoProc5" name="Registrar la solicitud como no procedente (menos de 5 días naturales) e informar al Cliente">
        <bpmn:documentation>CA-083, SE-004, O-01: primer motivo, menos de 5 días naturales; el Coordinador informa al Cliente.</bpmn:documentation>
        <bpmn:incoming>SP04_F08</bpmn:incoming>
        <bpmn:outgoing>SP04_F09</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinNoProc5" name="No procedente">
        <bpmn:incoming>SP04_F09</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP04_GwSaldo" name="¿Existe saldo vencido del contrato original?">
        <bpmn:documentation>SE-004, SE-006</bpmn:documentation>
        <bpmn:incoming>SP04_F10</bpmn:incoming>
        <bpmn:outgoing>SP04_F11</bpmn:outgoing>
        <bpmn:outgoing>SP04_F14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_Detener" name="Detener la gestión e informar al Cliente que debe regularizar el saldo y los cargos moratorios">
        <bpmn:documentation>CA-072 (Detenida por saldo vencido)</bpmn:documentation>
        <bpmn:incoming>SP04_F11</bpmn:incoming>
        <bpmn:outgoing>SP04_F12</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="SP04_Regularizado" name="Saldo vencido regularizado">
        <bpmn:documentation>CA-072: se retoma si se cumplen los demás requisitos, incluido el plazo de 5 días.</bpmn:documentation>
        <bpmn:incoming>SP04_F12</bpmn:incoming>
        <bpmn:outgoing>SP04_F13</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP04_Regularizado_def" signalRef="Signal_SaldoRegularizado" />
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP04_Actuales" name="Consultar la disponibilidad de los proveedores que ya participan en el evento">
        <bpmn:documentation>CA-073, SE-004</bpmn:documentation>
        <bpmn:incoming>SP04_F14</bpmn:incoming>
        <bpmn:outgoing>SP04_F15</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwActual" name="¿Algún proveedor actual puede proporcionarlo?">
        <bpmn:incoming>SP04_F15</bpmn:incoming>
        <bpmn:outgoing>SP04_F16</bpmn:outgoing>
        <bpmn:outgoing>SP04_F17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP04_UBusca">
        <bpmn:incoming>SP04_F17</bpmn:incoming>
        <bpmn:incoming>SP04_F26</bpmn:incoming>
        <bpmn:outgoing>SP04_F18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_Buscar" name="Buscar un proveedor alternativo y verificar su disponibilidad">
        <bpmn:documentation>CA-074, CA-075</bpmn:documentation>
        <bpmn:incoming>SP04_F18</bpmn:incoming>
        <bpmn:outgoing>SP04_F19</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwAlt" name="¿Se encontró una alternativa disponible?">
        <bpmn:incoming>SP04_F19</bpmn:incoming>
        <bpmn:outgoing>SP04_F20</bpmn:outgoing>
        <bpmn:outgoing>SP04_F21</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_MasTiempo" name="Informar al Cliente que se necesita más tiempo y registrar si acepta esperar">
        <bpmn:documentation>CA-076</bpmn:documentation>
        <bpmn:incoming>SP04_F21</bpmn:incoming>
        <bpmn:outgoing>SP04_F22</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwEspera" name="¿El Cliente acepta esperar?">
        <bpmn:incoming>SP04_F22</bpmn:incoming>
        <bpmn:outgoing>SP04_F23</bpmn:outgoing>
        <bpmn:outgoing>SP04_F25</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_NoRealiza" name="Registrar que el servicio adicional no se realizará e informar al Cliente">
        <bpmn:documentation>CA-078</bpmn:documentation>
        <bpmn:incoming>SP04_F23</bpmn:incoming>
        <bpmn:outgoing>SP04_F24</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinNoRealiza" name="No se realizará">
        <bpmn:incoming>SP04_F24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP04_Gw5b" name="¿Siguen faltando al menos 5 días naturales?">
        <bpmn:documentation>CA-077: esperar no amplía el plazo mínimo.</bpmn:documentation>
        <bpmn:incoming>SP04_F25</bpmn:incoming>
        <bpmn:outgoing>SP04_F26</bpmn:outgoing>
        <bpmn:outgoing>SP04_F27</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_NoProcBusq" name="Registrar como no procedente por quedar menos de 5 días sin alternativa e informar al Cliente">
        <bpmn:documentation>CA-077</bpmn:documentation>
        <bpmn:incoming>SP04_F27</bpmn:incoming>
        <bpmn:outgoing>SP04_F28</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinNoProcBusq" name="No procedente">
        <bpmn:incoming>SP04_F28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP04_UAlt">
        <bpmn:incoming>SP04_F16</bpmn:incoming>
        <bpmn:incoming>SP04_F20</bpmn:incoming>
        <bpmn:outgoing>SP04_F29</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_Presentar" name="Presentar al Cliente el costo del proveedor y las condiciones, sin cargo de Eventos Nova, y registrar su decisión">
        <bpmn:documentation>BN-004; CA-073, CA-079</bpmn:documentation>
        <bpmn:incoming>SP04_F29</bpmn:incoming>
        <bpmn:outgoing>SP04_F30</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwCliente" name="¿El Cliente aprueba el servicio adicional?">
        <bpmn:incoming>SP04_F30</bpmn:incoming>
        <bpmn:outgoing>SP04_F31</bpmn:outgoing>
        <bpmn:outgoing>SP04_F33</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_NoAprob" name="Registrar el servicio adicional como no aprobado e informar al Cliente">
        <bpmn:documentation>CA-079</bpmn:documentation>
        <bpmn:incoming>SP04_F31</bpmn:incoming>
        <bpmn:outgoing>SP04_F32</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinNoAprob" name="No aprobada">
        <bpmn:incoming>SP04_F32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP04_Autorizar" name="Revisar y autorizar o rechazar el servicio adicional">
        <bpmn:documentation>BN-004; CA-081 (US-022)</bpmn:documentation>
        <bpmn:incoming>SP04_F33</bpmn:incoming>
        <bpmn:outgoing>SP04_F34</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwAdmin" name="¿Administración autoriza?">
        <bpmn:incoming>SP04_F34</bpmn:incoming>
        <bpmn:outgoing>SP04_F35</bpmn:outgoing>
        <bpmn:outgoing>SP04_F37</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_NoAut" name="Registrar el servicio adicional como no autorizado e informar al Cliente">
        <bpmn:documentation>CA-081, SE-006: no se confirma ni se busca otra alternativa (la búsqueda continua es propia de la sustitución, CA-050).</bpmn:documentation>
        <bpmn:incoming>SP04_F35</bpmn:incoming>
        <bpmn:outgoing>SP04_F36</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinNoAut" name="No autorizada">
        <bpmn:incoming>SP04_F36</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP04_Anexo" name="Documentar el servicio, su costo y sus condiciones en un anexo vinculado al contrato original">
        <bpmn:documentation>CA-082</bpmn:documentation>
        <bpmn:incoming>SP04_F37</bpmn:incoming>
        <bpmn:outgoing>SP04_F38</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP04_SolPago" name="Comunicar la solicitud de pago del servicio adicional">
        <bpmn:documentation>CA-082: el plazo de 24 horas naturales comienza con esta comunicación; importe separado del saldo del contrato.</bpmn:documentation>
        <bpmn:incoming>SP04_F38</bpmn:incoming>
        <bpmn:outgoing>SP04_F39</bpmn:outgoing>
      </bpmn:task>
      <bpmn:eventBasedGateway id="SP04_EspPago">
        <bpmn:incoming>SP04_F39</bpmn:incoming>
        <bpmn:outgoing>SP04_F40</bpmn:outgoing>
        <bpmn:outgoing>SP04_F41</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SP04_Plazo" name="24 horas naturales: plazo del Cliente para pagar">
        <bpmn:documentation>BN-004, CA-080: plazo para que el Cliente efectúe el pago, no para registrarlo.</bpmn:documentation>
        <bpmn:incoming>SP04_F40</bpmn:incoming>
        <bpmn:outgoing>SP04_F42</bpmn:outgoing>
      <bpmn:timerEventDefinition id="SP04_Plazo_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP04_RevisarPago" name="Revisar los pagos y comprobar si el Cliente pagó dentro de las 24 horas">
        <bpmn:documentation>BN-004, CA-080: decide la fecha en que el Cliente pagó, no la del registro o la verificación.</bpmn:documentation>
        <bpmn:incoming>SP04_F42</bpmn:incoming>
        <bpmn:outgoing>SP04_F43</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwEnPlazo" name="¿El Cliente efectuó el pago dentro de las 24 horas?">
        <bpmn:incoming>SP04_F43</bpmn:incoming>
        <bpmn:outgoing>SP04_F44</bpmn:outgoing>
        <bpmn:outgoing>SP04_F46</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_FaltaPago" name="Cerrar la solicitud por falta de pago, registrar el motivo e informar al Cliente">
        <bpmn:documentation>BN-004, SE-006: el servicio no se confirma ni se realiza.</bpmn:documentation>
        <bpmn:incoming>SP04_F44</bpmn:incoming>
        <bpmn:outgoing>SP04_F45</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinFaltaPago" name="Cerrada por falta de pago">
        <bpmn:incoming>SP04_F45</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="SP04_PagoRecibido" name="Pago del Cliente recibido">
        <bpmn:incoming>SP04_F41</bpmn:incoming>
        <bpmn:outgoing>SP04_F47</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP04_PagoRecibido_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP04_UVer">
        <bpmn:incoming>SP04_F46</bpmn:incoming>
        <bpmn:incoming>SP04_F47</bpmn:incoming>
        <bpmn:outgoing>SP04_F48</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_VerificarPago" name="Registrar y verificar el pago, aunque sea después de las 24 horas">
        <bpmn:documentation>BN-004, CA-080: un pago efectuado a tiempo queda pendiente de verificación; no es falta de pago.</bpmn:documentation>
        <bpmn:incoming>SP04_F48</bpmn:incoming>
        <bpmn:outgoing>SP04_F49</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP04_Confirmar" name="Consultar el estado del pago y confirmar el servicio adicional">
        <bpmn:documentation>BN-004; CA-082</bpmn:documentation>
        <bpmn:incoming>SP04_F49</bpmn:incoming>
        <bpmn:outgoing>SP04_F50</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinConfirmada" name="Servicio adicional confirmado">
        <bpmn:incoming>SP04_F50</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP04_F05" sourceRef="SP04_IniSub" targetRef="SP04_URet" />
      <bpmn:sequenceFlow id="SP04_F07" sourceRef="SP04_URet" targetRef="SP04_Gw5" />
      <bpmn:sequenceFlow id="SP04_F08" name="No" sourceRef="SP04_Gw5" targetRef="SP04_NoProc5" />
      <bpmn:sequenceFlow id="SP04_F09" sourceRef="SP04_NoProc5" targetRef="SP04_FinNoProc5" />
      <bpmn:sequenceFlow id="SP04_F10" name="Sí" sourceRef="SP04_Gw5" targetRef="SP04_GwSaldo" />
      <bpmn:sequenceFlow id="SP04_F11" name="Sí" sourceRef="SP04_GwSaldo" targetRef="SP04_Detener" />
      <bpmn:sequenceFlow id="SP04_F12" sourceRef="SP04_Detener" targetRef="SP04_Regularizado" />
      <bpmn:sequenceFlow id="SP04_F13" sourceRef="SP04_Regularizado" targetRef="SP04_URet" />
      <bpmn:sequenceFlow id="SP04_F14" name="No" sourceRef="SP04_GwSaldo" targetRef="SP04_Actuales" />
      <bpmn:sequenceFlow id="SP04_F15" sourceRef="SP04_Actuales" targetRef="SP04_GwActual" />
      <bpmn:sequenceFlow id="SP04_F16" name="Sí" sourceRef="SP04_GwActual" targetRef="SP04_UAlt" />
      <bpmn:sequenceFlow id="SP04_F17" name="No" sourceRef="SP04_GwActual" targetRef="SP04_UBusca" />
      <bpmn:sequenceFlow id="SP04_F18" sourceRef="SP04_UBusca" targetRef="SP04_Buscar" />
      <bpmn:sequenceFlow id="SP04_F19" sourceRef="SP04_Buscar" targetRef="SP04_GwAlt" />
      <bpmn:sequenceFlow id="SP04_F20" name="Sí" sourceRef="SP04_GwAlt" targetRef="SP04_UAlt" />
      <bpmn:sequenceFlow id="SP04_F21" name="No" sourceRef="SP04_GwAlt" targetRef="SP04_MasTiempo" />
      <bpmn:sequenceFlow id="SP04_F22" sourceRef="SP04_MasTiempo" targetRef="SP04_GwEspera" />
      <bpmn:sequenceFlow id="SP04_F23" name="No" sourceRef="SP04_GwEspera" targetRef="SP04_NoRealiza" />
      <bpmn:sequenceFlow id="SP04_F24" sourceRef="SP04_NoRealiza" targetRef="SP04_FinNoRealiza" />
      <bpmn:sequenceFlow id="SP04_F25" name="Sí" sourceRef="SP04_GwEspera" targetRef="SP04_Gw5b" />
      <bpmn:sequenceFlow id="SP04_F26" name="Sí: continuar la búsqueda" sourceRef="SP04_Gw5b" targetRef="SP04_UBusca" />
      <bpmn:sequenceFlow id="SP04_F27" name="No" sourceRef="SP04_Gw5b" targetRef="SP04_NoProcBusq" />
      <bpmn:sequenceFlow id="SP04_F28" sourceRef="SP04_NoProcBusq" targetRef="SP04_FinNoProcBusq" />
      <bpmn:sequenceFlow id="SP04_F29" sourceRef="SP04_UAlt" targetRef="SP04_Presentar" />
      <bpmn:sequenceFlow id="SP04_F30" sourceRef="SP04_Presentar" targetRef="SP04_GwCliente" />
      <bpmn:sequenceFlow id="SP04_F31" name="No" sourceRef="SP04_GwCliente" targetRef="SP04_NoAprob" />
      <bpmn:sequenceFlow id="SP04_F32" sourceRef="SP04_NoAprob" targetRef="SP04_FinNoAprob" />
      <bpmn:sequenceFlow id="SP04_F33" name="Sí" sourceRef="SP04_GwCliente" targetRef="SP04_Autorizar" />
      <bpmn:sequenceFlow id="SP04_F34" sourceRef="SP04_Autorizar" targetRef="SP04_GwAdmin" />
      <bpmn:sequenceFlow id="SP04_F35" name="No" sourceRef="SP04_GwAdmin" targetRef="SP04_NoAut" />
      <bpmn:sequenceFlow id="SP04_F36" sourceRef="SP04_NoAut" targetRef="SP04_FinNoAut" />
      <bpmn:sequenceFlow id="SP04_F37" name="Sí" sourceRef="SP04_GwAdmin" targetRef="SP04_Anexo" />
      <bpmn:sequenceFlow id="SP04_F38" sourceRef="SP04_Anexo" targetRef="SP04_SolPago" />
      <bpmn:sequenceFlow id="SP04_F39" sourceRef="SP04_SolPago" targetRef="SP04_EspPago" />
      <bpmn:sequenceFlow id="SP04_F40" sourceRef="SP04_EspPago" targetRef="SP04_Plazo" />
      <bpmn:sequenceFlow id="SP04_F41" sourceRef="SP04_EspPago" targetRef="SP04_PagoRecibido" />
      <bpmn:sequenceFlow id="SP04_F42" sourceRef="SP04_Plazo" targetRef="SP04_RevisarPago" />
      <bpmn:sequenceFlow id="SP04_F43" sourceRef="SP04_RevisarPago" targetRef="SP04_GwEnPlazo" />
      <bpmn:sequenceFlow id="SP04_F44" name="No" sourceRef="SP04_GwEnPlazo" targetRef="SP04_FaltaPago" />
      <bpmn:sequenceFlow id="SP04_F45" sourceRef="SP04_FaltaPago" targetRef="SP04_FinFaltaPago" />
      <bpmn:sequenceFlow id="SP04_F46" name="Sí" sourceRef="SP04_GwEnPlazo" targetRef="SP04_UVer" />
      <bpmn:sequenceFlow id="SP04_F47" sourceRef="SP04_PagoRecibido" targetRef="SP04_UVer" />
      <bpmn:sequenceFlow id="SP04_F48" sourceRef="SP04_UVer" targetRef="SP04_VerificarPago" />
      <bpmn:sequenceFlow id="SP04_F49" sourceRef="SP04_VerificarPago" targetRef="SP04_Confirmar" />
      <bpmn:sequenceFlow id="SP04_F50" sourceRef="SP04_Confirmar" targetRef="SP04_FinConfirmada" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="SP04_BCancelado" name="Evento cancelado" attachedToRef="SP04_Tramitar">
      <bpmn:documentation>Caso A (BN-008): la solicitud sigue en trámite cuando se cancela el Evento.</bpmn:documentation>
      <bpmn:outgoing>SP04_F51</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP04_BCancelado_def" signalRef="Signal_EventoCancelado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP04_CerrarCan" name="Cerrar la solicitud con el motivo «Evento cancelado» (Cerrada por evento cancelado)">
      <bpmn:documentation>BN-008, SE-007, CA-087: no se confirma ni se realiza.</bpmn:documentation>
      <bpmn:incoming>SP04_F51</bpmn:incoming>
      <bpmn:outgoing>SP04_F62</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="SP04_BIniciado" name="Evento iniciado" attachedToRef="SP04_Tramitar">
      <bpmn:documentation>CA-071, CA-080: lo no confirmado antes del inicio se cierra.</bpmn:documentation>
      <bpmn:outgoing>SP04_F52</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP04_BIniciado_def" signalRef="Signal_EventoIniciado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP04_CerrarIni" name="Cerrar la solicitud como «Cerrada por inicio del evento»">
      <bpmn:documentation>CA-071, CA-080</bpmn:documentation>
      <bpmn:incoming>SP04_F52</bpmn:incoming>
      <bpmn:outgoing>SP04_F63</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="SP04_GwResultado" name="¿Cómo terminó el trámite?">
      <bpmn:incoming>SP04_F53</bpmn:incoming>
      <bpmn:outgoing>SP04_F54</bpmn:outgoing>
      <bpmn:outgoing>SP04_F55</bpmn:outgoing>
      <bpmn:outgoing>SP04_F64</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP04_FinSinCobros" name="Cerrada en el trámite, sin cobros pendientes">
      <bpmn:documentation>No procedente, rechazada por el Cliente o no autorizada: se conserva la última configuración confirmada.</bpmn:documentation>
      <bpmn:incoming>SP04_F54</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP04_GwCancel" name="¿El Evento fue cancelado antes de incorporar el servicio?">
      <bpmn:documentation>Se evalúa al aplicar la operación confirmada (BN-006, BN-008).</bpmn:documentation>
      <bpmn:incoming>SP04_F55</bpmn:incoming>
      <bpmn:outgoing>SP04_F56</bpmn:outgoing>
      <bpmn:outgoing>SP04_F59</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP04_NoAplicar" name="No incorporar el servicio en el Evento cancelado; la solicitud conserva su confirmación y su historial">
      <bpmn:documentation>Caso B (BN-008): no se modifica la configuración del Evento cancelado ni se cierra la solicitud.</bpmn:documentation>
      <bpmn:incoming>SP04_F56</bpmn:incoming>
      <bpmn:outgoing>SP04_F57</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP04_Revision" name="Registrar para revisión que la operación no pudo aplicarse por la cancelación (registro técnico en «Revisión»)">
      <bpmn:documentation>Caso B (BN-008): sin devoluciones, nuevas obligaciones ni cambios en el saldo; rige la política de no reembolso (SE-012). «Revisión» es el estado técnico del registro del Outbox, no un estado de negocio ni un trámite humano adicional.</bpmn:documentation>
      <bpmn:incoming>SP04_F57</bpmn:incoming>
      <bpmn:outgoing>SP04_F58</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP04_FinRevision" name="Confirmada, no aplicada: en revisión">
      <bpmn:incoming>SP04_F58</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="SP04_Aplicar" name="Incorporar el servicio a la configuración vigente, aunque el Evento ya haya iniciado (O-02)">
      <bpmn:documentation>Caso C (BN-006, O-02): el Evento sigue activo; si ya inició, se aplica porque se confirmó antes del inicio.</bpmn:documentation>
      <bpmn:incoming>SP04_F59</bpmn:incoming>
      <bpmn:outgoing>SP04_F60</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP04_Comunicar" name="Coordinar el servicio con el proveedor e informar a las personas involucradas">
      <bpmn:documentation>BN-006</bpmn:documentation>
      <bpmn:incoming>SP04_F60</bpmn:incoming>
      <bpmn:outgoing>SP04_F61</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP04_FinAplicada" name="Confirmada y aplicada al Evento">
      <bpmn:incoming>SP04_F61</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP04_UCierre">
      <bpmn:incoming>SP04_F62</bpmn:incoming>
      <bpmn:incoming>SP04_F63</bpmn:incoming>
      <bpmn:incoming>SP04_F64</bpmn:incoming>
      <bpmn:outgoing>SP04_F65</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SP04_DevImp" name="Resolver los importes de la operación no realizada (SE-012)" calledElement="Proc_SP08_Devolucion">
      <bpmn:documentation>Cobros exclusivos sin efecto; devolución solo si el Evento no está cancelado (SE-012).</bpmn:documentation>
      <bpmn:incoming>SP04_F65</bpmn:incoming>
      <bpmn:outgoing>SP04_F66</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="SP04_FinImportes" name="Solicitud cerrada sin realizarse: importes resueltos">
      <bpmn:incoming>SP04_F66</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SP04_F01" sourceRef="SP04_Inicio" targetRef="SP04_GwContr" />
    <bpmn:sequenceFlow id="SP04_F67" name="Sí" sourceRef="SP04_GwContr" targetRef="SP04_Registrar" />
    <bpmn:sequenceFlow id="SP04_F68" name="No" sourceRef="SP04_GwContr" targetRef="SP04_NoRegistrar" />
    <bpmn:sequenceFlow id="SP04_F69" sourceRef="SP04_NoRegistrar" targetRef="SP04_FinNoRegistrada" />
    <bpmn:sequenceFlow id="SP04_F06" sourceRef="SP04_Registrar" targetRef="SP04_GwEvento" />
    <bpmn:sequenceFlow id="SP04_F02" name="Sí" sourceRef="SP04_GwEvento" targetRef="SP04_NoProcEv" />
    <bpmn:sequenceFlow id="SP04_F03" sourceRef="SP04_NoProcEv" targetRef="SP04_FinNoProcEv" />
    <bpmn:sequenceFlow id="SP04_F04" name="No" sourceRef="SP04_GwEvento" targetRef="SP04_Tramitar" />
    <bpmn:sequenceFlow id="SP04_F51" sourceRef="SP04_BCancelado" targetRef="SP04_CerrarCan" />
    <bpmn:sequenceFlow id="SP04_F52" sourceRef="SP04_BIniciado" targetRef="SP04_CerrarIni" />
    <bpmn:sequenceFlow id="SP04_F53" sourceRef="SP04_Tramitar" targetRef="SP04_GwResultado" />
    <bpmn:sequenceFlow id="SP04_F54" name="Cerrada sin cobros pendientes" sourceRef="SP04_GwResultado" targetRef="SP04_FinSinCobros" />
    <bpmn:sequenceFlow id="SP04_F55" name="Confirmada" sourceRef="SP04_GwResultado" targetRef="SP04_GwCancel" />
    <bpmn:sequenceFlow id="SP04_F56" name="Sí (caso B)" sourceRef="SP04_GwCancel" targetRef="SP04_NoAplicar" />
    <bpmn:sequenceFlow id="SP04_F57" sourceRef="SP04_NoAplicar" targetRef="SP04_Revision" />
    <bpmn:sequenceFlow id="SP04_F58" sourceRef="SP04_Revision" targetRef="SP04_FinRevision" />
    <bpmn:sequenceFlow id="SP04_F59" name="No: Evento activo (caso C)" sourceRef="SP04_GwCancel" targetRef="SP04_Aplicar" />
    <bpmn:sequenceFlow id="SP04_F60" sourceRef="SP04_Aplicar" targetRef="SP04_Comunicar" />
    <bpmn:sequenceFlow id="SP04_F61" sourceRef="SP04_Comunicar" targetRef="SP04_FinAplicada" />
    <bpmn:sequenceFlow id="SP04_F62" sourceRef="SP04_CerrarCan" targetRef="SP04_UCierre" />
    <bpmn:sequenceFlow id="SP04_F63" sourceRef="SP04_CerrarIni" targetRef="SP04_UCierre" />
    <bpmn:sequenceFlow id="SP04_F64" name="Cerrada por falta de pago" sourceRef="SP04_GwResultado" targetRef="SP04_UCierre" />
    <bpmn:sequenceFlow id="SP04_F65" sourceRef="SP04_UCierre" targetRef="SP04_DevImp" />
    <bpmn:sequenceFlow id="SP04_F66" sourceRef="SP04_DevImp" targetRef="SP04_FinImportes" />
    <bpmn:textAnnotation id="SP04_NotaEleg"><bpmn:text>Con la solicitud presentada a tiempo y la alternativa encontrada dentro del plazo, la elegibilidad se conserva durante la aprobación del Cliente y la autorización de Administración, siempre que el Evento no haya iniciado (CA-080).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_SP04" name="Gestión de una solicitud de servicio adicional">
    <bpmndi:BPMNPlane id="Plane_SP04" bpmnElement="Collab_SP04">
      <bpmndi:BPMNShape id="Part_SP04_Cliente_di" bpmnElement="Part_SP04_Cliente" isHorizontal="true" bioc:fill="#D4E7FA" color:background-color="#D4E7FA" bioc:stroke="#1E5A9C" color:border-color="#1E5A9C"><dc:Bounds x="0" y="0" width="6692" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_SP04_Proveedor_di" bpmnElement="Part_SP04_Proveedor" isHorizontal="true" bioc:fill="#FCE2BC" color:background-color="#FCE2BC" bioc:stroke="#A85E00" color:border-color="#A85E00"><dc:Bounds x="0" y="1340" width="6692" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_SP04_EN_di" bpmnElement="Part_SP04_EN" isHorizontal="true" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" bioc:stroke="#263238" color:border-color="#263238"><dc:Bounds x="0" y="120" width="6692" height="1170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SP04_Coord_di" bpmnElement="Lane_SP04_Coord" isHorizontal="true" bioc:fill="#A9E0D8" color:background-color="#A9E0D8" bioc:stroke="#0F766E" color:border-color="#0F766E"><dc:Bounds x="36" y="120" width="6656" height="910" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SP04_Admin_di" bpmnElement="Lane_SP04_Admin" isHorizontal="true" bioc:fill="#D2C3F0" color:background-color="#D2C3F0" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="36" y="1030" width="6656" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP04_Inicio_di" bpmnElement="SP04_Inicio" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" bioc:stroke="#263238" color:border-color="#263238"><dc:Bounds x="120" y="557" width="36" height="36" /><bpmndi:BPMNLabel color:color="#263238"><dc:Bounds x="83" y="605" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP04_GwContr_di" bpmnElement="SP04_GwContr" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" bioc:stroke="#263238" color:border-color="#263238"><dc:Bounds x="190" y="550" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="222" y="478" width="96" height="41" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP04_NoRegistrar_di" bpmnElement="SP04_NoRegistrar" bioc:fill="#A6E1D8" color:background-color="#A6E1D8" bioc:stroke="#0F766E" color:border-color="#0F766E"><dc:Bounds x="160" y="380" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP04_FinNoRegistrada_di" bpmnElement="SP04_FinNoRegistrada" bioc:fill="#F8CFC7" color:background-color="#F8CFC7" bioc:stroke="#B3261E" color:border-color="#B3261E"><dc:Bounds x="360" y="407" width="36" height="36" /><bpmndi:BPMNLabel color:color="#B3261E"><dc:Bounds x="323" y="447" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
