<mxfile host="Eventos Nova" type="device" version="24.7.17"><diagram id="BPMN_Eventos_Nova_SP04_Servicio_adicional" name="SP-04"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="6758" pageHeight="1615" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value="SP-04 · Gestión de una solicitud de servicio adicional" style="text;html=1;fontFamily=Arial;fontSize=30;fontColor=#22242a;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28.0" y="14.0" width="917.2" height="39.0" as="geometry"></mxGeometry></mxCell><mxCell id="x2" value="Servicio adicional: solo con la contratación confirmada (C-14, CA-101), la solicitud se registra y se verifica en orden (Evento no cancelado ni iniciado, al menos 5 días naturales y saldo vencido; solo el primer motivo, O-01), disponibilidad y costo del proveedor sin cargo de Eventos Nova, búsqueda con espera del Cliente, aprobación del Cliente, autorización obligatoria de Administración, anexo, 24 horas naturales para que el Cliente pague y cierre «No autorizada» (BN-004, BN-006, BN-008, SE-004, SE-006, SE-012; US-012 a US-016, US-022, US-025; CA-071 a CA-083, CA-099 a CA-101)." style="text;html=1;fontFamily=Arial;fontSize=15;fontColor=#444444;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="54.0" width="4122.9" height="19.5" as="geometry"></mxGeometry></mxCell><mxCell id="x3" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#D4E7FA;strokeColor=#1E5A9C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="28.0" y="95.0" width="34.0" height="22.0" as="geometry"></mxGeometry></mxCell><mxCell id="x4" value="Cliente (pool externo)" style="text;html=1;fontFamily=Arial;fontSize=15;fontColor=#263238;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" pare