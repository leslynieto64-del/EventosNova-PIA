a y aplicada al Evento" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#CBEBD1;strokeColor=#2E7D32;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#2E7D32;" vertex="1" parent="Lane_SP03_Coord"><mxGeometry x="6528.0" y="437.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP03_FinImportes" value="Solicitud cerrada sin realizarse: importes resueltos" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="Lane_SP03_Coord"><mxGeometry x="7128.0" y="177.0" width="36.0" height="36.0" as="geometry"><mxPoint x="5.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP03_FinNoFecha" value="No procede (fecha fuera del alcance)" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="Lane_SP03_Coord"><mxGeometry x="728.0" y="567.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP03_FinNoOrg" value="No procede" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="Lane_SP03_Coord"><mxGeometry x="728.0