    <bpmn:startEvent id="MAE_Inicio" name="Solicitud del Cliente para organizar un evento">
      <bpmn:outgoing>MAE_F39</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MAE_Inicio_def" />
    </bpmn:startEvent>
    <bpmn:task id="MAE_Registrar" name="Registrar la información del Cliente y del evento">
      <bpmn:documentation>BN-001; US-001, US-002; CA-001 a CA-004</bpmn:documentation>
      <bpmn:incoming>MAE_F39</bpmn:incoming>
      <bpmn:outgoing>MAE_F40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="MAE_Propuesta" name="Gestionar la propuesta (SP-01)">
      <bpmn:documentation>BN-002, BN-009; SP-01 desplegado.</bpmn:documentation>
      <bpmn:incoming>MAE_F40</bpmn:incoming>
      <bpmn:outgoing>MAE_F41</bpmn:outgoing>
      <bpmn:startEvent id="SP01_Inicio" name="Información del evento registrada">
        <bpmn:outgoing>MAE_F01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP01_Elaborar" name="Elaborar la propuesta con los servicios, proveedores considerados, costos y condiciones">
        <bpmn:documentation>CA-005, CA-006 (US-003)</bpmn:documentation>
        <bpmn:incoming>MAE_F01</bpmn:incoming>
        <bpmn:outgoing>MAE_F02</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP01_Union">
        <bpmn:incoming>MAE_F02</bpmn:incoming>
        <bpmn:incoming>MAE_F10</bpmn:incoming>
        <bpmn:outgoing>MAE_F03</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP01_Version" name="Registrar la versión vigente con número consecutivo y fecha de actualización">
        <bpmn:documentation>BN-002; CA-009, CA-010 (US-005)</bpmn:documentation>
        <bpmn:incoming>MAE_F03</bpmn:incoming>
        <bpmn:outgoing>MAE_F04</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP01_Presentar" name="Presentar la propuesta vigente al Cliente">
        <bpmn:documentation>CA-011 (US-006)</bpmn:documentation>
        <bpmn:incoming>MAE_F04</bpmn:incoming>
        <bpmn:outgoing>MAE_F05</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="SP01_Decision" name="Decisión del Cliente recibida">
        <bpmn:documentation>CA-012</bpmn:documentation>
        <bpmn:incoming>MAE_F05</bpmn:incoming>
        <bpmn:outgoing>MAE_F06</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP01_Decision_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP01_GwDecision" name="¿Qué decide el Cliente?">
        <bpmn:incoming>MAE_F06</bpmn:incoming>
        <bpmn:outgoing>MAE_F07</bpmn:outgoing>
        <bpmn:outgoing>MAE_F08</bpmn:outgoing>
        <bpmn:outgoing>MAE_F09</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP01_Cerrar" name="Registrar la propuesta como no aceptada y cerrada">
        <bpmn:documentation>CA-092 (US-029)</bpmn:documentation>
        <bpmn:incoming>MAE_F08</bpmn:incoming>
        <bpmn:outgoing>MAE_F11</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP01_FinCerrada" name="Propuesta no aceptada y cerrada (el Evento sigue En gestión)">
        <bpmn:documentation>CA-093: el Cliente puede solicitar una nueva propuesta; el Evento no se cancela.</bpmn:documentation>
        <bpmn:incoming>MAE_F11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP01_Aceptar" name="Registrar la propuesta como aceptada">
        <bpmn:documentation>CA-013 (US-007)</bpmn:documentation>
        <bpmn:incoming>MAE_F07</bpmn:incoming>
        <bpmn:outgoing>MAE_F12</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP01_FinAceptada" name="Propuesta aceptada">
        <bpmn:documentation>CA-014: continúa la formalización del contrato.</bpmn:documentation>
        <bpmn:incoming>MAE_F12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP01_NuevaVersion" name="Crear una nueva versión de la propuesta con los cambios solicitados">
        <bpmn:documentation>CA-007, CA-008 (US-004)</bpmn:documentation>
        <bpmn:incoming>MAE_F09</bpmn:incoming>
        <bpmn:outgoing>MAE_F10</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="MAE_F01" sourceRef="SP01_Inicio" targetRef="SP01_Elaborar" />
      <bpmn:sequenceFlow id="MAE_F02" sourceRef="SP01_Elaborar" targetRef="SP01_Union" />
      <bpmn:sequenceFlow id="MAE_F03" sourceRef="SP01_Union" targetRef="SP01_Version" />
      <bpmn:sequenceFlow id="MAE_F04" sourceRef="SP01_Version" targetRef="SP01_Presentar" />
      <bpmn:sequenceFlow id="MAE_F05" sourceRef="SP01_Presentar" targetRef="SP01_Decision" />
      <bpmn:sequenceFlow id="MAE_F06" sourceRef="SP01_Decision" targetRef="SP01_GwDecision" />
      <bpmn:sequenceFlow id="MAE_F07" name="Acepta la versión vigente" sourceRef="SP01_GwDecision" targetRef="SP01_Aceptar" />
      <bpmn:sequenceFlow id="MAE_F08" name="No acepta ni solicita cambios" sourceRef="SP01_GwDecision" targetRef="SP01_Cerrar" />
      <bpmn:sequenceFlow id="MAE_F09" name="Solicita cambios" sourceRef="SP01_GwDecision" targetRef="SP01_NuevaVersion" />
      <bpmn:sequenceFlow id="MAE_F10" sourceRef="SP01_NuevaVersion" targetRef="SP01_Union" />
      <bpmn:sequenceFlow id="MAE_F11" sourceRef="SP01_Cerrar" targetRef="SP01_FinCerrada" />
      <bpmn:sequenceFlow id="MAE_F12" sourceRef="SP01_Aceptar" targetRef="SP01_FinAceptada" />
      <bpmn:subProcess id="SP01_EvT" name="Llegada de T con el Evento En gestión (inicio automático)" triggeredByEvent="true">
        <bpmn:documentation>C-01 y C-02: al llegar T con el Evento En gestión durante la etapa de propuesta (CA-110; BN-010).</bpmn:documentation>
        <bpmn:startEvent id="SP01_EvT_Inicio" name="Llega la fecha y hora de inicio del Evento (T) sin contratación confirmada" isInterrupting="true">
          <bpmn:documentation>BN-010.</bpmn:documentation>
          <bpmn:outgoing>SP01_EvT_F01</bpmn:outgoing>
          <bpmn:timerEventDefinition id="SP01_EvT_Inicio_def"></bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:task id="SP01_EvT_Cerrar" name="Cerrar el proceso de contratación sin confirmar: el Evento En gestión pasa a Cerrado sin contratación (no Cancelado)">
          <bpmn:documentation>C-01, CA-110: todavía no existe contrato firmado ni anticipo.</bpmn:documentation>
          <bpmn:incoming>SP01_EvT_F01</bpmn:incoming>
          <bpmn:outgoing>SP01_EvT_F02</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="SP01_EvT_Fin" name="Cerrado sin contratación (no Cancelado)">
          <bpmn:documentation>CA-110.</bpmn:documentation>
          <bpmn:incoming>SP01_EvT_F02</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SP01_EvT_F01" sourceRef="SP01_EvT_Inicio" targetRef="SP01_EvT_Cerrar" />
        <bpmn:sequenceFlow id="SP01_EvT_F02" sourceRef="SP01_EvT_Cerrar" targetRef="SP01_EvT_Fin" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="MAE_GwAceptada" name="¿La propuesta fue aceptada?">
      <bpmn:incoming>MAE_F41</bpmn:incoming>
      <bpmn:outgoing>MAE_F42</bpmn:outgoing>
      <bpmn:outgoing>MAE_F43</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="MAE_FinNoAceptada" name="Propuesta no aceptada y cerrada (el Evento sigue En gestión)">
      <bpmn:documentation>CA-093</bpmn:documentation>
      <bpmn:incoming>MAE_F42</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="MAE_Contratacion" name="Formalizar el contrato y confirmar la contratación (SP-02)">
      <bpmn:documentation>BN-009, SE-010; SP-02 desplegado.</bpmn:documentation>
      <bpmn:incoming>MAE_F43</bpmn:incoming>
      <bpmn:outgoing>MAE_F44</bpmn:outgoing>
      <bpmn:startEvent id="SP02_Inicio" name="Propuesta aceptada">
        <bpmn:outgoing>MAE_F13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP02_Preparar" name="Preparar el contrato con base en la propuesta aceptada, con la política de no reembolso incluida">
        <bpmn:documentation>CA-015, CA-016 (US-008)</bpmn:documentation>
        <bpmn:incoming>MAE_F13</bpmn:incoming>
        <bpmn:outgoing>MAE_F14</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP02_Politica" name="Comunicar expresamente la política de no reembolso al Cliente">
        <bpmn:documentation>CA-016, CA-019</bpmn:documentation>
        <bpmn:incoming>MAE_F14</bpmn:incoming>
        <bpmn:outgoing>MAE_F15</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="SP02_Firma" name="Contrato firmado por las partes">
        <bpmn:documentation>CA-017</bpmn:documentation>
        <bpmn:incoming>MAE_F15</bpmn:incoming>
        <bpmn:outgoing>MAE_F16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP02_Firma_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP02_RegFirma" name="Registrar la firma del contrato vinculada a la propuesta aceptada">
        <bpmn:documentation>CA-017 (US-008)</bpmn:documentation>
        <bpmn:incoming>MAE_F16</bpmn:incoming>
        <bpmn:outgoing>MAE_F17</bpmn:outgoing>
      </bpmn:task>
      <bpmn:eventBasedGateway id="SP02_Espera">
        <bpmn:incoming>MAE_F17</bpmn:incoming>
        <bpmn:outgoing>MAE_F18</bpmn:outgoing>
        <bpmn:outgoing>MAE_F19</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SP02_Plazo" name="3 días hábiles después de la firma sin anticipo">
        <bpmn:documentation>BN-009, SE-010: el anticipo vence 3 días hábiles (lunes a viernes, GL-060) después de la firma.</bpmn:documentation>
        <bpmn:incoming>MAE_F18</bpmn:incoming>
        <bpmn:outgoing>MAE_F20</bpmn:outgoing>
      <bpmn:timerEventDefinition id="SP02_Plazo_def"></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP02_Contactar" name="Contactar al Cliente y comunicarle que dispone de 24 horas naturales para efectuar el anticipo">
        <bpmn:documentation>BN-009; CA-020 (US-010): el plazo de 24 horas es para que el Cliente pague, no para el registro de Administración.</bpmn:documentation>
        <bpmn:incoming>MAE_F20</bpmn:incoming>
        <bpmn:outgoing>MAE_F21</bpmn:outgoing>
      </bpmn:task>
      <bpmn:eventBasedGateway id="SP02_Espera24">
        <bpmn:incoming>MAE_F21</bpmn:incoming>
        <bpmn:outgoing>MAE_F22</bpmn:outgoing>
        <bpmn:outgoing>MAE_F23</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SP02_Plazo24" name="24 horas naturales desde el contacto: plazo del Cliente para pagar">
        <bpmn:documentation>BN-009; CA-021</bpmn:documentation>
        <bpmn:incoming>MAE_F22</bpmn:incoming>
        <bpmn:outgoing>MAE_F24</bpmn:outgoing>
      <bpmn:timerEventDefinition id="SP02_Plazo24_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP02_Cerrar" name="Cerrar el proceso de contratación sin confirmar">
        <bpmn:documentation>CA-021, SE-010</bpmn:documentation>
        <bpmn:incoming>MAE_F26</bpmn:incoming>
        <bpmn:outgoing>MAE_F27</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP02_FinCerrado" name="Cerrado sin contratación (no Cancelado)">
        <bpmn:documentation>CA-021: el Evento queda Cerrado sin contratación y no se inicia la contratación definitiva de proveedores.</bpmn:documentation>
        <bpmn:incoming>MAE_F321</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="SP02_Anticipo" name="Anticipo recibido">
        <bpmn:documentation>CA-018</bpmn:documentation>
        <bpmn:incoming>MAE_F19</bpmn:incoming>
        <bpmn:outgoing>MAE_F29</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP02_Anticipo_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="SP02_Anticipo24" name="Anticipo recibido tras el contacto">
        <bpmn:documentation>CA-018, CA-021</bpmn:documentation>
        <bpmn:incoming>MAE_F23</bpmn:incoming>
        <bpmn:outgoing>MAE_F30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP02_Anticipo24_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP02_UAnt">
        <bpmn:incoming>MAE_F29</bpmn:incoming>
        <bpmn:incoming>MAE_F30</bpmn:incoming>
        <bpmn:outgoing>MAE_F31</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP02_Revisar" name="Revisar los pagos y comprobar si el Cliente efectuó el anticipo dentro de las 24 horas">
        <bpmn:documentation>BN-009; CA-021: decide la fecha en que el Cliente pagó; el registro y la verificación pueden ser posteriores.</bpmn:documentation>
        <bpmn:incoming>MAE_F24</bpmn:incoming>
        <bpmn:outgoing>MAE_F25</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP02_GwPlazo" name="¿El Cliente efectuó el anticipo dentro de las 24 horas?">
        <bpmn:incoming>MAE_F25</bpmn:incoming>
        <bpmn:outgoing>MAE_F26</bpmn:outgoing>
        <bpmn:outgoing>MAE_F28</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP02_Union">
        <bpmn:incoming>MAE_F28</bpmn:incoming>
        <bpmn:incoming>MAE_F31</bpmn:incoming>
        <bpmn:incoming>MAE_F38</bpmn:incoming>
        <bpmn:outgoing>MAE_F32</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP02_Verificar" name="Registrar y verificar el anticipo: al menos el 30 % del costo total de la propuesta aceptada">
        <bpmn:documentation>BN-009; CA-018, CA-019 (US-009): el registro y la verificación pueden ser posteriores al plazo del Cliente.</bpmn:documentation>
        <bpmn:incoming>MAE_F32</bpmn:incoming>
        <bpmn:outgoing>MAE_F33</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP02_Gw30" name="¿El anticipo cubre al menos el 30 %?">
        <bpmn:incoming>MAE_F33</bpmn:incoming>
        <bpmn:outgoing>MAE_F34</bpmn:outgoing>
        <bpmn:outgoing>MAE_F36</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP02_Confirmar" name="Confirmar la contratación: contrato firmado, política incluida y comunicada, anticipo verificado">
        <bpmn:documentation>BN-009; CA-019</bpmn:documentation>
        <bpmn:incoming>MAE_F34</bpmn:incoming>
        <bpmn:outgoing>MAE_F35</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP02_FinConfirmada" name="Contratación confirmada (Evento En organización)">
        <bpmn:incoming>MAE_F35</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP02_Corregir" name="Informar al Cliente que el anticipo acumulado es inferior al 30 % para que lo complete (E-3)">
        <bpmn:documentation>CA-019, SE-010</bpmn:documentation>
        <bpmn:incoming>MAE_F36</bpmn:incoming>
        <bpmn:outgoing>MAE_F37</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="SP02_Corregido" name="Anticipo corregido recibido">
        <bpmn:incoming>MAE_F37</bpmn:incoming>
        <bpmn:outgoing>MAE_F38</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP02_Corregido_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="MAE_F13" sourceRef="SP02_Inicio" targetRef="SP02_Preparar" />
      <bpmn:sequenceFlow id="MAE_F14" sourceRef="SP02_Preparar" targetRef="SP02_Politica" />
      <bpmn:sequenceFlow id="MAE_F15" sourceRef="SP02_Politica" targetRef="SP02_Firma" />
      <bpmn:sequenceFlow id="MAE_F16" sourceRef="SP02_Firma" targetRef="SP02_RegFirma" />
      <bpmn:sequenceFlow id="MAE_F17" sourceRef="SP02_RegFirma" targetRef="SP02_Espera" />
      <bpmn:sequenceFlow id="MAE_F18" sourceRef="SP02_Espera" targetRef="SP02_Plazo" />
      <bpmn:sequenceFlow id="MAE_F19" sourceRef="SP02_Espera" targetRef="SP02_Anticipo" />
      <bpmn:sequenceFlow id="MAE_F20" sourceRef="SP02_Plazo" targetRef="SP02_Contactar" />
      <bpmn:sequenceFlow id="MAE_F21" sourceRef="SP02_Contactar" targetRef="SP02_Espera24" />
      <bpmn:sequenceFlow id="MAE_F22" sourceRef="SP02_Espera24" targetRef="SP02_Plazo24" />
      <bpmn:sequenceFlow id="MAE_F23" sourceRef="SP02_Espera24" targetRef="SP02_Anticipo24" />
      <bpmn:sequenceFlow id="MAE_F24" sourceRef="SP02_Plazo24" targetRef="SP02_Revisar" />
      <bpmn:sequenceFlow id="MAE_F25" sourceRef="SP02_Revisar" targetRef="SP02_GwPlazo" />
      <bpmn:sequenceFlow id="MAE_F26" name="No" sourceRef="SP02_GwPlazo" targetRef="SP02_Cerrar" />
      <bpmn:sequenceFlow id="MAE_F27" sourceRef="SP02_Cerrar" targetRef="SP02_SinEfecto" />
      <bpmn:sequenceFlow id="MAE_F28" name="Sí: pendiente de registro y verificación" sourceRef="SP02_GwPlazo" targetRef="SP02_Union" />
      <bpmn:sequenceFlow id="MAE_F29" sourceRef="SP02_Anticipo" targetRef="SP02_UAnt" />
      <bpmn:sequenceFlow id="MAE_F30" sourceRef="SP02_Anticipo24" targetRef="SP02_UAnt" />
      <bpmn:sequenceFlow id="MAE_F31" sourceRef="SP02_UAnt" targetRef="SP02_Union" />
      <bpmn:sequenceFlow id="MAE_F32" sourceRef="SP02_Union" targetRef="SP02_Verificar" />
      <bpmn:sequenceFlow id="MAE_F33" sourceRef="SP02_Verificar" targetRef="SP02_Gw30" />
      <bpmn:sequenceFlow id="MAE_F34" name="Sí" sourceRef="SP02_Gw30" targetRef="SP02_Confirmar" />
      <bpmn:sequenceFlow id="MAE_F35" sourceRef="SP02_Confirmar" targetRef="SP02_FinConfirmada" />
      <bpmn:sequenceFlow id="MAE_F36" name="No" sourceRef="SP02_Gw30" targetRef="SP02_Corregir" />
      <bpmn:sequenceFlow id="MAE_F37" sourceRef="SP02_Corregir" targetRef="SP02_Corregido" />
      <bpmn:sequenceFlow id="MAE_F38" sourceRef="SP02_Corregido" targetRef="SP02_Union" />
      <bpmn:task id="SP02_SinEfecto" name="Dejar sin efecto el anticipo pendiente (el Liquidado conserva su estado); la contratación cerrada no se reabre">
        <bpmn:documentation>A-2 y C-04: la contratación cerrada no se reabre; el anticipo pendiente pasa a Sin efecto y el Liquidado conserva su estado (CA-021, CA-106; GL-053, GL-062).</bpmn:documentation>
        <bpmn:incoming>MAE_F27</bpmn:incoming>
        <bpmn:outgoing>MAE_F320</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP02_GwRecibido" name="¿Se recibió algún importe como anticipo?">
        <bpmn:incoming>MAE_F320</bpmn:incoming>
        <bpmn:outgoing>MAE_F321</bpmn:outgoing>
        <bpmn:outgoing>MAE_F322</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP02_DevA" name="Verificar y devolver el anticipo recibido (devolución A) en 5 días hábiles desde la fecha de referencia; registrarla">
        <bpmn:documentation>Devolución A (decisión A, A-1 a A-6): fecha de referencia = la más tardía entre el cierre y el registro del pago; vence al final del 5.º día hábil posterior; la verificación tardía no reinicia el plazo. Se registran el pago, concepto, importe, motivo, fecha y comprobante y se informa al Coordinador (CA-102 a CA-105; GL-061). Distinta de SE-012 (SP-08).</bpmn:documentation>
        <bpmn:incoming>MAE_F322</bpmn:incoming>
        <bpmn:outgoing>MAE_F323</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP02_FinDevA" name="Cerrado sin contratación: anticipo devuelto">
        <bpmn:documentation>CA-102 a CA-105.</bpmn:documentation>
        <bpmn:incoming>MAE_F323</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="SP02_EvT" name="Llegada de T con el Evento En gestión (inicio automático)" triggeredByEvent="true">
        <bpmn:documentation>C-01 y C-02: al llegar T con el Evento En gestión (CA-110, CA-111; BN-010).</bpmn:documentation>
        <bpmn:startEvent id="SP02_EvT_Inicio" name="Llega la fecha y hora de inicio del Evento (T) sin contratación confirmada" isInterrupting="true">
          <bpmn:documentation>BN-010.</bpmn:documentation>
          <bpmn:outgoing>SP02_EvT_F01</bpmn:outgoing>
          <bpmn:timerEventDefinition id="SP02_EvT_Inicio_def"></bpmn:timerEventDefinition>
        </bpmn:startEvent>
        <bpmn:task id="SP02_EvT_Cerrar" name="Cerrar la contratación sin confirmar: Evento Cerrado sin contratación; contrato En preparación o Firmado, Cerrado sin confirmar (D-3)">
          <bpmn:documentation>C-01, CA-110. El cierre aprobado define el estado del contrato no firmado (Cerrado sin confirmar). Implementación (ADR-008): el contrato Firmado sin confirmar también pasa a Cerrado sin confirmar al llegar T; es una decisión interna del equipo sin aprobación externa. El Evento, la no reapertura y el anticipo están definidos (C-01, C-02, C-04, A-1 a A-6).</bpmn:documentation>
          <bpmn:incoming>SP02_EvT_F01</bpmn:incoming>
          <bpmn:outgoing>SP02_EvT_F02</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="SP02_EvT_Devolver" name="Dejar sin efecto el anticipo pendiente y devolver lo recibido (devolución A), aunque se verifique después de T">
          <bpmn:documentation>C-02, C-04, A-1, A-3, A-6, CA-104, CA-110: nada se confirma después de T; un pago registrado antes de T y verificado después no confirma la contratación ni la reactiva y se devuelve (prueba T-57 del cierre aprobado). El anticipo Liquidado conserva su estado y también se devuelve. Fecha de referencia: el día del cierre si el pago ya estaba registrado; el del registro si es posterior.</bpmn:documentation>
          <bpmn:incoming>SP02_EvT_F02</bpmn:incoming>
          <bpmn:outgoing>SP02_EvT_F03</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="SP02_EvT_Fin" name="Cerrado sin contratación (no Cancelado)">
          <bpmn:documentation>CA-110.</bpmn:documentation>
          <bpmn:incoming>SP02_EvT_F03</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SP02_EvT_F01" sourceRef="SP02_EvT_Inicio" targetRef="SP02_EvT_Cerrar" />
        <bpmn:sequenceFlow id="SP02_EvT_F02" sourceRef="SP02_EvT_Cerrar" targetRef="SP02_EvT_Devolver" />
        <bpmn:sequenceFlow id="SP02_EvT_F03" sourceRef="SP02_EvT_Devolver" targetRef="SP02_EvT_Fin" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="MAE_F320" sourceRef="SP02_SinEfecto" targetRef="SP02_GwRecibido" />
      <bpmn:sequenceFlow id="MAE_F321" name="No" sourceRef="SP02_GwRecibido" targetRef="SP02_FinCerrado" />
      <bpmn:sequenceFlow id="MAE_F322" name="Sí" sourceRef="SP02_GwRecibido" targetRef="SP02_DevA" />
      <bpmn:sequenceFlow id="MAE_F323" sourceRef="SP02_DevA" targetRef="SP02_FinDevA" />
      <bpmn:textAnnotation id="SP02_NotaDevA"><bpmn:text>Devolución A (distinta de SE-012): la fecha de referencia es el día del cierre si el pago ya estaba registrado, o el día del registro si es posterior; ese día no cuenta y el plazo vence al final del 5.º día hábil posterior (límite exclusivo a las 00:00). La verificación tardía no reinicia el plazo. Un pago posterior al cierre se registra y verifica sin reabrir ni aplicarse a la contratación; si el Cliente desea continuar, inicia un proceso nuevo (BN-009, CA-102 a CA-106).</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="SP02_NotaEvT"><bpmn:text>Implementado (ADR-008): el trabajador aplica la llegada de T, cierra también el contrato Firmado y avisa a Cliente, Coordinador y Administración (decisiones internas, sin aprobación externa). Desde T no se confirma (CA-110).</bpmn:text></bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="MAE_GwConfirmada" name="¿La contratación quedó confirmada?">
      <bpmn:incoming>MAE_F44</bpmn:incoming>
      <bpmn:outgoing>MAE_F45</bpmn:outgoing>
      <bpmn:outgoing>MAE_F68</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="MAE_FinSinContr" name="Cerrado sin contratación">
      <bpmn:documentation>CA-021</bpmn:documentation>
      <bpmn:incoming>MAE_F45</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="SP02_PagoPost" name="Pago de anticipo después del cierre">
      <bpmn:documentation>A-3, BN-009, CA-106: un pago de anticipo puede registrarse y verificarse después del cierre sin reactivar la contratación. Inicia una instancia propia; la contratación cerrada no se reabre (A-2).</bpmn:documentation>
      <bpmn:outgoing>MAE_F327</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP02_PagoPost_def" />
    </bpmn:startEvent>
    <bpmn:task id="SP02_RegPost" name="Registrar y verificar el pago sin aplicarlo a la contratación cerrada ni reabrirla">
      <bpmn:documentation>A-2, A-3, A-4, CA-103, CA-106: el pago no se aplica a la contratación cerrada ni la reactiva; si el Cliente desea continuar, inicia un proceso nuevo.</bpmn:documentation>
      <bpmn:incoming>MAE_F327</bpmn:incoming>
      <bpmn:outgoing>MAE_F328</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP02_DevPost" name="Devolver el importe recibido (devolución A) en 5 días hábiles desde el día del registro; registrar la devolución">
      <bpmn:documentation>A-1, A-6, C-11, CA-103 a CA-105: la fecha de referencia es el día del registro (no cuenta); vence al final del 5.º día hábil posterior, límite exclusivo a las 00:00 del día siguiente (C-15). La verificación forma parte del plazo y verificar tarde no lo reinicia. Un pago genera como máximo una devolución, sin superar lo recibido. Distinta de SE-012.</bpmn:documentation>
      <bpmn:incoming>MAE_F328</bpmn:incoming>
      <bpmn:outgoing>MAE_F329</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP02_FinDevPost" name="Pago posterior al cierre devuelto">
      <bpmn:incoming>MAE_F329</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="MAE_Organizacion" name="Organizar el evento (Evento En organización)">
      <bpmn:documentation>GL-033: contratación confirmada y evento no iniciado.</bpmn:documentation>
      <bpmn:incoming>MAE_F68</bpmn:incoming>
      <bpmn:outgoing>MAE_F84</bpmn:outgoing>
      <bpmn:startEvent id="MAE_OrgInicio" name="Contratación confirmada">
        <bpmn:outgoing>MAE_F69</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="MAE_OrgAnd">
        <bpmn:incoming>MAE_F69</bpmn:incoming>
        <bpmn:outgoing>MAE_F70</bpmn:outgoing>
        <bpmn:outgoing>MAE_F71</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:task id="MAE_Asignar" name="Consultar la disponibilidad y asignar proveedores a los servicios contratados">
        <bpmn:documentation>BN-004; US-013, US-014, US-016; CA-029 a CA-035</bpmn:documentation>
        <bpmn:incoming>MAE_F70</bpmn:incoming>
        <bpmn:outgoing>MAE_F72</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="MAE_Pendientes" name="Dar seguimiento a los servicios pendientes de confirmación">
        <bpmn:documentation>US-012; CA-028</bpmn:documentation>
        <bpmn:incoming>MAE_F72</bpmn:incoming>
        <bpmn:outgoing>MAE_F73</bpmn:outgoing>
      </bpmn:task>
      <bpmn:subProcess id="MAE_Saldo" name="Dar seguimiento al saldo pendiente del contrato original (SP-06)">
        <bpmn:documentation>BN-005, SE-007; SP-06 desplegado.</bpmn:documentation>
        <bpmn:incoming>MAE_F71</bpmn:incoming>
        <bpmn:outgoing>MAE_F74</bpmn:outgoing>
        <bpmn:startEvent id="SP06_Inicio" name="Contratación confirmada">
          <bpmn:outgoing>MAE_F46</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="SP06_Controlar" name="Controlar los pagos realizados y pendientes y su fecha límite, e informar al Coordinador el saldo">
          <bpmn:documentation>BN-005, SE-007; CA-022, CA-024 (US-011, US-022)</bpmn:documentation>
          <bpmn:incoming>MAE_F46</bpmn:incoming>
          <bpmn:outgoing>MAE_F47</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="SP06_Comunicar" name="Comunicar al Cliente el importe pendiente y la fecha límite: 3 días hábiles antes del evento">
          <bpmn:documentation>BN-005; CA-023</bpmn:documentation>
          <bpmn:incoming>MAE_F47</bpmn:incoming>
          <bpmn:outgoing>MAE_F48</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="SP06_UEsp">
          <bpmn:incoming>MAE_F48</bpmn:incoming>
          <bpmn:incoming>MAE_F54</bpmn:incoming>
          <bpmn:outgoing>MAE_F49</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:eventBasedGateway id="SP06_Espera">
          <bpmn:incoming>MAE_F49</bpmn:incoming>
          <bpmn:outgoing>MAE_F50</bpmn:outgoing>
          <bpmn:outgoing>MAE_F55</bpmn:outgoing>
        </bpmn:eventBasedGateway>
        <bpmn:intermediateCatchEvent id="SP06_PagoSaldo" name="Pago del saldo recibido">
          <bpmn:incoming>MAE_F50</bpmn:incoming>
          <bpmn:outgoing>MAE_F51</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP06_PagoSaldo_def" />
        </bpmn:intermediateCatchEvent>
        <bpmn:task id="SP06_Verificar" name="Registrar y verificar el pago del saldo">
          <bpmn:documentation>BN-005; CA-026: cada concepto por separado.</bpmn:documentation>
          <bpmn:incoming>MAE_F51</bpmn:incoming>
          <bpmn:outgoing>MAE_F52</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="SP06_GwLiquidado" name="¿El saldo pendiente quedó liquidado?">
          <bpmn:incoming>MAE_F52</bpmn:incoming>
          <bpmn:outgoing>MAE_F53</bpmn:outgoing>
          <bpmn:outgoing>MAE_F54</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="SP06_FinLiquidado" name="Saldo liquidado">
          <bpmn:incoming>MAE_F53</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:intermediateCatchEvent id="SP06_Vence" name="Fecha límite vencida sin que el Cliente haya pagado el saldo">
          <bpmn:documentation>BN-005, SE-007: cuenta la fecha del pago, no la de su registro o verificación.</bpmn:documentation>
          <bpmn:incoming>MAE_F55</bpmn:incoming>
          <bpmn:outgoing>MAE_F56</bpmn:outgoing>
      <bpmn:timerEventDefinition id="SP06_Vence_def"></bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:task id="SP06_Protocolo" name="Activar el protocolo de cobro: enviar un recordatorio amistoso y registrar el seguimiento">
          <bpmn:documentation>BN-005; CA-025</bpmn:documentation>
          <bpmn:incoming>MAE_F56</bpmn:incoming>
          <bpmn:outgoing>MAE_F57</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="SP06_Moratorios" name="Comunicar al Cliente el saldo vencido y los cargos moratorios, registrados como concepto separado">
          <bpmn:documentation>BN-005; CA-025, CA-026</bpmn:documentation>
          <bpmn:incoming>MAE_F57</bpmn:incoming>
          <bpmn:outgoing>MAE_F58</bpmn:outgoing>
        </bpmn:task>
        <bpmn:intermediateCatchEvent id="SP06_Plazo24" name="24 horas naturales desde la comunicación de los cargos: plazo del Cliente para pagar">
          <bpmn:documentation>BN-005; CA-027</bpmn:documentation>
          <bpmn:incoming>MAE_F58</bpmn:incoming>
          <bpmn:outgoing>MAE_F59</bpmn:outgoing>
      <bpmn:timerEventDefinition id="SP06_Plazo24_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:task id="SP06_Revisar" name="Revisar los pagos y comprobar si el Cliente los efectuó dentro del plazo">
          <bpmn:documentation>BN-005, CA-027: decide la fecha en que el Cliente pagó; el registro y la verificación pueden ser posteriores.</bpmn:documentation>
          <bpmn:incoming>MAE_F59</bpmn:incoming>
          <bpmn:outgoing>MAE_F60</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="SP06_GwRegular" name="¿El Cliente pagó el saldo vencido y los cargos dentro de las 24 horas?">
          <bpmn:documentation>BN-005: un pago posterior a las 24 horas no evita la cancelación.</bpmn:documentation>
          <bpmn:incoming>MAE_F60</bpmn:incoming>
          <bpmn:outgoing>MAE_F61</bpmn:outgoing>
          <bpmn:outgoing>MAE_F65</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="SP06_RegLiquidacion" name="Registrar y verificar la liquidación, aunque sea después del plazo, e informar al Coordinador">
          <bpmn:documentation>CA-027, CA-066, CA-072</bpmn:documentation>
          <bpmn:incoming>MAE_F61</bpmn:incoming>
          <bpmn:outgoing>MAE_F62</bpmn:outgoing>
        </bpmn:task>
        <bpmn:intermediateThrowEvent id="SP06_Senal" name="Saldo vencido regularizado">
          <bpmn:documentation>Las solicitudes detenidas se retoman (SP-03, SP-04).</bpmn:documentation>
          <bpmn:incoming>MAE_F62</bpmn:incoming>
          <bpmn:outgoing>MAE_F63</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP06_Senal_def" signalRef="Signal_SaldoRegularizado" />
        </bpmn:intermediateThrowEvent>
        <bpmn:task id="SP06_Retomar" name="Retomar la organización del evento y las solicitudes detenidas que cumplan sus condiciones">
          <bpmn:documentation>BN-005; CA-027, CA-066, CA-072</bpmn:documentation>
          <bpmn:incoming>MAE_F63</bpmn:incoming>
          <bpmn:outgoing>MAE_F64</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="SP06_FinRegular" name="Saldo regularizado">
          <bpmn:incoming>MAE_F64</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:task id="SP06_NoRegular" name="Informar al Coordinador que el saldo y los cargos moratorios no se regularizaron">
          <bpmn:documentation>CA-027</bpmn:documentation>
          <bpmn:incoming>MAE_F65</bpmn:incoming>
          <bpmn:outgoing>MAE_F66</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="SP06_RegCancelacion" name="Registrar la cancelación del evento e indicar el motivo">
          <bpmn:documentation>BN-005, BN-008, CA-027: registro manual del Coordinador, en cuanto recibe el aviso y antes del inicio del evento.</bpmn:documentation>
          <bpmn:incoming>MAE_F66</bpmn:incoming>
          <bpmn:outgoing>MAE_F67</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="SP06_FinCancelacion" name="Evento cancelado por falta de regularización">
          <bpmn:incoming>MAE_F67</bpmn:incoming>
      <bpmn:errorEventDefinition id="SP06_FinCancelacion_def" errorRef="Error_FaltaRegularizacion" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="MAE_F46" sourceRef="SP06_Inicio" targetRef="SP06_Controlar" />
        <bpmn:sequenceFlow id="MAE_F47" sourceRef="SP06_Controlar" targetRef="SP06_Comunicar" />
        <bpmn:sequenceFlow id="MAE_F48" sourceRef="SP06_Comunicar" targetRef="SP06_UEsp" />
        <bpmn:sequenceFlow id="MAE_F49" sourceRef="SP06_UEsp" targetRef="SP06_Espera" />
        <bpmn:sequenceFlow id="MAE_F50" sourceRef="SP06_Espera" targetRef="SP06_PagoSaldo" />
        <bpmn:sequenceFlow id="MAE_F51" sourceRef="SP06_PagoSaldo" targetRef="SP06_Verificar" />
        <bpmn:sequenceFlow id="MAE_F52" sourceRef="SP06_Verificar" targetRef="SP06_GwLiquidado" />
        <bpmn:sequenceFlow id="MAE_F53" name="Sí" sourceRef="SP06_GwLiquidado" targetRef="SP06_FinLiquidado" />
        <bpmn:sequenceFlow id="MAE_F54" name="No" sourceRef="SP06_GwLiquidado" targetRef="SP06_UEsp" />
        <bpmn:sequenceFlow id="MAE_F55" sourceRef="SP06_Espera" targetRef="SP06_Vence" />
        <bpmn:sequenceFlow id="MAE_F56" sourceRef="SP06_Vence" targetRef="SP06_Protocolo" />
        <bpmn:sequenceFlow id="MAE_F57" sourceRef="SP06_Protocolo" targetRef="SP06_Moratorios" />
        <bpmn:sequenceFlow id="MAE_F58" sourceRef="SP06_Moratorios" targetRef="SP06_Plazo24" />
        <bpmn:sequenceFlow id="MAE_F59" sourceRef="SP06_Plazo24" targetRef="SP06_Revisar" />
        <bpmn:sequenceFlow id="MAE_F60" sourceRef="SP06_Revisar" targetRef="SP06_GwRegular" />
        <bpmn:sequenceFlow id="MAE_F61" name="Sí" sourceRef="SP06_GwRegular" targetRef="SP06_RegLiquidacion" />
        <bpmn:sequenceFlow id="MAE_F62" sourceRef="SP06_RegLiquidacion" targetRef="SP06_Senal" />
        <bpmn:sequenceFlow id="MAE_F63" sourceRef="SP06_Senal" targetRef="SP06_Retomar" />
        <bpmn:sequenceFlow id="MAE_F64" sourceRef="SP06_Retomar" targetRef="SP06_FinRegular" />
        <bpmn:sequenceFlow id="MAE_F65" name="No" sourceRef="SP06_GwRegular" targetRef="SP06_NoRegular" />
        <bpmn:sequenceFlow id="MAE_F66" sourceRef="SP06_NoRegular" targetRef="SP06_RegCancelacion" />
        <bpmn:sequenceFlow id="MAE_F67" sourceRef="SP06_RegCancelacion" targetRef="SP06_FinCancelacion" />
      </bpmn:subProcess>
      <bpmn:parallelGateway id="MAE_OrgJoin">
        <bpmn:incoming>MAE_F73</bpmn:incoming>
        <bpmn:incoming>MAE_F74</bpmn:incoming>
        <bpmn:outgoing>MAE_F75</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="MAE_OrgFin" name="Organización al día">
        <bpmn:incoming>MAE_F75</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="MAE_F69" sourceRef="MAE_OrgInicio" targetRef="MAE_OrgAnd" />
      <bpmn:sequenceFlow id="MAE_F70" sourceRef="MAE_OrgAnd" targetRef="MAE_Asignar" />
      <bpmn:sequenceFlow id="MAE_F71" sourceRef="MAE_OrgAnd" targetRef="MAE_Saldo" />
      <bpmn:sequenceFlow id="MAE_F72" sourceRef="MAE_Asignar" targetRef="MAE_Pendientes" />
      <bpmn:sequenceFlow id="MAE_F73" sourceRef="MAE_Pendientes" targetRef="MAE_OrgJoin" />
      <bpmn:sequenceFlow id="MAE_F74" sourceRef="MAE_Saldo" targetRef="MAE_OrgJoin" />
      <bpmn:sequenceFlow id="MAE_F75" sourceRef="MAE_OrgJoin" targetRef="MAE_OrgFin" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="MAE_BInicio" name="Fecha y hora de inicio del evento" attachedToRef="MAE_Organizacion">
      <bpmn:documentation>Interrumpe la organización: lo pendiente se cierra por inicio del evento (GL-032).</bpmn:documentation>
      <bpmn:outgoing>MAE_F88</bpmn:outgoing>
      <bpmn:timerEventDefinition id="MAE_BInicio_def"></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="MAE_BCancSol" name="Solicitud de cancelación del Cliente" attachedToRef="MAE_Organizacion">
      <bpmn:documentation>CA-084: contratación confirmada y evento no iniciado.</bpmn:documentation>
      <bpmn:outgoing>MAE_F97</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MAE_BCancSol_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="MAE_BFaltaReg" name="Cancelación registrada por falta de regularización" attachedToRef="MAE_Organizacion">
      <bpmn:documentation>Error que propaga el seguimiento del saldo (BN-005, CA-027).</bpmn:documentation>
      <bpmn:outgoing>MAE_F102</bpmn:outgoing>
      <bpmn:errorEventDefinition id="MAE_BFaltaReg_def" errorRef="Error_FaltaRegularizacion" />
    </bpmn:boundaryEvent>
    <bpmn:eventBasedGateway id="MAE_Espera">
      <bpmn:incoming>MAE_F84</bpmn:incoming>
      <bpmn:outgoing>MAE_F85</bpmn:outgoing>
      <bpmn:outgoing>MAE_F86</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="MAE_EspInicio" name="Fecha y hora de inicio del evento">
      <bpmn:incoming>MAE_F85</bpmn:incoming>
      <bpmn:outgoing>MAE_F87</bpmn:outgoing>
      <bpmn:timerEventDefinition id="MAE_EspInicio_def"></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="MAE_EspCanc" name="Solicitud de cancelación del Cliente">
      <bpmn:incoming>MAE_F86</bpmn:incoming>
      <bpmn:outgoing>MAE_F96</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MAE_EspCanc_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="MAE_UInicio">
      <bpmn:incoming>MAE_F87</bpmn:incoming>
      <bpmn:incoming>MAE_F88</bpmn:incoming>
      <bpmn:outgoing>MAE_F89</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="MAE_RegInicio" name="Inicio automático del evento al llegar T (En ejecución)">
      <bpmn:documentation>GL-032, GL-033, CA-109: lo aplica el proceso periódico del trabajador al llegar T (ADR-008); la operación explícita de inicio aplica la misma regla.</bpmn:documentation>
      <bpmn:incoming>MAE_F89</bpmn:incoming>
      <bpmn:outgoing>MAE_F90</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="MAE_SenalIni" name="Evento iniciado">
      <bpmn:documentation>CA-070, CA-071, CA-096: cierra las solicitudes no confirmadas (bandas B, C y D).</bpmn:documentation>
      <bpmn:incoming>MAE_F90</bpmn:incoming>
      <bpmn:outgoing>MAE_F91</bpmn:outgoing>
      <bpmn:signalEventDefinition id="MAE_SenalIni_def" signalRef="Signal_EventoIniciado" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="MAE_Ejecucion" name="Dar seguimiento a la ejecución del evento">
      <bpmn:documentation>GL-024</bpmn:documentation>
      <bpmn:incoming>MAE_F91</bpmn:incoming>
      <bpmn:outgoing>MAE_F92</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="MAE_BCancEjec" name="Solicitud de cancelación con el evento iniciado" attachedToRef="MAE_Ejecucion" cancelActivity="false">
      <bpmn:documentation>CA-088</bpmn:documentation>
      <bpmn:outgoing>MAE_F94</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MAE_BCancEjec_def" />
    </bpmn:boundaryEvent>
    <bpmn:task id="MAE_Rechazar" name="Registrar la solicitud como rechazada e informar al Cliente que no procede">
      <bpmn:documentation>CA-088, SE-009</bpmn:documentation>
      <bpmn:incoming>MAE_F94</bpmn:incoming>
      <bpmn:outgoing>MAE_F95</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="MAE_FinRechazo" name="Cancelación rechazada: el evento continúa">
      <bpmn:incoming>MAE_F95</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="MAE_Finalizar" name="Registrar la finalización del evento y su fecha">
      <bpmn:documentation>BN-010; CA-094 (US-030)</bpmn:documentation>
      <bpmn:incoming>MAE_F92</bpmn:incoming>
      <bpmn:outgoing>MAE_F93</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="MAE_FinFinalizado" name="Evento finalizado">
      <bpmn:documentation>CA-094, CA-095</bpmn:documentation>
      <bpmn:incoming>MAE_F93</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="MAE_UCancSol">
      <bpmn:incoming>MAE_F96</bpmn:incoming>
      <bpmn:incoming>MAE_F97</bpmn:incoming>
      <bpmn:outgoing>MAE_F98</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="MAE_RegSolicitud" name="Registrar la solicitud de cancelación">
      <bpmn:documentation>CA-084 (US-026, US-027)</bpmn:documentation>
      <bpmn:incoming>MAE_F98</bpmn:incoming>
      <bpmn:outgoing>MAE_F99</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="MAE_RevisarCanc" name="Revisar el estado del evento y las condiciones del contrato">
      <bpmn:documentation>CA-085, CA-086</bpmn:documentation>
      <bpmn:incoming>MAE_F99</bpmn:incoming>
      <bpmn:outgoing>MAE_F100</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="MAE_RegCanc" name="Registrar la cancelación con el motivo de la solicitud del Cliente">
      <bpmn:documentation>BN-008; CA-087</bpmn:documentation>
      <bpmn:incoming>MAE_F100</bpmn:incoming>
      <bpmn:outgoing>MAE_F101</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="MAE_UCanc">
      <bpmn:incoming>MAE_F101</bpmn:incoming>
      <bpmn:incoming>MAE_F102</bpmn:incoming>
      <bpmn:outgoing>MAE_F103</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="MAE_Cancelacion" name="Gestionar la cancelación del evento (SP-07)">
      <bpmn:documentation>BN-008, SE-009, SE-012; SP-07 desplegado.</bpmn:documentation>
      <bpmn:incoming>MAE_F103</bpmn:incoming>
      <bpmn:outgoing>MAE_F104</bpmn:outgoing>
      <bpmn:startEvent id="SP07_Inicio" name="Cancelación registrada por el Coordinador">
        <bpmn:documentation>Por solicitud procedente del Cliente (CA-087) o por falta de regularización del saldo vencido (CA-027).</bpmn:documentation>
        <bpmn:outgoing>MAE_F76</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="SP07_Senal" name="Evento cancelado">
        <bpmn:documentation>BN-008: la señal llega a cada solicitud del Evento (SP-03, SP-04, SP-05).</bpmn:documentation>
        <bpmn:incoming>MAE_F76</bpmn:incoming>
        <bpmn:outgoing>MAE_F77</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP07_Senal_def" signalRef="Signal_EventoCancelado" />
      </bpmn:intermediateThrowEvent>
      <bpmn:task id="SP07_Comunicar" name="Comunicar la cancelación al Cliente, a Administración y a los proveedores e informar la política de no reembolso">
        <bpmn:documentation>BN-008; CA-087, SE-009</bpmn:documentation>
        <bpmn:incoming>MAE_F77</bpmn:incoming>
        <bpmn:outgoing>MAE_F78</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP07_Constancia" name="Dejar constancia de la cancelación y de las comunicaciones realizadas">
        <bpmn:documentation>CA-087, SE-007</bpmn:documentation>
        <bpmn:incoming>MAE_F78</bpmn:incoming>
        <bpmn:outgoing>MAE_F79</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP07_Revisar" name="Revisar el contrato y los pagos realizados del evento">
        <bpmn:documentation>CA-089, CA-090 (US-028)</bpmn:documentation>
        <bpmn:incoming>MAE_F79</bpmn:incoming>
        <bpmn:outgoing>MAE_F80</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP07_Resultado" name="Registrar el resultado: pagos realizados, saldo pendiente y constancia de no reembolso">
        <bpmn:documentation>CA-091: sin agregar motivos de rechazo.</bpmn:documentation>
        <bpmn:incoming>MAE_F80</bpmn:incoming>
        <bpmn:outgoing>MAE_F81</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP07_Informar" name="Informar el resultado al Coordinador">
        <bpmn:documentation>CA-091</bpmn:documentation>
        <bpmn:incoming>MAE_F81</bpmn:incoming>
        <bpmn:outgoing>MAE_F82</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP07_Seguimiento" name="Dar seguimiento a la cancelación">
        <bpmn:documentation>SE-009 (US-027)</bpmn:documentation>
        <bpmn:incoming>MAE_F82</bpmn:incoming>
        <bpmn:outgoing>MAE_F83</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP07_Fin" name="Evento cancelado">
        <bpmn:documentation>CA-095: un Evento Cancelado no pasa a Finalizado.</bpmn:documentation>
        <bpmn:incoming>MAE_F83</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="MAE_F76" sourceRef="SP07_Inicio" targetRef="SP07_Senal" />
      <bpmn:sequenceFlow id="MAE_F77" sourceRef="SP07_Senal" targetRef="SP07_Comunicar" />
      <bpmn:sequenceFlow id="MAE_F78" sourceRef="SP07_Comunicar" targetRef="SP07_Constancia" />
      <bpmn:sequenceFlow id="MAE_F79" sourceRef="SP07_Constancia" targetRef="SP07_Revisar" />
      <bpmn:sequenceFlow id="MAE_F80" sourceRef="SP07_Revisar" targetRef="SP07_Resultado" />
      <bpmn:sequenceFlow id="MAE_F81" sourceRef="SP07_Resultado" targetRef="SP07_Informar" />
      <bpmn:sequenceFlow id="MAE_F82" sourceRef="SP07_Informar" targetRef="SP07_Seguimiento" />
      <bpmn:sequenceFlow id="MAE_F83" sourceRef="SP07_Seguimiento" targetRef="SP07_Fin" />
    </bpmn:subProcess>
    <bpmn:endEvent id="MAE_FinCancelado" name="Evento cancelado">
      <bpmn:documentation>CA-095: no pasa a Finalizado.</bpmn:documentation>
      <bpmn:incoming>MAE_F104</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="SP03_Inicio" name="Solicitud de cambio del Cliente">
      <bpmn:documentation>CA-059 (US-023)</bpmn:documentation>
      <bpmn:outgoing>MAE_F105</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP03_Inicio_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="SP03_GwOrg" name="¿El Evento está En organización?">
      <bpmn:documentation>CA-039: después de contratar y antes del inicio.</bpmn:documentation>
      <bpmn:incoming>MAE_F105</bpmn:incoming>
      <bpmn:outgoing>MAE_F106</bpmn:outgoing>
      <bpmn:outgoing>MAE_F108</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP03_NoOrg" name="Informar al Cliente que el cambio no procede">
      <bpmn:documentation>CA-039</bpmn:documentation>
      <bpmn:incoming>MAE_F106</bpmn:incoming>
      <bpmn:outgoing>MAE_F107</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP03_FinNoOrg" name="No procede">
      <bpmn:incoming>MAE_F107</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP03_GwFecha" name="¿El cambio reprograma la fecha del evento?">
      <bpmn:documentation>BRD, fuera del alcance: solo puede cambiarse la hora del mismo día (GL-019).</bpmn:documentation>
      <bpmn:incoming>MAE_F108</bpmn:incoming>
      <bpmn:outgoing>MAE_F109</bpmn:outgoing>
      <bpmn:outgoing>MAE_F111</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP03_NoFecha" name="Informar al Cliente que reprogramar la fecha está fuera del alcance">
      <bpmn:incoming>MAE_F109</bpmn:incoming>
      <bpmn:outgoing>MAE_F110</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP03_FinNoFecha" name="No procede (fecha fuera del alcance)">
      <bpmn:incoming>MAE_F110</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SP03_Tramitar" name="Tramitar la solicitud de cambio (solicitud en trámite)">
      <bpmn:documentation>Mientras la solicitud está en trámite, las señales «Evento iniciado» y «Evento cancelado» la cierran.</bpmn:documentation>
      <bpmn:incoming>MAE_F111</bpmn:incoming>
      <bpmn:outgoing>MAE_F157</bpmn:outgoing>
      <bpmn:startEvent id="SP03_IniSub" name="Solicitud admitida">
        <bpmn:outgoing>MAE_F112</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP03_Registrar" name="Registrar la solicitud de cambio con su fecha y su anticipación al evento">
        <bpmn:documentation>BN-003; CA-037 (US-017)</bpmn:documentation>
        <bpmn:incoming>MAE_F112</bpmn:incoming>
        <bpmn:outgoing>MAE_F113</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_USaldo">
        <bpmn:incoming>MAE_F113</bpmn:incoming>
        <bpmn:incoming>MAE_F117</bpmn:incoming>
        <bpmn:outgoing>MAE_F114</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP03_GwSaldo" name="¿Existe saldo vencido del contrato original?">
        <bpmn:documentation>BN-003, SE-006: se verifica antes de tramitar.</bpmn:documentation>
        <bpmn:incoming>MAE_F114</bpmn:incoming>
        <bpmn:outgoing>MAE_F115</bpmn:outgoing>
        <bpmn:outgoing>MAE_F118</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Detener" name="Detener la gestión e informar al Cliente que debe regularizar el saldo y los cargos moratorios">
        <bpmn:documentation>CA-066 (Detenida por saldo vencido)</bpmn:documentation>
        <bpmn:incoming>MAE_F115</bpmn:incoming>
        <bpmn:outgoing>MAE_F116</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="SP03_Regularizado" name="Saldo vencido regularizado">
        <bpmn:documentation>CA-066: Administración verificó la liquidación dentro de las 24 horas naturales.</bpmn:documentation>
        <bpmn:incoming>MAE_F116</bpmn:incoming>
        <bpmn:outgoing>MAE_F117</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP03_Regularizado_def" signalRef="Signal_SaldoRegularizado" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP03_Gw7" name="¿Se solicitó con 7 días naturales o más de anticipación?">
        <bpmn:documentation>BN-003, SE-003, SE-005</bpmn:documentation>
        <bpmn:incoming>MAE_F118</bpmn:incoming>
        <bpmn:outgoing>MAE_F119</bpmn:outgoing>
        <bpmn:outgoing>MAE_F120</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_SinCargo" name="Registrar que no aplica el cargo de Eventos Nova">
        <bpmn:documentation>CA-061</bpmn:documentation>
        <bpmn:incoming>MAE_F119</bpmn:incoming>
        <bpmn:outgoing>MAE_F121</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP03_ConCargo" name="Registrar la tarifa vigente del cargo por cambio tardío (se cobra solo si el cambio se realiza)">
        <bpmn:documentation>CA-062, SE-005, GL-025</bpmn:documentation>
        <bpmn:incoming>MAE_F120</bpmn:incoming>
        <bpmn:outgoing>MAE_F122</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_U7">
        <bpmn:incoming>MAE_F121</bpmn:incoming>
        <bpmn:incoming>MAE_F122</bpmn:incoming>
        <bpmn:outgoing>MAE_F123</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Viabilidad" name="Consultar la viabilidad con los proveedores involucrados y evaluar el impacto en servicios, costos y condiciones">
        <bpmn:documentation>CA-060, CA-063, CA-064; SE-002, SE-003: el costo adicional del proveedor se registra aparte del cargo por cambio tardío.</bpmn:documentation>
        <bpmn:incoming>MAE_F123</bpmn:incoming>
        <bpmn:outgoing>MAE_F124</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_GwViable" name="¿El cambio es viable?">
        <bpmn:incoming>MAE_F124</bpmn:incoming>
        <bpmn:outgoing>MAE_F125</bpmn:outgoing>
        <bpmn:outgoing>MAE_F127</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_NoViable" name="Informar al Cliente, registrar la solicitud como no procedente y conservar la última configuración confirmada">
        <bpmn:documentation>CA-065, CA-069, SE-008: no se cobra el cargo por cambio tardío.</bpmn:documentation>
        <bpmn:incoming>MAE_F125</bpmn:incoming>
        <bpmn:outgoing>MAE_F126</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_FinNoViable" name="No procedente">
        <bpmn:incoming>MAE_F126</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP03_GwImpacto" name="¿Afecta los costos o las condiciones acordadas?">
        <bpmn:documentation>CA-038</bpmn:documentation>
        <bpmn:incoming>MAE_F127</bpmn:incoming>
        <bpmn:outgoing>MAE_F128</bpmn:outgoing>
        <bpmn:outgoing>MAE_F129</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Presentar" name="Presentar el cambio con sus costos y condiciones al Cliente y registrar su decisión">
        <bpmn:documentation>CA-040, CA-043 (US-018, US-019)</bpmn:documentation>
        <bpmn:incoming>MAE_F129</bpmn:incoming>
        <bpmn:outgoing>MAE_F130</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_GwCliente" name="¿El Cliente aprueba el cambio?">
        <bpmn:incoming>MAE_F130</bpmn:incoming>
        <bpmn:outgoing>MAE_F131</bpmn:outgoing>
        <bpmn:outgoing>MAE_F133</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Rechazo" name="Registrar el rechazo del Cliente y conservar la última configuración confirmada">
        <bpmn:documentation>CA-042</bpmn:documentation>
        <bpmn:incoming>MAE_F131</bpmn:incoming>
        <bpmn:outgoing>MAE_F132</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_FinRechazo" name="Rechazada por el Cliente">
        <bpmn:incoming>MAE_F132</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP03_Autorizar" name="Autorizar o rechazar el cambio">
        <bpmn:documentation>CA-044, CA-045 (US-020)</bpmn:documentation>
        <bpmn:incoming>MAE_F133</bpmn:incoming>
        <bpmn:outgoing>MAE_F134</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_GwAdmin" name="¿Administración autoriza?">
        <bpmn:incoming>MAE_F134</bpmn:incoming>
        <bpmn:outgoing>MAE_F135</bpmn:outgoing>
        <bpmn:outgoing>MAE_F137</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_NoAutorizado" name="Registrar el rechazo de Administración, informar al Cliente y conservar la última configuración confirmada">
        <bpmn:documentation>CA-044</bpmn:documentation>
        <bpmn:incoming>MAE_F135</bpmn:incoming>
        <bpmn:outgoing>MAE_F136</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_FinNoAut" name="No autorizada">
        <bpmn:incoming>MAE_F136</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP03_UAprob">
        <bpmn:incoming>MAE_F128</bpmn:incoming>
        <bpmn:incoming>MAE_F137</bpmn:incoming>
        <bpmn:outgoing>MAE_F138</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Anexo" name="Documentar el cambio aprobado en un anexo vinculado al contrato original">
        <bpmn:documentation>BN-003; CA-068</bpmn:documentation>
        <bpmn:incoming>MAE_F138</bpmn:incoming>
        <bpmn:outgoing>MAE_F139</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_GwImportes" name="¿Genera nuevos importes por pagar?">
        <bpmn:incoming>MAE_F139</bpmn:incoming>
        <bpmn:outgoing>MAE_F140</bpmn:outgoing>
        <bpmn:outgoing>MAE_F141</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_SolPago" name="Comunicar la solicitud de pago: costo del proveedor y cargo por cambio tardío como conceptos separados">
        <bpmn:documentation>CA-067, SE-006: el Cliente tiene 24 horas naturales desde esta comunicación.</bpmn:documentation>
        <bpmn:incoming>MAE_F140</bpmn:incoming>
        <bpmn:outgoing>MAE_F142</bpmn:outgoing>
      </bpmn:task>
      <bpmn:eventBasedGateway id="SP03_EspPago">
        <bpmn:incoming>MAE_F142</bpmn:incoming>
        <bpmn:outgoing>MAE_F143</bpmn:outgoing>
        <bpmn:outgoing>MAE_F144</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SP03_Plazo" name="24 horas naturales: plazo del Cliente para pagar">
        <bpmn:documentation>BN-003, CA-067: plazo para que el Cliente efectúe el pago, no para registrarlo.</bpmn:documentation>
        <bpmn:incoming>MAE_F143</bpmn:incoming>
        <bpmn:outgoing>MAE_F145</bpmn:outgoing>
      <bpmn:timerEventDefinition id="SP03_Plazo_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP03_RevisarPago" name="Revisar los pagos y comprobar si el Cliente pagó dentro de las 24 horas">
        <bpmn:documentation>BN-003, CA-067: decide la fecha en que el Cliente pagó, no la del registro o la verificación.</bpmn:documentation>
        <bpmn:incoming>MAE_F145</bpmn:incoming>
        <bpmn:outgoing>MAE_F146</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_GwEnPlazo" name="¿El Cliente efectuó el pago dentro de las 24 horas?">
        <bpmn:incoming>MAE_F146</bpmn:incoming>
        <bpmn:outgoing>MAE_F147</bpmn:outgoing>
        <bpmn:outgoing>MAE_F149</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_FaltaPago" name="Cerrar la solicitud por falta de pago, registrar el motivo e informar al Cliente">
        <bpmn:documentation>BN-003, CA-067: se conserva la última configuración confirmada.</bpmn:documentation>
        <bpmn:incoming>MAE_F147</bpmn:incoming>
        <bpmn:outgoing>MAE_F148</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_FinFaltaPago" name="Cerrada por falta de pago">
        <bpmn:incoming>MAE_F148</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="SP03_PagoRecibido" name="Pago del Cliente recibido">
        <bpmn:incoming>MAE_F144</bpmn:incoming>
        <bpmn:outgoing>MAE_F150</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP03_PagoRecibido_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP03_UVer">
        <bpmn:incoming>MAE_F149</bpmn:incoming>
        <bpmn:incoming>MAE_F150</bpmn:incoming>
        <bpmn:outgoing>MAE_F151</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_VerificarPago" name="Registrar y verificar el pago, aunque sea después de las 24 horas">
        <bpmn:documentation>CA-041, CA-067: un pago efectuado a tiempo no se trata como falta de pago por la demora administrativa.</bpmn:documentation>
        <bpmn:incoming>MAE_F151</bpmn:incoming>
        <bpmn:outgoing>MAE_F152</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_UPago">
        <bpmn:incoming>MAE_F141</bpmn:incoming>
        <bpmn:incoming>MAE_F152</bpmn:incoming>
        <bpmn:outgoing>MAE_F153</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_Confirmar" name="Verificar el anexo y, cuando aplique, el pago verificado, y confirmar el cambio">
        <bpmn:documentation>CA-041, CA-068 (Confirmada)</bpmn:documentation>
        <bpmn:incoming>MAE_F153</bpmn:incoming>
        <bpmn:outgoing>MAE_F154</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_FinConfirmada" name="Cambio confirmado">
        <bpmn:incoming>MAE_F154</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="MAE_F112" sourceRef="SP03_IniSub" targetRef="SP03_Registrar" />
      <bpmn:sequenceFlow id="MAE_F113" sourceRef="SP03_Registrar" targetRef="SP03_USaldo" />
      <bpmn:sequenceFlow id="MAE_F114" sourceRef="SP03_USaldo" targetRef="SP03_GwSaldo" />
      <bpmn:sequenceFlow id="MAE_F115" name="Sí" sourceRef="SP03_GwSaldo" targetRef="SP03_Detener" />
      <bpmn:sequenceFlow id="MAE_F116" sourceRef="SP03_Detener" targetRef="SP03_Regularizado" />
      <bpmn:sequenceFlow id="MAE_F117" sourceRef="SP03_Regularizado" targetRef="SP03_USaldo" />
      <bpmn:sequenceFlow id="MAE_F118" name="No" sourceRef="SP03_GwSaldo" targetRef="SP03_Gw7" />
      <bpmn:sequenceFlow id="MAE_F119" name="Sí" sourceRef="SP03_Gw7" targetRef="SP03_SinCargo" />
      <bpmn:sequenceFlow id="MAE_F120" name="No" sourceRef="SP03_Gw7" targetRef="SP03_ConCargo" />
      <bpmn:sequenceFlow id="MAE_F121" sourceRef="SP03_SinCargo" targetRef="SP03_U7" />
      <bpmn:sequenceFlow id="MAE_F122" sourceRef="SP03_ConCargo" targetRef="SP03_U7" />
      <bpmn:sequenceFlow id="MAE_F123" sourceRef="SP03_U7" targetRef="SP03_Viabilidad" />
      <bpmn:sequenceFlow id="MAE_F124" sourceRef="SP03_Viabilidad" targetRef="SP03_GwViable" />
      <bpmn:sequenceFlow id="MAE_F125" name="No" sourceRef="SP03_GwViable" targetRef="SP03_NoViable" />
      <bpmn:sequenceFlow id="MAE_F126" sourceRef="SP03_NoViable" targetRef="SP03_FinNoViable" />
      <bpmn:sequenceFlow id="MAE_F127" name="Sí" sourceRef="SP03_GwViable" targetRef="SP03_GwImpacto" />
      <bpmn:sequenceFlow id="MAE_F128" name="No" sourceRef="SP03_GwImpacto" targetRef="SP03_UAprob" />
      <bpmn:sequenceFlow id="MAE_F129" name="Sí" sourceRef="SP03_GwImpacto" targetRef="SP03_Presentar" />
      <bpmn:sequenceFlow id="MAE_F130" sourceRef="SP03_Presentar" targetRef="SP03_GwCliente" />
      <bpmn:sequenceFlow id="MAE_F131" name="No" sourceRef="SP03_GwCliente" targetRef="SP03_Rechazo" />
      <bpmn:sequenceFlow id="MAE_F132" sourceRef="SP03_Rechazo" targetRef="SP03_FinRechazo" />
      <bpmn:sequenceFlow id="MAE_F133" name="Sí" sourceRef="SP03_GwCliente" targetRef="SP03_Autorizar" />
      <bpmn:sequenceFlow id="MAE_F134" sourceRef="SP03_Autorizar" targetRef="SP03_GwAdmin" />
      <bpmn:sequenceFlow id="MAE_F135" name="No" sourceRef="SP03_GwAdmin" targetRef="SP03_NoAutorizado" />
      <bpmn:sequenceFlow id="MAE_F136" sourceRef="SP03_NoAutorizado" targetRef="SP03_FinNoAut" />
      <bpmn:sequenceFlow id="MAE_F137" name="Sí" sourceRef="SP03_GwAdmin" targetRef="SP03_UAprob" />
      <bpmn:sequenceFlow id="MAE_F138" sourceRef="SP03_UAprob" targetRef="SP03_Anexo" />
      <bpmn:sequenceFlow id="MAE_F139" sourceRef="SP03_Anexo" targetRef="SP03_GwImportes" />
      <bpmn:sequenceFlow id="MAE_F140" name="Sí" sourceRef="SP03_GwImportes" targetRef="SP03_SolPago" />
      <bpmn:sequenceFlow id="MAE_F141" name="No" sourceRef="SP03_GwImportes" targetRef="SP03_UPago" />
      <bpmn:sequenceFlow id="MAE_F142" sourceRef="SP03_SolPago" targetRef="SP03_EspPago" />
      <bpmn:sequenceFlow id="MAE_F143" sourceRef="SP03_EspPago" targetRef="SP03_Plazo" />
      <bpmn:sequenceFlow id="MAE_F144" sourceRef="SP03_EspPago" targetRef="SP03_PagoRecibido" />
      <bpmn:sequenceFlow id="MAE_F145" sourceRef="SP03_Plazo" targetRef="SP03_RevisarPago" />
      <bpmn:sequenceFlow id="MAE_F146" sourceRef="SP03_RevisarPago" targetRef="SP03_GwEnPlazo" />
      <bpmn:sequenceFlow id="MAE_F147" name="No" sourceRef="SP03_GwEnPlazo" targetRef="SP03_FaltaPago" />
      <bpmn:sequenceFlow id="MAE_F148" sourceRef="SP03_FaltaPago" targetRef="SP03_FinFaltaPago" />
      <bpmn:sequenceFlow id="MAE_F149" name="Sí" sourceRef="SP03_GwEnPlazo" targetRef="SP03_UVer" />
      <bpmn:sequenceFlow id="MAE_F150" sourceRef="SP03_PagoRecibido" targetRef="SP03_UVer" />
      <bpmn:sequenceFlow id="MAE_F151" sourceRef="SP03_UVer" targetRef="SP03_VerificarPago" />
      <bpmn:sequenceFlow id="MAE_F152" sourceRef="SP03_VerificarPago" targetRef="SP03_UPago" />
      <bpmn:sequenceFlow id="MAE_F153" sourceRef="SP03_UPago" targetRef="SP03_Confirmar" />
      <bpmn:sequenceFlow id="MAE_F154" sourceRef="SP03_Confirmar" targetRef="SP03_FinConfirmada" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="SP03_BCancelado" name="Evento cancelado" attachedToRef="SP03_Tramitar">
      <bpmn:documentation>Caso A (BN-008): la solicitud sigue en trámite cuando se cancela el Evento.</bpmn:documentation>
      <bpmn:outgoing>MAE_F155</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP03_BCancelado_def" signalRef="Signal_EventoCancelado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP03_CerrarCan" name="Cerrar la solicitud con el motivo «Evento cancelado» (Cerrada por evento cancelado)">
      <bpmn:documentation>BN-008, SE-007, CA-087: no se confirma ni se realiza.</bpmn:documentation>
      <bpmn:incoming>MAE_F155</bpmn:incoming>
      <bpmn:outgoing>MAE_F166</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="SP03_BIniciado" name="Evento iniciado" attachedToRef="SP03_Tramitar">
      <bpmn:documentation>CA-070: lo no confirmado antes del inicio se cierra.</bpmn:documentation>
      <bpmn:outgoing>MAE_F156</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP03_BIniciado_def" signalRef="Signal_EventoIniciado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP03_CerrarIni" name="Cerrar la solicitud como «Cerrada por inicio del evento»">
      <bpmn:documentation>CA-070</bpmn:documentation>
      <bpmn:incoming>MAE_F156</bpmn:incoming>
      <bpmn:outgoing>MAE_F167</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="SP03_GwResultado" name="¿Cómo terminó el trámite?">
      <bpmn:incoming>MAE_F157</bpmn:incoming>
      <bpmn:outgoing>MAE_F158</bpmn:outgoing>
      <bpmn:outgoing>MAE_F159</bpmn:outgoing>
      <bpmn:outgoing>MAE_F168</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP03_FinSinCobros" name="Cerrada en el trámite, sin cobros pendientes">
      <bpmn:documentation>No procedente, rechazada por el Cliente o no autorizada: se conserva la última configuración confirmada.</bpmn:documentation>
      <bpmn:incoming>MAE_F158</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP03_GwCancel" name="¿El Evento fue cancelado antes de aplicar el cambio?">
      <bpmn:documentation>Se evalúa al aplicar la operación confirmada (BN-006, BN-008).</bpmn:documentation>
      <bpmn:incoming>MAE_F159</bpmn:incoming>
      <bpmn:outgoing>MAE_F160</bpmn:outgoing>
      <bpmn:outgoing>MAE_F163</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP03_NoAplicar" name="No aplicar el cambio en el Evento cancelado; la solicitud conserva su confirmación y su historial">
      <bpmn:documentation>Caso B (BN-008): no se modifica la configuración del Evento cancelado ni se cierra la solicitud.</bpmn:documentation>
      <bpmn:incoming>MAE_F160</bpmn:incoming>
      <bpmn:outgoing>MAE_F161</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP03_Revision" name="Registrar para revisión que la operación no pudo aplicarse por la cancelación (registro técnico en «Revisión»)">
      <bpmn:documentation>Caso B (BN-008): sin devoluciones, nuevas obligaciones ni cambios en el saldo; rige la política de no reembolso (SE-012). «Revisión» es el estado técnico del registro del Outbox, no un estado de negocio ni un trámite humano adicional.</bpmn:documentation>
      <bpmn:incoming>MAE_F161</bpmn:incoming>
      <bpmn:outgoing>MAE_F162</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP03_FinRevision" name="Confirmada, no aplicada: en revisión">
      <bpmn:incoming>MAE_F162</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="SP03_Aplicar" name="Aplicar el cambio a la configuración vigente, aunque el Evento ya haya iniciado (O-02)">
      <bpmn:documentation>Caso C (BN-006, O-02): el Evento sigue activo; si ya inició, se aplica porque se confirmó antes del inicio.</bpmn:documentation>
      <bpmn:incoming>MAE_F163</bpmn:incoming>
      <bpmn:outgoing>MAE_F164</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP03_Comunicar" name="Comunicar la modificación a los proveedores y a las personas involucradas">
      <bpmn:documentation>BN-006</bpmn:documentation>
      <bpmn:incoming>MAE_F164</bpmn:incoming>
      <bpmn:outgoing>MAE_F165</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP03_FinAplicada" name="Confirmada y aplicada al Evento">
      <bpmn:incoming>MAE_F165</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP03_UCierre">
      <bpmn:incoming>MAE_F166</bpmn:incoming>
      <bpmn:incoming>MAE_F167</bpmn:incoming>
      <bpmn:incoming>MAE_F168</bpmn:incoming>
      <bpmn:outgoing>MAE_F180</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP03_DevImp" name="Resolver los importes de la operación no realizada (SE-012)">
      <bpmn:documentation>SP-08 desplegado: cobros exclusivos sin efecto y devolución solo si el Evento no está cancelado (SE-012).</bpmn:documentation>
      <bpmn:incoming>MAE_F180</bpmn:incoming>
      <bpmn:outgoing>MAE_F181</bpmn:outgoing>
      <bpmn:startEvent id="SP03_SE_SP08_Inicio" name="Solicitud cerrada sin realizarse">
        <bpmn:outgoing>MAE_F169</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP03_SE_SP08_SinEfecto" name="Dejar sin efecto los importes pendientes de cobro exclusivos de la solicitud">
        <bpmn:documentation>SE-012, CA-097</bpmn:documentation>
        <bpmn:incoming>MAE_F169</bpmn:incoming>
        <bpmn:outgoing>MAE_F170</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP03_SE_SP08_GwCancelado" name="¿El Evento está cancelado?">
        <bpmn:incoming>MAE_F170</bpmn:incoming>
        <bpmn:outgoing>MAE_F171</bpmn:outgoing>
        <bpmn:outgoing>MAE_F173</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP03_SE_SP08_NoReembolso" name="Aplicar la política de no reembolso de la cancelación: sin devolución">
        <bpmn:documentation>SE-012, BN-008</bpmn:documentation>
        <bpmn:incoming>MAE_F171</bpmn:incoming>
        <bpmn:outgoing>MAE_F172</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_SE_SP08_FinNoReembolso" name="Sin devolución (Evento cancelado)">
        <bpmn:incoming>MAE_F172</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP03_SE_SP08_GwRecibido" name="¿Se recibieron importes exclusivos de la operación no realizada?">
        <bpmn:incoming>MAE_F173</bpmn:incoming>
        <bpmn:outgoing>MAE_F174</bpmn:outgoing>
        <bpmn:outgoing>MAE_F175</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SP03_SE_SP08_FinSinImporte" name="Sin importes por devolver">
        <bpmn:incoming>MAE_F174</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP03_SE_SP08_VerificarImp" name="Verificar el importe a devolver (en una sustitución, solo el importe adicional atribuible al reemplazo)">
        <bpmn:documentation>SE-001, SE-012, CA-097</bpmn:documentation>
        <bpmn:incoming>MAE_F175</bpmn:incoming>
        <bpmn:outgoing>MAE_F176</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP03_SE_SP08_Devolver" name="Efectuar la devolución en 5 días hábiles desde el cierre (o desde el registro del pago, si es posterior)">
        <bpmn:documentation>SE-012, CA-097, CA-098</bpmn:documentation>
        <bpmn:incoming>MAE_F176</bpmn:incoming>
        <bpmn:outgoing>MAE_F177</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP03_SE_SP08_Registrar" name="Registrar concepto, solicitud, importe, motivo, fecha y comprobante, e informar al Coordinador">
        <bpmn:documentation>CA-098 (US-031)</bpmn:documentation>
        <bpmn:incoming>MAE_F177</bpmn:incoming>
        <bpmn:outgoing>MAE_F178</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP03_SE_SP08_Comunicar" name="Comunicar el resultado al Cliente">
        <bpmn:documentation>CA-098</bpmn:documentation>
        <bpmn:incoming>MAE_F178</bpmn:incoming>
        <bpmn:outgoing>MAE_F179</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP03_SE_SP08_FinDevuelto" name="Devolución efectuada">
        <bpmn:incoming>MAE_F179</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="MAE_F169" sourceRef="SP03_SE_SP08_Inicio" targetRef="SP03_SE_SP08_SinEfecto" />
      <bpmn:sequenceFlow id="MAE_F170" sourceRef="SP03_SE_SP08_SinEfecto" targetRef="SP03_SE_SP08_GwCancelado" />
      <bpmn:sequenceFlow id="MAE_F171" name="Sí" sourceRef="SP03_SE_SP08_GwCancelado" targetRef="SP03_SE_SP08_NoReembolso" />
      <bpmn:sequenceFlow id="MAE_F172" sourceRef="SP03_SE_SP08_NoReembolso" targetRef="SP03_SE_SP08_FinNoReembolso" />
      <bpmn:sequenceFlow id="MAE_F173" name="No" sourceRef="SP03_SE_SP08_GwCancelado" targetRef="SP03_SE_SP08_GwRecibido" />
      <bpmn:sequenceFlow id="MAE_F174" name="No" sourceRef="SP03_SE_SP08_GwRecibido" targetRef="SP03_SE_SP08_FinSinImporte" />
      <bpmn:sequenceFlow id="MAE_F175" name="Sí" sourceRef="SP03_SE_SP08_GwRecibido" targetRef="SP03_SE_SP08_VerificarImp" />
      <bpmn:sequenceFlow id="MAE_F176" sourceRef="SP03_SE_SP08_VerificarImp" targetRef="SP03_SE_SP08_Devolver" />
      <bpmn:sequenceFlow id="MAE_F177" sourceRef="SP03_SE_SP08_Devolver" targetRef="SP03_SE_SP08_Registrar" />
      <bpmn:sequenceFlow id="MAE_F178" sourceRef="SP03_SE_SP08_Registrar" targetRef="SP03_SE_SP08_Comunicar" />
      <bpmn:sequenceFlow id="MAE_F179" sourceRef="SP03_SE_SP08_Comunicar" targetRef="SP03_SE_SP08_FinDevuelto" />
    </bpmn:subProcess>
    <bpmn:endEvent id="SP03_FinImportes" name="Solicitud cerrada sin realizarse: importes resueltos">
      <bpmn:incoming>MAE_F181</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="SP04_Inicio" name="Solicitud de servicio adicional del Cliente">
      <bpmn:documentation>US-025</bpmn:documentation>
      <bpmn:outgoing>MAE_F182</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP04_Inicio_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="SP04_GwContr" name="¿La contratación está confirmada?">
      <bpmn:documentation>C-14, GL-015, BN-004, SE-004, CA-101: un servicio adicional solo puede registrarse con la contratación confirmada. Con el Evento En gestión o Cerrado sin contratación no se registra la solicitud ni se evalúan el estado del Evento, el plazo mínimo o el saldo vencido. Un Evento Cancelado o En ejecución tuvo la contratación confirmada: la solicitud se registra y se resuelve en la compuerta siguiente (CA-099, CA-100).</bpmn:documentation>
      <bpmn:incoming>MAE_F182</bpmn:incoming>
      <bpmn:outgoing>MAE_F324</bpmn:outgoing>
      <bpmn:outgoing>MAE_F325</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP04_NoRegistrar" name="No registrar la solicitud e informar al Cliente que un servicio adicional solo puede registrarse con la contratación confirmada">
      <bpmn:documentation>CA-101: el Coordinador no registra la solicitud e informa al Cliente; no se evalúan el plazo mínimo ni el saldo vencido.</bpmn:documentation>
      <bpmn:incoming>MAE_F325</bpmn:incoming>
      <bpmn:outgoing>MAE_F326</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP04_FinNoRegistrada" name="Solicitud no registrada (contratación no confirmada)">
      <bpmn:incoming>MAE_F326</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP04_GwEvento" name="¿El Evento está cancelado o ya inició?">
      <bpmn:documentation>SE-004, O-01: después de registrar la solicitud, primero se verifica el Evento; si está cancelado o ya inició, la solicitud queda No procedente y se registra solo este motivo (CA-099, CA-100).</bpmn:documentation>
      <bpmn:incoming>MAE_F187</bpmn:incoming>
      <bpmn:outgoing>MAE_F183</bpmn:outgoing>
      <bpmn:outgoing>MAE_F185</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP04_NoProcEv" name="Registrar la solicitud como no procedente (Evento cancelado o iniciado) e informar al Cliente">
      <bpmn:documentation>SE-004, O-01, CA-099, CA-100: primer motivo, Evento cancelado o Evento iniciado; el Coordinador informa al Cliente.</bpmn:documentation>
      <bpmn:incoming>MAE_F183</bpmn:incoming>
      <bpmn:outgoing>MAE_F184</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP04_FinNoProcEv" name="No procedente">
      <bpmn:incoming>MAE_F184</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="SP04_Registrar" name="Registrar la solicitud de servicio adicional con su fecha">
      <bpmn:documentation>BN-004, SE-004, O-01 (US-025): con la contratación confirmada (C-14, CA-101), la solicitud se registra antes de verificar el Evento, el plazo y el saldo.</bpmn:documentation>
      <bpmn:incoming>MAE_F324</bpmn:incoming>
      <bpmn:outgoing>MAE_F187</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="SP04_Tramitar" name="Tramitar la solicitud de servicio adicional (solicitud en trámite)">
      <bpmn:documentation>Mientras la solicitud está en trámite, las señales «Evento iniciado» y «Evento cancelado» la cierran.</bpmn:documentation>
      <bpmn:incoming>MAE_F185</bpmn:incoming>
      <bpmn:outgoing>MAE_F234</bpmn:outgoing>
      <bpmn:startEvent id="SP04_IniSub" name="Solicitud admitida">
        <bpmn:outgoing>MAE_F186</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP04_URet">
        <bpmn:incoming>MAE_F186</bpmn:incoming>
        <bpmn:incoming>MAE_F194</bpmn:incoming>
        <bpmn:outgoing>MAE_F188</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP04_Gw5" name="¿Faltan al menos 5 días naturales para el evento?">
        <bpmn:documentation>BN-004, SE-004, O-01: el plazo se verifica después del Evento y antes que el saldo; se registra solo el primer motivo.</bpmn:documentation>
        <bpmn:incoming>MAE_F188</bpmn:incoming>
        <bpmn:outgoing>MAE_F189</bpmn:outgoing>
        <bpmn:outgoing>MAE_F191</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_NoProc5" name="Registrar la solicitud como no procedente (menos de 5 días naturales) e informar al Cliente">
        <bpmn:documentation>CA-083, SE-004, O-01: primer motivo, menos de 5 días naturales; el Coordinador informa al Cliente.</bpmn:documentation>
        <bpmn:incoming>MAE_F189</bpmn:incoming>
        <bpmn:outgoing>MAE_F190</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinNoProc5" name="No procedente">
        <bpmn:incoming>MAE_F190</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP04_GwSaldo" name="¿Existe saldo vencido del contrato original?">
        <bpmn:documentation>SE-004, SE-006</bpmn:documentation>
        <bpmn:incoming>MAE_F191</bpmn:incoming>
        <bpmn:outgoing>MAE_F192</bpmn:outgoing>
        <bpmn:outgoing>MAE_F195</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_Detener" name="Detener la gestión e informar al Cliente que debe regularizar el saldo y los cargos moratorios">
        <bpmn:documentation>CA-072 (Detenida por saldo vencido)</bpmn:documentation>
        <bpmn:incoming>MAE_F192</bpmn:incoming>
        <bpmn:outgoing>MAE_F193</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="SP04_Regularizado" name="Saldo vencido regularizado">
        <bpmn:documentation>CA-072: se retoma si se cumplen los demás requisitos, incluido el plazo de 5 días.</bpmn:documentation>
        <bpmn:incoming>MAE_F193</bpmn:incoming>
        <bpmn:outgoing>MAE_F194</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP04_Regularizado_def" signalRef="Signal_SaldoRegularizado" />
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP04_Actuales" name="Consultar la disponibilidad de los proveedores que ya participan en el evento">
        <bpmn:documentation>CA-073, SE-004</bpmn:documentation>
        <bpmn:incoming>MAE_F195</bpmn:incoming>
        <bpmn:outgoing>MAE_F196</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwActual" name="¿Algún proveedor actual puede proporcionarlo?">
        <bpmn:incoming>MAE_F196</bpmn:incoming>
        <bpmn:outgoing>MAE_F197</bpmn:outgoing>
        <bpmn:outgoing>MAE_F198</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP04_UBusca">
        <bpmn:incoming>MAE_F198</bpmn:incoming>
        <bpmn:incoming>MAE_F207</bpmn:incoming>
        <bpmn:outgoing>MAE_F199</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_Buscar" name="Buscar un proveedor alternativo y verificar su disponibilidad">
        <bpmn:documentation>CA-074, CA-075</bpmn:documentation>
        <bpmn:incoming>MAE_F199</bpmn:incoming>
        <bpmn:outgoing>MAE_F200</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwAlt" name="¿Se encontró una alternativa disponible?">
        <bpmn:incoming>MAE_F200</bpmn:incoming>
        <bpmn:outgoing>MAE_F201</bpmn:outgoing>
        <bpmn:outgoing>MAE_F202</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_MasTiempo" name="Informar al Cliente que se necesita más tiempo y registrar si acepta esperar">
        <bpmn:documentation>CA-076</bpmn:documentation>
        <bpmn:incoming>MAE_F202</bpmn:incoming>
        <bpmn:outgoing>MAE_F203</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwEspera" name="¿El Cliente acepta esperar?">
        <bpmn:incoming>MAE_F203</bpmn:incoming>
        <bpmn:outgoing>MAE_F204</bpmn:outgoing>
        <bpmn:outgoing>MAE_F206</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_NoRealiza" name="Registrar que el servicio adicional no se realizará e informar al Cliente">
        <bpmn:documentation>CA-078</bpmn:documentation>
        <bpmn:incoming>MAE_F204</bpmn:incoming>
        <bpmn:outgoing>MAE_F205</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinNoRealiza" name="No se realizará">
        <bpmn:incoming>MAE_F205</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP04_Gw5b" name="¿Siguen faltando al menos 5 días naturales?">
        <bpmn:documentation>CA-077: esperar no amplía el plazo mínimo.</bpmn:documentation>
        <bpmn:incoming>MAE_F206</bpmn:incoming>
        <bpmn:outgoing>MAE_F207</bpmn:outgoing>
        <bpmn:outgoing>MAE_F208</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_NoProcBusq" name="Registrar como no procedente por quedar menos de 5 días sin alternativa e informar al Cliente">
        <bpmn:documentation>CA-077</bpmn:documentation>
        <bpmn:incoming>MAE_F208</bpmn:incoming>
        <bpmn:outgoing>MAE_F209</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinNoProcBusq" name="No procedente">
        <bpmn:incoming>MAE_F209</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP04_UAlt">
        <bpmn:incoming>MAE_F197</bpmn:incoming>
        <bpmn:incoming>MAE_F201</bpmn:incoming>
        <bpmn:outgoing>MAE_F210</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_Presentar" name="Presentar al Cliente el costo del proveedor y las condiciones, sin cargo de Eventos Nova, y registrar su decisión">
        <bpmn:documentation>BN-004; CA-073, CA-079</bpmn:documentation>
        <bpmn:incoming>MAE_F210</bpmn:incoming>
        <bpmn:outgoing>MAE_F211</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwCliente" name="¿El Cliente aprueba el servicio adicional?">
        <bpmn:incoming>MAE_F211</bpmn:incoming>
        <bpmn:outgoing>MAE_F212</bpmn:outgoing>
        <bpmn:outgoing>MAE_F214</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_NoAprob" name="Registrar el servicio adicional como no aprobado e informar al Cliente">
        <bpmn:documentation>CA-079</bpmn:documentation>
        <bpmn:incoming>MAE_F212</bpmn:incoming>
        <bpmn:outgoing>MAE_F213</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinNoAprob" name="No aprobada">
        <bpmn:incoming>MAE_F213</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP04_Autorizar" name="Revisar y autorizar o rechazar el servicio adicional">
        <bpmn:documentation>BN-004; CA-081 (US-022)</bpmn:documentation>
        <bpmn:incoming>MAE_F214</bpmn:incoming>
        <bpmn:outgoing>MAE_F215</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwAdmin" name="¿Administración autoriza?">
        <bpmn:incoming>MAE_F215</bpmn:incoming>
        <bpmn:outgoing>MAE_F216</bpmn:outgoing>
        <bpmn:outgoing>MAE_F218</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_NoAut" name="Registrar el servicio adicional como no autorizado e informar al Cliente">
        <bpmn:documentation>CA-081, SE-006: no se confirma ni se busca otra alternativa (la búsqueda continua es propia de la sustitución, CA-050).</bpmn:documentation>
        <bpmn:incoming>MAE_F216</bpmn:incoming>
        <bpmn:outgoing>MAE_F217</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinNoAut" name="No autorizada">
        <bpmn:incoming>MAE_F217</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP04_Anexo" name="Documentar el servicio, su costo y sus condiciones en un anexo vinculado al contrato original">
        <bpmn:documentation>CA-082</bpmn:documentation>
        <bpmn:incoming>MAE_F218</bpmn:incoming>
        <bpmn:outgoing>MAE_F219</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP04_SolPago" name="Comunicar la solicitud de pago del servicio adicional">
        <bpmn:documentation>CA-082: el plazo de 24 horas naturales comienza con esta comunicación; importe separado del saldo del contrato.</bpmn:documentation>
        <bpmn:incoming>MAE_F219</bpmn:incoming>
        <bpmn:outgoing>MAE_F220</bpmn:outgoing>
      </bpmn:task>
      <bpmn:eventBasedGateway id="SP04_EspPago">
        <bpmn:incoming>MAE_F220</bpmn:incoming>
        <bpmn:outgoing>MAE_F221</bpmn:outgoing>
        <bpmn:outgoing>MAE_F222</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SP04_Plazo" name="24 horas naturales: plazo del Cliente para pagar">
        <bpmn:documentation>BN-004, CA-080: plazo para que el Cliente efectúe el pago, no para registrarlo.</bpmn:documentation>
        <bpmn:incoming>MAE_F221</bpmn:incoming>
        <bpmn:outgoing>MAE_F223</bpmn:outgoing>
      <bpmn:timerEventDefinition id="SP04_Plazo_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP04_RevisarPago" name="Revisar los pagos y comprobar si el Cliente pagó dentro de las 24 horas">
        <bpmn:documentation>BN-004, CA-080: decide la fecha en que el Cliente pagó, no la del registro o la verificación.</bpmn:documentation>
        <bpmn:incoming>MAE_F223</bpmn:incoming>
        <bpmn:outgoing>MAE_F224</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_GwEnPlazo" name="¿El Cliente efectuó el pago dentro de las 24 horas?">
        <bpmn:incoming>MAE_F224</bpmn:incoming>
        <bpmn:outgoing>MAE_F225</bpmn:outgoing>
        <bpmn:outgoing>MAE_F227</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_FaltaPago" name="Cerrar la solicitud por falta de pago, registrar el motivo e informar al Cliente">
        <bpmn:documentation>BN-004, SE-006: el servicio no se confirma ni se realiza.</bpmn:documentation>
        <bpmn:incoming>MAE_F225</bpmn:incoming>
        <bpmn:outgoing>MAE_F226</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinFaltaPago" name="Cerrada por falta de pago">
        <bpmn:incoming>MAE_F226</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="SP04_PagoRecibido" name="Pago del Cliente recibido">
        <bpmn:incoming>MAE_F222</bpmn:incoming>
        <bpmn:outgoing>MAE_F228</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP04_PagoRecibido_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP04_UVer">
        <bpmn:incoming>MAE_F227</bpmn:incoming>
        <bpmn:incoming>MAE_F228</bpmn:incoming>
        <bpmn:outgoing>MAE_F229</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_VerificarPago" name="Registrar y verificar el pago, aunque sea después de las 24 horas">
        <bpmn:documentation>BN-004, CA-080: un pago efectuado a tiempo queda pendiente de verificación; no es falta de pago.</bpmn:documentation>
        <bpmn:incoming>MAE_F229</bpmn:incoming>
        <bpmn:outgoing>MAE_F230</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP04_Confirmar" name="Consultar el estado del pago y confirmar el servicio adicional">
        <bpmn:documentation>BN-004; CA-082</bpmn:documentation>
        <bpmn:incoming>MAE_F230</bpmn:incoming>
        <bpmn:outgoing>MAE_F231</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_FinConfirmada" name="Servicio adicional confirmado">
        <bpmn:incoming>MAE_F231</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="MAE_F186" sourceRef="SP04_IniSub" targetRef="SP04_URet" />
      <bpmn:sequenceFlow id="MAE_F188" sourceRef="SP04_URet" targetRef="SP04_Gw5" />
      <bpmn:sequenceFlow id="MAE_F189" name="No" sourceRef="SP04_Gw5" targetRef="SP04_NoProc5" />
      <bpmn:sequenceFlow id="MAE_F190" sourceRef="SP04_NoProc5" targetRef="SP04_FinNoProc5" />
      <bpmn:sequenceFlow id="MAE_F191" name="Sí" sourceRef="SP04_Gw5" targetRef="SP04_GwSaldo" />
      <bpmn:sequenceFlow id="MAE_F192" name="Sí" sourceRef="SP04_GwSaldo" targetRef="SP04_Detener" />
      <bpmn:sequenceFlow id="MAE_F193" sourceRef="SP04_Detener" targetRef="SP04_Regularizado" />
      <bpmn:sequenceFlow id="MAE_F194" sourceRef="SP04_Regularizado" targetRef="SP04_URet" />
      <bpmn:sequenceFlow id="MAE_F195" name="No" sourceRef="SP04_GwSaldo" targetRef="SP04_Actuales" />
      <bpmn:sequenceFlow id="MAE_F196" sourceRef="SP04_Actuales" targetRef="SP04_GwActual" />
      <bpmn:sequenceFlow id="MAE_F197" name="Sí" sourceRef="SP04_GwActual" targetRef="SP04_UAlt" />
      <bpmn:sequenceFlow id="MAE_F198" name="No" sourceRef="SP04_GwActual" targetRef="SP04_UBusca" />
      <bpmn:sequenceFlow id="MAE_F199" sourceRef="SP04_UBusca" targetRef="SP04_Buscar" />
      <bpmn:sequenceFlow id="MAE_F200" sourceRef="SP04_Buscar" targetRef="SP04_GwAlt" />
      <bpmn:sequenceFlow id="MAE_F201" name="Sí" sourceRef="SP04_GwAlt" targetRef="SP04_UAlt" />
      <bpmn:sequenceFlow id="MAE_F202" name="No" sourceRef="SP04_GwAlt" targetRef="SP04_MasTiempo" />
      <bpmn:sequenceFlow id="MAE_F203" sourceRef="SP04_MasTiempo" targetRef="SP04_GwEspera" />
      <bpmn:sequenceFlow id="MAE_F204" name="No" sourceRef="SP04_GwEspera" targetRef="SP04_NoRealiza" />
      <bpmn:sequenceFlow id="MAE_F205" sourceRef="SP04_NoRealiza" targetRef="SP04_FinNoRealiza" />
      <bpmn:sequenceFlow id="MAE_F206" name="Sí" sourceRef="SP04_GwEspera" targetRef="SP04_Gw5b" />
      <bpmn:sequenceFlow id="MAE_F207" name="Sí: continuar la búsqueda" sourceRef="SP04_Gw5b" targetRef="SP04_UBusca" />
      <bpmn:sequenceFlow id="MAE_F208" name="No" sourceRef="SP04_Gw5b" targetRef="SP04_NoProcBusq" />
      <bpmn:sequenceFlow id="MAE_F209" sourceRef="SP04_NoProcBusq" targetRef="SP04_FinNoProcBusq" />
      <bpmn:sequenceFlow id="MAE_F210" sourceRef="SP04_UAlt" targetRef="SP04_Presentar" />
      <bpmn:sequenceFlow id="MAE_F211" sourceRef="SP04_Presentar" targetRef="SP04_GwCliente" />
      <bpmn:sequenceFlow id="MAE_F212" name="No" sourceRef="SP04_GwCliente" targetRef="SP04_NoAprob" />
      <bpmn:sequenceFlow id="MAE_F213" sourceRef="SP04_NoAprob" targetRef="SP04_FinNoAprob" />
      <bpmn:sequenceFlow id="MAE_F214" name="Sí" sourceRef="SP04_GwCliente" targetRef="SP04_Autorizar" />
      <bpmn:sequenceFlow id="MAE_F215" sourceRef="SP04_Autorizar" targetRef="SP04_GwAdmin" />
      <bpmn:sequenceFlow id="MAE_F216" name="No" sourceRef="SP04_GwAdmin" targetRef="SP04_NoAut" />
      <bpmn:sequenceFlow id="MAE_F217" sourceRef="SP04_NoAut" targetRef="SP04_FinNoAut" />
      <bpmn:sequenceFlow id="MAE_F218" name="Sí" sourceRef="SP04_GwAdmin" targetRef="SP04_Anexo" />
      <bpmn:sequenceFlow id="MAE_F219" sourceRef="SP04_Anexo" targetRef="SP04_SolPago" />
      <bpmn:sequenceFlow id="MAE_F220" sourceRef="SP04_SolPago" targetRef="SP04_EspPago" />
      <bpmn:sequenceFlow id="MAE_F221" sourceRef="SP04_EspPago" targetRef="SP04_Plazo" />
      <bpmn:sequenceFlow id="MAE_F222" sourceRef="SP04_EspPago" targetRef="SP04_PagoRecibido" />
      <bpmn:sequenceFlow id="MAE_F223" sourceRef="SP04_Plazo" targetRef="SP04_RevisarPago" />
      <bpmn:sequenceFlow id="MAE_F224" sourceRef="SP04_RevisarPago" targetRef="SP04_GwEnPlazo" />
      <bpmn:sequenceFlow id="MAE_F225" name="No" sourceRef="SP04_GwEnPlazo" targetRef="SP04_FaltaPago" />
      <bpmn:sequenceFlow id="MAE_F226" sourceRef="SP04_FaltaPago" targetRef="SP04_FinFaltaPago" />
      <bpmn:sequenceFlow id="MAE_F227" name="Sí" sourceRef="SP04_GwEnPlazo" targetRef="SP04_UVer" />
      <bpmn:sequenceFlow id="MAE_F228" sourceRef="SP04_PagoRecibido" targetRef="SP04_UVer" />
      <bpmn:sequenceFlow id="MAE_F229" sourceRef="SP04_UVer" targetRef="SP04_VerificarPago" />
      <bpmn:sequenceFlow id="MAE_F230" sourceRef="SP04_VerificarPago" targetRef="SP04_Confirmar" />
      <bpmn:sequenceFlow id="MAE_F231" sourceRef="SP04_Confirmar" targetRef="SP04_FinConfirmada" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="SP04_BCancelado" name="Evento cancelado" attachedToRef="SP04_Tramitar">
      <bpmn:documentation>Caso A (BN-008): la solicitud sigue en trámite cuando se cancela el Evento.</bpmn:documentation>
      <bpmn:outgoing>MAE_F232</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP04_BCancelado_def" signalRef="Signal_EventoCancelado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP04_CerrarCan" name="Cerrar la solicitud con el motivo «Evento cancelado» (Cerrada por evento cancelado)">
      <bpmn:documentation>BN-008, SE-007, CA-087: no se confirma ni se realiza.</bpmn:documentation>
      <bpmn:incoming>MAE_F232</bpmn:incoming>
      <bpmn:outgoing>MAE_F243</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="SP04_BIniciado" name="Evento iniciado" attachedToRef="SP04_Tramitar">
      <bpmn:documentation>CA-071, CA-080: lo no confirmado antes del inicio se cierra.</bpmn:documentation>
      <bpmn:outgoing>MAE_F233</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP04_BIniciado_def" signalRef="Signal_EventoIniciado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP04_CerrarIni" name="Cerrar la solicitud como «Cerrada por inicio del evento»">
      <bpmn:documentation>CA-071, CA-080</bpmn:documentation>
      <bpmn:incoming>MAE_F233</bpmn:incoming>
      <bpmn:outgoing>MAE_F244</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="SP04_GwResultado" name="¿Cómo terminó el trámite?">
      <bpmn:incoming>MAE_F234</bpmn:incoming>
      <bpmn:outgoing>MAE_F235</bpmn:outgoing>
      <bpmn:outgoing>MAE_F236</bpmn:outgoing>
      <bpmn:outgoing>MAE_F245</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP04_FinSinCobros" name="Cerrada en el trámite, sin cobros pendientes">
      <bpmn:documentation>No procedente, rechazada por el Cliente o no autorizada: se conserva la última configuración confirmada.</bpmn:documentation>
      <bpmn:incoming>MAE_F235</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP04_GwCancel" name="¿El Evento fue cancelado antes de incorporar el servicio?">
      <bpmn:documentation>Se evalúa al aplicar la operación confirmada (BN-006, BN-008).</bpmn:documentation>
      <bpmn:incoming>MAE_F236</bpmn:incoming>
      <bpmn:outgoing>MAE_F237</bpmn:outgoing>
      <bpmn:outgoing>MAE_F240</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP04_NoAplicar" name="No incorporar el servicio en el Evento cancelado; la solicitud conserva su confirmación y su historial">
      <bpmn:documentation>Caso B (BN-008): no se modifica la configuración del Evento cancelado ni se cierra la solicitud.</bpmn:documentation>
      <bpmn:incoming>MAE_F237</bpmn:incoming>
      <bpmn:outgoing>MAE_F238</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP04_Revision" name="Registrar para revisión que la operación no pudo aplicarse por la cancelación (registro técnico en «Revisión»)">
      <bpmn:documentation>Caso B (BN-008): sin devoluciones, nuevas obligaciones ni cambios en el saldo; rige la política de no reembolso (SE-012). «Revisión» es el estado técnico del registro del Outbox, no un estado de negocio ni un trámite humano adicional.</bpmn:documentation>
      <bpmn:incoming>MAE_F238</bpmn:incoming>
      <bpmn:outgoing>MAE_F239</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP04_FinRevision" name="Confirmada, no aplicada: en revisión">
      <bpmn:incoming>MAE_F239</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="SP04_Aplicar" name="Incorporar el servicio a la configuración vigente, aunque el Evento ya haya iniciado (O-02)">
      <bpmn:documentation>Caso C (BN-006, O-02): el Evento sigue activo; si ya inició, se aplica porque se confirmó antes del inicio.</bpmn:documentation>
      <bpmn:incoming>MAE_F240</bpmn:incoming>
      <bpmn:outgoing>MAE_F241</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP04_Comunicar" name="Coordinar el servicio con el proveedor e informar a las personas involucradas">
      <bpmn:documentation>BN-006</bpmn:documentation>
      <bpmn:incoming>MAE_F241</bpmn:incoming>
      <bpmn:outgoing>MAE_F242</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP04_FinAplicada" name="Confirmada y aplicada al Evento">
      <bpmn:incoming>MAE_F242</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP04_UCierre">
      <bpmn:incoming>MAE_F243</bpmn:incoming>
      <bpmn:incoming>MAE_F244</bpmn:incoming>
      <bpmn:incoming>MAE_F245</bpmn:incoming>
      <bpmn:outgoing>MAE_F257</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP04_DevImp" name="Resolver los importes de la operación no realizada (SE-012)">
      <bpmn:documentation>SP-08 desplegado: cobros exclusivos sin efecto y devolución solo si el Evento no está cancelado (SE-012).</bpmn:documentation>
      <bpmn:incoming>MAE_F257</bpmn:incoming>
      <bpmn:outgoing>MAE_F258</bpmn:outgoing>
      <bpmn:startEvent id="SP04_SE_SP08_Inicio" name="Solicitud cerrada sin realizarse">
        <bpmn:outgoing>MAE_F246</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP04_SE_SP08_SinEfecto" name="Dejar sin efecto los importes pendientes de cobro exclusivos de la solicitud">
        <bpmn:documentation>SE-012, CA-097</bpmn:documentation>
        <bpmn:incoming>MAE_F246</bpmn:incoming>
        <bpmn:outgoing>MAE_F247</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP04_SE_SP08_GwCancelado" name="¿El Evento está cancelado?">
        <bpmn:incoming>MAE_F247</bpmn:incoming>
        <bpmn:outgoing>MAE_F248</bpmn:outgoing>
        <bpmn:outgoing>MAE_F250</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP04_SE_SP08_NoReembolso" name="Aplicar la política de no reembolso de la cancelación: sin devolución">
        <bpmn:documentation>SE-012, BN-008</bpmn:documentation>
        <bpmn:incoming>MAE_F248</bpmn:incoming>
        <bpmn:outgoing>MAE_F249</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_SE_SP08_FinNoReembolso" name="Sin devolución (Evento cancelado)">
        <bpmn:incoming>MAE_F249</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP04_SE_SP08_GwRecibido" name="¿Se recibieron importes exclusivos de la operación no realizada?">
        <bpmn:incoming>MAE_F250</bpmn:incoming>
        <bpmn:outgoing>MAE_F251</bpmn:outgoing>
        <bpmn:outgoing>MAE_F252</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SP04_SE_SP08_FinSinImporte" name="Sin importes por devolver">
        <bpmn:incoming>MAE_F251</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP04_SE_SP08_VerificarImp" name="Verificar el importe a devolver (en una sustitución, solo el importe adicional atribuible al reemplazo)">
        <bpmn:documentation>SE-001, SE-012, CA-097</bpmn:documentation>
        <bpmn:incoming>MAE_F252</bpmn:incoming>
        <bpmn:outgoing>MAE_F253</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP04_SE_SP08_Devolver" name="Efectuar la devolución en 5 días hábiles desde el cierre (o desde el registro del pago, si es posterior)">
        <bpmn:documentation>SE-012, CA-097, CA-098</bpmn:documentation>
        <bpmn:incoming>MAE_F253</bpmn:incoming>
        <bpmn:outgoing>MAE_F254</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP04_SE_SP08_Registrar" name="Registrar concepto, solicitud, importe, motivo, fecha y comprobante, e informar al Coordinador">
        <bpmn:documentation>CA-098 (US-031)</bpmn:documentation>
        <bpmn:incoming>MAE_F254</bpmn:incoming>
        <bpmn:outgoing>MAE_F255</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP04_SE_SP08_Comunicar" name="Comunicar el resultado al Cliente">
        <bpmn:documentation>CA-098</bpmn:documentation>
        <bpmn:incoming>MAE_F255</bpmn:incoming>
        <bpmn:outgoing>MAE_F256</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP04_SE_SP08_FinDevuelto" name="Devolución efectuada">
        <bpmn:incoming>MAE_F256</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="MAE_F246" sourceRef="SP04_SE_SP08_Inicio" targetRef="SP04_SE_SP08_SinEfecto" />
      <bpmn:sequenceFlow id="MAE_F247" sourceRef="SP04_SE_SP08_SinEfecto" targetRef="SP04_SE_SP08_GwCancelado" />
      <bpmn:sequenceFlow id="MAE_F248" name="Sí" sourceRef="SP04_SE_SP08_GwCancelado" targetRef="SP04_SE_SP08_NoReembolso" />
      <bpmn:sequenceFlow id="MAE_F249" sourceRef="SP04_SE_SP08_NoReembolso" targetRef="SP04_SE_SP08_FinNoReembolso" />
      <bpmn:sequenceFlow id="MAE_F250" name="No" sourceRef="SP04_SE_SP08_GwCancelado" targetRef="SP04_SE_SP08_GwRecibido" />
      <bpmn:sequenceFlow id="MAE_F251" name="No" sourceRef="SP04_SE_SP08_GwRecibido" targetRef="SP04_SE_SP08_FinSinImporte" />
      <bpmn:sequenceFlow id="MAE_F252" name="Sí" sourceRef="SP04_SE_SP08_GwRecibido" targetRef="SP04_SE_SP08_VerificarImp" />
      <bpmn:sequenceFlow id="MAE_F253" sourceRef="SP04_SE_SP08_VerificarImp" targetRef="SP04_SE_SP08_Devolver" />
      <bpmn:sequenceFlow id="MAE_F254" sourceRef="SP04_SE_SP08_Devolver" targetRef="SP04_SE_SP08_Registrar" />
      <bpmn:sequenceFlow id="MAE_F255" sourceRef="SP04_SE_SP08_Registrar" targetRef="SP04_SE_SP08_Comunicar" />
      <bpmn:sequenceFlow id="MAE_F256" sourceRef="SP04_SE_SP08_Comunicar" targetRef="SP04_SE_SP08_FinDevuelto" />
    </bpmn:subProcess>
    <bpmn:endEvent id="SP04_FinImportes" name="Solicitud cerrada sin realizarse: importes resueltos">
      <bpmn:incoming>MAE_F258</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="SP05_Inicio" name="Aviso del proveedor: no disponible o cancela el servicio">
      <bpmn:documentation>CA-036, GL-038</bpmn:documentation>
      <bpmn:outgoing>MAE_F259</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP05_Inicio_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="SP05_GwEstado" name="¿En qué estado está el Evento?">
      <bpmn:documentation>Comprobación del estado actual al recibir el aviso, antes de buscar alternativas (BN-006, BN-008, SE-007, CA-096).</bpmn:documentation>
      <bpmn:incoming>MAE_F259</bpmn:incoming>
      <bpmn:outgoing>MAE_F260</bpmn:outgoing>
      <bpmn:outgoing>MAE_F262</bpmn:outgoing>
      <bpmn:outgoing>MAE_F263</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP05_NoInicioCanc" name="No iniciar la sustitución: con el Evento cancelado no se confirman operaciones">
      <bpmn:documentation>BN-008, SE-007: ninguna solicitud se confirma con el Evento cancelado.</bpmn:documentation>
      <bpmn:incoming>MAE_F260</bpmn:incoming>
      <bpmn:outgoing>MAE_F261</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP05_FinNoCanc" name="Sin sustitución (Evento cancelado)">
      <bpmn:incoming>MAE_F261</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SP05_FinNoEjec" name="Fuera del alcance del sistema">
      <bpmn:documentation>Decisión del equipo: el aviso del proveedor recibido después del inicio del evento está fuera del alcance del sistema.</bpmn:documentation>
      <bpmn:incoming>MAE_F262</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SP05_Tramitar" name="Tramitar la sustitución de proveedor (sustitución en trámite)">
      <bpmn:documentation>El proveedor original sigue vigente hasta que se confirme el reemplazo (GL-036).</bpmn:documentation>
      <bpmn:incoming>MAE_F263</bpmn:incoming>
      <bpmn:outgoing>MAE_F298</bpmn:outgoing>
      <bpmn:startEvent id="SP05_IniSub" name="Aviso recibido">
        <bpmn:outgoing>MAE_F264</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP05_Registrar" name="Registrar la falta de disponibilidad o la cancelación del proveedor">
        <bpmn:documentation>CA-046 (US-021)</bpmn:documentation>
        <bpmn:incoming>MAE_F264</bpmn:incoming>
        <bpmn:outgoing>MAE_F265</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_UBusca">
        <bpmn:incoming>MAE_F265</bpmn:incoming>
        <bpmn:incoming>MAE_F270</bpmn:incoming>
        <bpmn:outgoing>MAE_F266</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Buscar" name="Buscar un proveedor alternativo y consultar su disponibilidad">
        <bpmn:documentation>CA-030, CA-047</bpmn:documentation>
        <bpmn:incoming>MAE_F266</bpmn:incoming>
        <bpmn:outgoing>MAE_F267</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_GwAlt" name="¿Hay una alternativa disponible?">
        <bpmn:incoming>MAE_F267</bpmn:incoming>
        <bpmn:outgoing>MAE_F268</bpmn:outgoing>
        <bpmn:outgoing>MAE_F271</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_SinAlt" name="Informar al Cliente y mantener pendiente la sustitución">
        <bpmn:documentation>CA-048</bpmn:documentation>
        <bpmn:incoming>MAE_F268</bpmn:incoming>
        <bpmn:outgoing>MAE_F269</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_UPend">
        <bpmn:incoming>MAE_F269</bpmn:incoming>
        <bpmn:incoming>MAE_F278</bpmn:incoming>
        <bpmn:outgoing>MAE_F270</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Impacto" name="Evaluar el impacto de la alternativa en los servicios, los costos y las condiciones">
        <bpmn:documentation>GL-029, GL-039; CA-049, CA-053</bpmn:documentation>
        <bpmn:incoming>MAE_F271</bpmn:incoming>
        <bpmn:outgoing>MAE_F272</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_GwModifica" name="¿Modifica los servicios, los costos o las condiciones acordadas?">
        <bpmn:incoming>MAE_F272</bpmn:incoming>
        <bpmn:outgoing>MAE_F273</bpmn:outgoing>
        <bpmn:outgoing>MAE_F274</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Presentar" name="Presentar la alternativa al Cliente y registrar su decisión">
        <bpmn:documentation>SE-001; CA-049, CA-054</bpmn:documentation>
        <bpmn:incoming>MAE_F274</bpmn:incoming>
        <bpmn:outgoing>MAE_F275</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_GwCliente" name="¿El Cliente aprueba la alternativa?">
        <bpmn:incoming>MAE_F275</bpmn:incoming>
        <bpmn:outgoing>MAE_F276</bpmn:outgoing>
        <bpmn:outgoing>MAE_F279</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_RechCliente" name="Registrar el rechazo, no confirmar el reemplazo y mantener pendiente la sustitución">
        <bpmn:documentation>CA-054</bpmn:documentation>
        <bpmn:incoming>MAE_F276</bpmn:incoming>
        <bpmn:outgoing>MAE_F277</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_UPend2">
        <bpmn:incoming>MAE_F277</bpmn:incoming>
        <bpmn:incoming>MAE_F282</bpmn:incoming>
        <bpmn:outgoing>MAE_F278</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Autorizar" name="Autorizar o rechazar la sustitución">
        <bpmn:documentation>SE-001; CA-049, CA-050</bpmn:documentation>
        <bpmn:incoming>MAE_F279</bpmn:incoming>
        <bpmn:outgoing>MAE_F280</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_GwAdmin" name="¿Administración autoriza?">
        <bpmn:incoming>MAE_F280</bpmn:incoming>
        <bpmn:outgoing>MAE_F281</bpmn:outgoing>
        <bpmn:outgoing>MAE_F283</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_NoAut" name="Registrar que el reemplazo no fue autorizado, informar al Cliente y mantener pendiente la sustitución">
        <bpmn:documentation>CA-050: se continúa buscando otra alternativa.</bpmn:documentation>
        <bpmn:incoming>MAE_F281</bpmn:incoming>
        <bpmn:outgoing>MAE_F282</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_UAprob">
        <bpmn:incoming>MAE_F273</bpmn:incoming>
        <bpmn:incoming>MAE_F283</bpmn:incoming>
        <bpmn:outgoing>MAE_F284</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Anexo" name="Documentar la sustitución en un anexo vinculado al contrato original">
        <bpmn:documentation>SE-001; CA-051, CA-053: proveedor sustituto, servicio, costos y condiciones cuando correspondan.</bpmn:documentation>
        <bpmn:incoming>MAE_F284</bpmn:incoming>
        <bpmn:outgoing>MAE_F285</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_GwCosto" name="¿Genera un costo adicional?">
        <bpmn:incoming>MAE_F285</bpmn:incoming>
        <bpmn:outgoing>MAE_F286</bpmn:outgoing>
        <bpmn:outgoing>MAE_F287</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP05_GwLimite" name="¿Se aprobó después del límite de 3 días hábiles antes del evento?">
        <bpmn:documentation>SE-001, CA-052</bpmn:documentation>
        <bpmn:incoming>MAE_F287</bpmn:incoming>
        <bpmn:outgoing>MAE_F288</bpmn:outgoing>
        <bpmn:outgoing>MAE_F290</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_AlSaldo" name="Incorporar el costo adicional al saldo pendiente del contrato original, que vence 3 días hábiles antes del evento">
        <bpmn:documentation>BN-005, CA-052</bpmn:documentation>
        <bpmn:incoming>MAE_F288</bpmn:incoming>
        <bpmn:outgoing>MAE_F289</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP05_PagoAntes" name="Incorporar el costo al saldo y solicitar su pago antes de confirmar el reemplazo">
        <bpmn:documentation>SE-001, CA-052: no se considera vencido; no hay otro plazo fijo.</bpmn:documentation>
        <bpmn:incoming>MAE_F290</bpmn:incoming>
        <bpmn:outgoing>MAE_F291</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="SP05_PagoRecibido" name="Pago del Cliente recibido">
        <bpmn:incoming>MAE_F291</bpmn:incoming>
        <bpmn:outgoing>MAE_F292</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP05_PagoRecibido_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP05_VerificarPago" name="Registrar y verificar el pago">
        <bpmn:documentation>CA-052</bpmn:documentation>
        <bpmn:incoming>MAE_F292</bpmn:incoming>
        <bpmn:outgoing>MAE_F293</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_UConf">
        <bpmn:incoming>MAE_F286</bpmn:incoming>
        <bpmn:incoming>MAE_F289</bpmn:incoming>
        <bpmn:incoming>MAE_F293</bpmn:incoming>
        <bpmn:outgoing>MAE_F294</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Confirmar" name="Confirmar el reemplazo">
        <bpmn:documentation>SE-001; CA-051, CA-052</bpmn:documentation>
        <bpmn:incoming>MAE_F294</bpmn:incoming>
        <bpmn:outgoing>MAE_F295</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP05_FinConfirmada" name="Sustitución confirmada">
        <bpmn:incoming>MAE_F295</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="MAE_F264" sourceRef="SP05_IniSub" targetRef="SP05_Registrar" />
      <bpmn:sequenceFlow id="MAE_F265" sourceRef="SP05_Registrar" targetRef="SP05_UBusca" />
      <bpmn:sequenceFlow id="MAE_F266" sourceRef="SP05_UBusca" targetRef="SP05_Buscar" />
      <bpmn:sequenceFlow id="MAE_F267" sourceRef="SP05_Buscar" targetRef="SP05_GwAlt" />
      <bpmn:sequenceFlow id="MAE_F268" name="No" sourceRef="SP05_GwAlt" targetRef="SP05_SinAlt" />
      <bpmn:sequenceFlow id="MAE_F269" sourceRef="SP05_SinAlt" targetRef="SP05_UPend" />
      <bpmn:sequenceFlow id="MAE_F270" sourceRef="SP05_UPend" targetRef="SP05_UBusca" />
      <bpmn:sequenceFlow id="MAE_F271" name="Sí" sourceRef="SP05_GwAlt" targetRef="SP05_Impacto" />
      <bpmn:sequenceFlow id="MAE_F272" sourceRef="SP05_Impacto" targetRef="SP05_GwModifica" />
      <bpmn:sequenceFlow id="MAE_F273" name="No" sourceRef="SP05_GwModifica" targetRef="SP05_UAprob" />
      <bpmn:sequenceFlow id="MAE_F274" name="Sí" sourceRef="SP05_GwModifica" targetRef="SP05_Presentar" />
      <bpmn:sequenceFlow id="MAE_F275" sourceRef="SP05_Presentar" targetRef="SP05_GwCliente" />
      <bpmn:sequenceFlow id="MAE_F276" name="No" sourceRef="SP05_GwCliente" targetRef="SP05_RechCliente" />
      <bpmn:sequenceFlow id="MAE_F277" sourceRef="SP05_RechCliente" targetRef="SP05_UPend2" />
      <bpmn:sequenceFlow id="MAE_F278" name="Continuar la búsqueda" sourceRef="SP05_UPend2" targetRef="SP05_UPend" />
      <bpmn:sequenceFlow id="MAE_F279" name="Sí" sourceRef="SP05_GwCliente" targetRef="SP05_Autorizar" />
      <bpmn:sequenceFlow id="MAE_F280" sourceRef="SP05_Autorizar" targetRef="SP05_GwAdmin" />
      <bpmn:sequenceFlow id="MAE_F281" name="No" sourceRef="SP05_GwAdmin" targetRef="SP05_NoAut" />
      <bpmn:sequenceFlow id="MAE_F282" sourceRef="SP05_NoAut" targetRef="SP05_UPend2" />
      <bpmn:sequenceFlow id="MAE_F283" name="Sí" sourceRef="SP05_GwAdmin" targetRef="SP05_UAprob" />
      <bpmn:sequenceFlow id="MAE_F284" sourceRef="SP05_UAprob" targetRef="SP05_Anexo" />
      <bpmn:sequenceFlow id="MAE_F285" sourceRef="SP05_Anexo" targetRef="SP05_GwCosto" />
      <bpmn:sequenceFlow id="MAE_F286" name="No" sourceRef="SP05_GwCosto" targetRef="SP05_UConf" />
      <bpmn:sequenceFlow id="MAE_F287" name="Sí" sourceRef="SP05_GwCosto" targetRef="SP05_GwLimite" />
      <bpmn:sequenceFlow id="MAE_F288" name="No" sourceRef="SP05_GwLimite" targetRef="SP05_AlSaldo" />
      <bpmn:sequenceFlow id="MAE_F289" sourceRef="SP05_AlSaldo" targetRef="SP05_UConf" />
      <bpmn:sequenceFlow id="MAE_F290" name="Sí" sourceRef="SP05_GwLimite" targetRef="SP05_PagoAntes" />
      <bpmn:sequenceFlow id="MAE_F291" sourceRef="SP05_PagoAntes" targetRef="SP05_PagoRecibido" />
      <bpmn:sequenceFlow id="MAE_F292" sourceRef="SP05_PagoRecibido" targetRef="SP05_VerificarPago" />
      <bpmn:sequenceFlow id="MAE_F293" sourceRef="SP05_VerificarPago" targetRef="SP05_UConf" />
      <bpmn:sequenceFlow id="MAE_F294" sourceRef="SP05_UConf" targetRef="SP05_Confirmar" />
      <bpmn:sequenceFlow id="MAE_F295" sourceRef="SP05_Confirmar" targetRef="SP05_FinConfirmada" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="SP05_BCancelado" name="Evento cancelado" attachedToRef="SP05_Tramitar">
      <bpmn:documentation>Caso A (BN-008): la solicitud sigue en trámite cuando se cancela el Evento.</bpmn:documentation>
      <bpmn:outgoing>MAE_F296</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP05_BCancelado_def" signalRef="Signal_EventoCancelado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP05_CerrarCan" name="Cerrar la sustitución con el motivo «Evento cancelado» (Cerrada por evento cancelado)">
      <bpmn:documentation>BN-008, SE-007, CA-087: no se confirma ni se realiza.</bpmn:documentation>
      <bpmn:incoming>MAE_F296</bpmn:incoming>
      <bpmn:outgoing>MAE_F305</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="SP05_BIniciado" name="Evento iniciado" attachedToRef="SP05_Tramitar">
      <bpmn:documentation>CA-096: se registra que el reemplazo no se concretó: lo no confirmado antes del inicio se cierra.</bpmn:documentation>
      <bpmn:outgoing>MAE_F297</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP05_BIniciado_def" signalRef="Signal_EventoIniciado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP05_CerrarIni" name="Cerrar la sustitución como «Cerrada por inicio del evento»">
      <bpmn:documentation>CA-096: se registra que el reemplazo no se concretó</bpmn:documentation>
      <bpmn:incoming>MAE_F297</bpmn:incoming>
      <bpmn:outgoing>MAE_F306</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="SP05_GwCancel" name="¿El Evento fue cancelado antes de reasignar el proveedor?">
      <bpmn:documentation>Se evalúa al aplicar la operación confirmada (BN-006, BN-008).</bpmn:documentation>
      <bpmn:incoming>MAE_F298</bpmn:incoming>
      <bpmn:outgoing>MAE_F299</bpmn:outgoing>
      <bpmn:outgoing>MAE_F302</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP05_NoAplicar" name="No reasignar el proveedor en el Evento cancelado; la solicitud conserva su confirmación y su historial">
      <bpmn:documentation>Caso B (BN-008): no se modifica la configuración del Evento cancelado ni se cierra la solicitud.</bpmn:documentation>
      <bpmn:incoming>MAE_F299</bpmn:incoming>
      <bpmn:outgoing>MAE_F300</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP05_Revision" name="Registrar para revisión que la operación no pudo aplicarse por la cancelación (registro técnico en «Revisión»)">
      <bpmn:documentation>Caso B (BN-008): sin devoluciones, nuevas obligaciones ni cambios en el saldo; rige la política de no reembolso (SE-012). «Revisión» es el estado técnico del registro del Outbox, no un estado de negocio ni un trámite humano adicional.</bpmn:documentation>
      <bpmn:incoming>MAE_F300</bpmn:incoming>
      <bpmn:outgoing>MAE_F301</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP05_FinRevision" name="Confirmada, no aplicada: en revisión">
      <bpmn:incoming>MAE_F301</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="SP05_Aplicar" name="Reasignar el proveedor del servicio, aunque el Evento ya haya iniciado (O-02)">
      <bpmn:documentation>Caso C (BN-006, O-02): el Evento sigue activo; si ya inició, se aplica porque se confirmó antes del inicio.</bpmn:documentation>
      <bpmn:incoming>MAE_F302</bpmn:incoming>
      <bpmn:outgoing>MAE_F303</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP05_Comunicar" name="Comunicar la sustitución al proveedor y a las personas involucradas">
      <bpmn:documentation>BN-006</bpmn:documentation>
      <bpmn:incoming>MAE_F303</bpmn:incoming>
      <bpmn:outgoing>MAE_F304</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP05_FinAplicada" name="Confirmada y aplicada al Evento">
      <bpmn:incoming>MAE_F304</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP05_UCierre">
      <bpmn:incoming>MAE_F305</bpmn:incoming>
      <bpmn:incoming>MAE_F306</bpmn:incoming>
      <bpmn:outgoing>MAE_F318</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP05_DevImp" name="Resolver los importes de la operación no realizada (SE-012)">
      <bpmn:documentation>SP-08 desplegado: cobros exclusivos sin efecto y devolución solo si el Evento no está cancelado (SE-012).</bpmn:documentation>
      <bpmn:incoming>MAE_F318</bpmn:incoming>
      <bpmn:outgoing>MAE_F319</bpmn:outgoing>
      <bpmn:startEvent id="SP05_SE_SP08_Inicio" name="Solicitud cerrada sin realizarse">
        <bpmn:outgoing>MAE_F307</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP05_SE_SP08_SinEfecto" name="Dejar sin efecto los importes pendientes de cobro exclusivos de la solicitud">
        <bpmn:documentation>SE-012, CA-097</bpmn:documentation>
        <bpmn:incoming>MAE_F307</bpmn:incoming>
        <bpmn:outgoing>MAE_F308</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_SE_SP08_GwCancelado" name="¿El Evento está cancelado?">
        <bpmn:incoming>MAE_F308</bpmn:incoming>
        <bpmn:outgoing>MAE_F309</bpmn:outgoing>
        <bpmn:outgoing>MAE_F311</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_SE_SP08_NoReembolso" name="Aplicar la política de no reembolso de la cancelación: sin devolución">
        <bpmn:documentation>SE-012, BN-008</bpmn:documentation>
        <bpmn:incoming>MAE_F309</bpmn:incoming>
        <bpmn:outgoing>MAE_F310</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP05_SE_SP08_FinNoReembolso" name="Sin devolución (Evento cancelado)">
        <bpmn:incoming>MAE_F310</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP05_SE_SP08_GwRecibido" name="¿Se recibieron importes exclusivos de la operación no realizada?">
        <bpmn:incoming>MAE_F311</bpmn:incoming>
        <bpmn:outgoing>MAE_F312</bpmn:outgoing>
        <bpmn:outgoing>MAE_F313</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SP05_SE_SP08_FinSinImporte" name="Sin importes por devolver">
        <bpmn:incoming>MAE_F312</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="SP05_SE_SP08_VerificarImp" name="Verificar el importe a devolver (en una sustitución, solo el importe adicional atribuible al reemplazo)">
        <bpmn:documentation>SE-001, SE-012, CA-097</bpmn:documentation>
        <bpmn:incoming>MAE_F313</bpmn:incoming>
        <bpmn:outgoing>MAE_F314</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP05_SE_SP08_Devolver" name="Efectuar la devolución en 5 días hábiles desde el cierre (o desde el registro del pago, si es posterior)">
        <bpmn:documentation>SE-012, CA-097, CA-098</bpmn:documentation>
        <bpmn:incoming>MAE_F314</bpmn:incoming>
        <bpmn:outgoing>MAE_F315</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP05_SE_SP08_Registrar" name="Registrar concepto, solicitud, importe, motivo, fecha y comprobante, e informar al Coordinador">
        <bpmn:documentation>CA-098 (US-031)</bpmn:documentation>
        <bpmn:incoming>MAE_F315</bpmn:incoming>
        <bpmn:outgoing>MAE_F316</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP05_SE_SP08_Comunicar" name="Comunicar el resultado al Cliente">
        <bpmn:documentation>CA-098</bpmn:documentation>
        <bpmn:incoming>MAE_F316</bpmn:incoming>
        <bpmn:outgoing>MAE_F317</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP05_SE_SP08_FinDevuelto" name="Devolución efectuada">
        <bpmn:incoming>MAE_F317</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="MAE_F307" sourceRef="SP05_SE_SP08_Inicio" targetRef="SP05_SE_SP08_SinEfecto" />
      <bpmn:sequenceFlow id="MAE_F308" sourceRef="SP05_SE_SP08_SinEfecto" targetRef="SP05_SE_SP08_GwCancelado" />
      <bpmn:sequenceFlow id="MAE_F309" name="Sí" sourceRef="SP05_SE_SP08_GwCancelado" targetRef="SP05_SE_SP08_NoReembolso" />
      <bpmn:sequenceFlow id="MAE_F310" sourceRef="SP05_SE_SP08_NoReembolso" targetRef="SP05_SE_SP08_FinNoReembolso" />
      <bpmn:sequenceFlow id="MAE_F311" name="No" sourceRef="SP05_SE_SP08_GwCancelado" targetRef="SP05_SE_SP08_GwRecibido" />
      <bpmn:sequenceFlow id="MAE_F312" name="No" sourceRef="SP05_SE_SP08_GwRecibido" targetRef="SP05_SE_SP08_FinSinImporte" />
      <bpmn:sequenceFlow id="MAE_F313" name="Sí" sourceRef="SP05_SE_SP08_GwRecibido" targetRef="SP05_SE_SP08_VerificarImp" />
