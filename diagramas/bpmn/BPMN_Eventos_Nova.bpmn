    <bpmn:messageFlow id="MAE_M48" name="Pago" sourceRef="Part_MAE_Cliente" targetRef="SP04_PagoRecibido" />
    <bpmn:messageFlow id="MAE_M49" name="Servicio confirmado" sourceRef="SP04_Comunicar" targetRef="Part_MAE_Proveedor" />
    <bpmn:messageFlow id="MAE_M50" name="Devolución" sourceRef="SP05_SE_SP08_Devolver" targetRef="Part_MAE_Cliente" />
    <bpmn:messageFlow id="MAE_M51" name="Resultado de la devolución" sourceRef="SP05_SE_SP08_Comunicar" targetRef="Part_MAE_Cliente" />
    <bpmn:messageFlow id="MAE_M52" name="No disponible o cancela" sourceRef="Part_MAE_Proveedor" targetRef="SP05_Inicio" />
