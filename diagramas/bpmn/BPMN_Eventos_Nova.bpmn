    <bpmn:association id="SP06_NotaSust_A" associationDirection="None" sourceRef="SP06_Controlar" targetRef="SP06_NotaSust" />
    <bpmn:association id="SP07_NotaSaldo_A" associationDirection="None" sourceRef="SP07_Resultado" targetRef="SP07_NotaSaldo" />
