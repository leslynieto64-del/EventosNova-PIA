<mxfile host="Eventos Nova" type="device" version="24.7.17"><diagram id="BPMN_Eventos_Nova_SP05_Sustitucion_de_proveedor" name="SP-05"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="6158" pageHeight="1355" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value="SP-05 · Sustitución de proveedor" style="text;html=1;fontFamily=Arial;fontSize=30;fontColor=#22242a;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28.0" y="14.0" width="547.6" height="39.0" as="geometry"></mxGeometry></mxCell><mxCell id="x2" value="Proveedor no disponible o que cancela: búsqueda de alternativa, impacto, aprobación del Cliente, autorización de Administración, búsqueda continua si se rechaza, anexo, costo adicional en el saldo del contrato y cierre por inicio o cancelación del Evento. Al recibir el aviso se comprueba el estado actual del Evento (BN-004, BN-005, BN-006, BN-008, SE-001, SE-007, SE-012; US-016, US-021; CA-036, CA-046 a CA-054, CA-096)." style="text;html=1;fontFamily=Arial;fontSize=15;fontColor=#444444;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="54.0" width="3563.2" height="19.5" as="geometry"></mxGeometry></mxCell><mxCell id="x3" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#D4E7FA;strokeColor=#1E5A9C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="28.0" y="95.0" width="34.0" height="22.0" as="geometry"></mxGeometry></mxCell><mxCell id="x4" value="Cliente (pool externo)" style="text;html=1;fontFamily=Arial;fontSize=15;fontColor=#263238;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="70.0" y="97.0" width="194.8" height="19.5" as="geometry"></mxGeometry></mxCell><mxCell id="x5" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;fillCo