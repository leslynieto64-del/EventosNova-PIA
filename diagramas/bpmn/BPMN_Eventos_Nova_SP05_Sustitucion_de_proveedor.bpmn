<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_SP05" targetNamespace="https://eventosnova.example/bpmn" exporter="Eventos Nova (generador del equipo)" exporterVersion="1.0">
  <bpmn:signal id="Signal_EventoIniciado" name="Evento iniciado" />
  <bpmn:signal id="Signal_EventoCancelado" name="Evento cancelado" />
  <bpmn:collaboration id="Collab_SP05">
    <bpmn:documentation>Proveedor no disponible o que cancela: búsqueda de alternativa, impacto, aprobación del Cliente, autorización de Administración, búsqueda continua si se rechaza, anexo, costo adicional en el saldo del contrato y cierre por inicio o cancelación del Evento. Al recibir el aviso se comprueba el estado actual del Evento (BN-004, BN-005, BN-006, BN-008, SE-001, SE-007, SE-012; US-016, US-021; CA-036, CA-046 a CA-054, CA-096).</bpmn:documentation>
    <bpmn:participant id="Part_SP05_Cliente" name="Cliente" />
    <bpmn:participant id="Part_SP05_Proveedor" name="Proveedor" />
    <bpmn:participant id="Part_SP05_EN" name="Eventos Nova" processRef="Proc_SP05_Sustitucion" />
    <bpmn:messageFlow id="SP05_M01" name="No disponible o cancela" sourceRef="Part_SP05_Proveedor" targetRef="SP05_Inicio" />
    <bpmn:messageFlow id="SP05_M02" name="Consulta de disponibilidad" sourceRef="SP05_Buscar" targetRef="Part_SP05_Proveedor" />
    <bpmn:messageFlow id="SP05_M03" name="Disponibilidad, costo y condiciones" sourceRef="Part_SP05_Proveedor" targetRef="SP05_Buscar" />
    <bpmn:messageFlow id="SP05_M04" name="Aviso: sustitución pendiente" sourceRef="SP05_SinAlt" targetRef="Part_SP05_Cliente" />
    <bpmn:messageFlow id="SP05_M05" name="Alternativa propuesta" sourceRef="SP05_Presentar" targetRef="Part_SP05_Cliente" />
    <bpmn:messageFlow id="SP05_M06" name="Aprobación o rechazo" sourceRef="Part_SP05_Cliente" targetRef="SP05_Presentar" />
    <bpmn:messageFlow id="SP05_M07" name="Solicitud de pago" sourceRef="SP05_PagoAntes" targetRef="Part_SP05_Cliente" />
    <bpmn:messageFlow id="SP05_M08" name="Pago" sourceRef="Part_SP05_Cliente" targetRef="SP05_PagoRecibido" />
    <bpmn:messageFlow id="SP05_M09" name="Sustitución confirmada" sourceRef="SP05_Comunicar" targetRef="Part_SP05_Proveedor" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_SP05_Sustitucion" name="Sustitución de proveedor" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SP05">
      <bpmn:lane id="Lane_SP05_Coord" name="Coordinador">
        <bpmn:flowNodeRef>SP05_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_GwEstado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_NoInicioCanc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_FinNoCanc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_FinNoEjec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_Tramitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_IniSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_UBusca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_Buscar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_GwAlt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_SinAlt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_UPend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_Impacto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_GwModifica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_Presentar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_GwCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_RechCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_UPend2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_NoAut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_UAprob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_Anexo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_GwCosto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_GwLimite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_AlSaldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_PagoAntes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_PagoRecibido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_UConf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_FinConfirmada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_CerrarCan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_CerrarIni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_GwCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_NoAplicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_Revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_FinRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_Aplicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_Comunicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_FinAplicada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_UCierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_DevImp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_FinImportes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SP05_Admin" name="Administración">
        <bpmn:flowNodeRef>SP05_Autorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_GwAdmin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05_VerificarPago</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SP05_Inicio" name="Aviso del proveedor: no disponible o cancela el servicio">
      <bpmn:documentation>CA-036, GL-038</bpmn:documentation>
      <bpmn:outgoing>SP05_F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP05_Inicio_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="SP05_GwEstado" name="¿En qué estado está el Evento?">
      <bpmn:documentation>Comprobación del estado actual al recibir el aviso, antes de buscar alternativas (BN-006, BN-008, SE-007, CA-096).</bpmn:documentation>
      <bpmn:incoming>SP05_F01</bpmn:incoming>
      <bpmn:outgoing>SP05_F02</bpmn:outgoing>
      <bpmn:outgoing>SP05_F04</bpmn:outgoing>
      <bpmn:outgoing>SP05_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP05_NoInicioCanc" name="No iniciar la sustitución: con el Evento cancelado no se confirman operaciones">
      <bpmn:documentation>BN-008, SE-007: ninguna solicitud se confirma con el Evento cancelado.</bpmn:documentation>
      <bpmn:incoming>SP05_F02</bpmn:incoming>
      <bpmn:outgoing>SP05_F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP05_FinNoCanc" name="Sin sustitución (Evento cancelado)">
      <bpmn:incoming>SP05_F03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SP05_FinNoEjec" name="Fuera del alcance del sistema">
      <bpmn:documentation>Decisión del equipo: el aviso del proveedor recibido después del inicio del evento está fuera del alcance del sistema.</bpmn:documentation>
      <bpmn:incoming>SP05_F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SP05_Tramitar" name="Tramitar la sustitución de proveedor (sustitución en trámite)">
      <bpmn:documentation>El proveedor original sigue vigente hasta que se confirme el reemplazo (GL-036).</bpmn:documentation>
      <bpmn:incoming>SP05_F05</bpmn:incoming>
      <bpmn:outgoing>SP05_F40</bpmn:outgoing>
      <bpmn:startEvent id="SP05_IniSub" name="Aviso recibido">
        <bpmn:outgoing>SP05_F06</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP05_Registrar" name="Registrar la falta de disponibilidad o la cancelación del proveedor">
        <bpmn:documentation>CA-046 (US-021)</bpmn:documentation>
        <bpmn:incoming>SP05_F06</bpmn:incoming>
        <bpmn:outgoing>SP05_F07</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_UBusca">
        <bpmn:incoming>SP05_F07</bpmn:incoming>
        <bpmn:incoming>SP05_F12</bpmn:incoming>
        <bpmn:outgoing>SP05_F08</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Buscar" name="Buscar un proveedor alternativo y consultar su disponibilidad">
        <bpmn:documentation>CA-030, CA-047</bpmn:documentation>
        <bpmn:incoming>SP05_F08</bpmn:incoming>
        <bpmn:outgoing>SP05_F09</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_GwAlt" name="¿Hay una alternativa disponible?">
        <bpmn:incoming>SP05_F09</bpmn:incoming>
        <bpmn:outgoing>SP05_F10</bpmn:outgoing>
        <bpmn:outgoing>SP05_F13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_SinAlt" name="Informar al Cliente y mantener pendiente la sustitución">
        <bpmn:documentation>CA-048</bpmn:documentation>
        <bpmn:incoming>SP05_F10</bpmn:incoming>
        <bpmn:outgoing>SP05_F11</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_UPend">
        <bpmn:incoming>SP05_F11</bpmn:incoming>
        <bpmn:incoming>SP05_F20</bpmn:incoming>
        <bpmn:outgoing>SP05_F12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Impacto" name="Evaluar el impacto de la alternativa en los servicios, los costos y las condiciones">
        <bpmn:documentation>GL-029, GL-039; CA-049, CA-053</bpmn:documentation>
        <bpmn:incoming>SP05_F13</bpmn:incoming>
        <bpmn:outgoing>SP05_F14</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_GwModifica" name="¿Modifica los servicios, los costos o las condiciones acordadas?">
        <bpmn:incoming>SP05_F14</bpmn:incoming>
        <bpmn:outgoing>SP05_F15</bpmn:outgoing>
        <bpmn:outgoing>SP05_F16</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Presentar" name="Presentar la alternativa al Cliente y registrar su decisión">
        <bpmn:documentation>SE-001; CA-049, CA-054</bpmn:documentation>
        <bpmn:incoming>SP05_F16</bpmn:incoming>
        <bpmn:outgoing>SP05_F17</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_GwCliente" name="¿El Cliente aprueba la alternativa?">
        <bpmn:incoming>SP05_F17</bpmn:incoming>
        <bpmn:outgoing>SP05_F18</bpmn:outgoing>
        <bpmn:outgoing>SP05_F21</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_RechCliente" name="Registrar el rechazo, no confirmar el reemplazo y mantener pendiente la sustitución">
        <bpmn:documentation>CA-054</bpmn:documentation>
        <bpmn:incoming>SP05_F18</bpmn:incoming>
        <bpmn:outgoing>SP05_F19</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_UPend2">
        <bpmn:incoming>SP05_F19</bpmn:incoming>
        <bpmn:incoming>SP05_F24</bpmn:incoming>
        <bpmn:outgoing>SP05_F20</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Autorizar" name="Autorizar o rechazar la sustitución">
        <bpmn:documentation>SE-001; CA-049, CA-050</bpmn:documentation>
        <bpmn:incoming>SP05_F21</bpmn:incoming>
        <bpmn:outgoing>SP05_F22</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_GwAdmin" name="¿Administración autoriza?">
        <bpmn:incoming>SP05_F22</bpmn:incoming>
        <bpmn:outgoing>SP05_F23</bpmn:outgoing>
        <bpmn:outgoing>SP05_F25</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_NoAut" name="Registrar que el reemplazo no fue autorizado, informar al Cliente y mantener pendiente la sustitución">
        <bpmn:documentation>CA-050: se continúa buscando otra alternativa.</bpmn:documentation>
        <bpmn:incoming>SP05_F23</bpmn:incoming>
        <bpmn:outgoing>SP05_F24</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_UAprob">
        <bpmn:incoming>SP05_F15</bpmn:incoming>
        <bpmn:incoming>SP05_F25</bpmn:incoming>
        <bpmn:outgoing>SP05_F26</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Anexo" name="Documentar la sustitución en un anexo vinculado al contrato original">
        <bpmn:documentation>SE-001; CA-051, CA-053: proveedor sustituto, servicio, costos y condiciones cuando correspondan.</bpmn:documentation>
        <bpmn:incoming>SP05_F26</bpmn:incoming>
        <bpmn:outgoing>SP05_F27</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_GwCosto" name="¿Genera un costo adicional?">
        <bpmn:incoming>SP05_F27</bpmn:incoming>
        <bpmn:outgoing>SP05_F28</bpmn:outgoing>
        <bpmn:outgoing>SP05_F29</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP05_GwLimite" name="¿Se aprobó después del límite de 3 días hábiles antes del evento?">
        <bpmn:documentation>SE-001, CA-052</bpmn:documentation>
        <bpmn:incoming>SP05_F29</bpmn:incoming>
        <bpmn:outgoing>SP05_F30</bpmn:outgoing>
        <bpmn:outgoing>SP05_F32</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_AlSaldo" name="Incorporar el costo adicional al saldo pendiente del contrato original, que vence 3 días hábiles antes del evento">
        <bpmn:documentation>BN-005, CA-052</bpmn:documentation>
        <bpmn:incoming>SP05_F30</bpmn:incoming>
        <bpmn:outgoing>SP05_F31</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP05_PagoAntes" name="Incorporar el costo al saldo y solicitar su pago antes de confirmar el reemplazo">
        <bpmn:documentation>SE-001, CA-052: no se considera vencido; no hay otro plazo fijo.</bpmn:documentation>
        <bpmn:incoming>SP05_F32</bpmn:incoming>
        <bpmn:outgoing>SP05_F33</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="SP05_PagoRecibido" name="Pago del Cliente recibido">
        <bpmn:incoming>SP05_F33</bpmn:incoming>
        <bpmn:outgoing>SP05_F34</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SP05_PagoRecibido_def" />
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP05_VerificarPago" name="Registrar y verificar el pago">
        <bpmn:documentation>CA-052</bpmn:documentation>
        <bpmn:incoming>SP05_F34</bpmn:incoming>
        <bpmn:outgoing>SP05_F35</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP05_UConf">
        <bpmn:incoming>SP05_F28</bpmn:incoming>
        <bpmn:incoming>SP05_F31</bpmn:incoming>
        <bpmn:incoming>SP05_F35</bpmn:incoming>
        <bpmn:outgoing>SP05_F36</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP05_Confirmar" name="Confirmar el reemplazo">
        <bpmn:documentation>SE-001; CA-051, CA-052</bpmn:documentation>
        <bpmn:incoming>SP05_F36</bpmn:incoming>
        <bpmn:outgoing>SP05_F37</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP05_FinConfirmada" name="Sustitución confirmada">
        <bpmn:incoming>SP05_F37</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP05_F06" sourceRef="SP05_IniSub" targetRef="SP05_Registrar" />
      <bpmn:sequenceFlow id="SP05_F07" sourceRef="SP05_Registrar" targetRef="SP05_UBusca" />
      <bpmn:sequenceFlow id="SP05_F08" sourceRef="SP05_UBusca" targetRef="SP05_Buscar" />
      <bpmn:sequenceFlow id="SP05_F09" sourceRef="SP05_Buscar" targetRef="SP05_GwAlt" />
      <bpmn:sequenceFlow id="SP05_F10" name="No" sourceRef="SP05_GwAlt" targetRef="SP05_SinAlt" />
      <bpmn:sequenceFlow id="SP05_F11" sourceRef="SP05_SinAlt" targetRef="SP05_UPend" />
      <bpmn:sequenceFlow id="SP05_F12" sourceRef="SP05_UPend" targetRef="SP05_UBusca" />
      <bpmn:sequenceFlow id="SP05_F13" name="Sí" sourceRef="SP05_GwAlt" targetRef="SP05_Impacto" />
      <bpmn:sequenceFlow id="SP05_F14" sourceRef="SP05_Impacto" targetRef="SP05_GwModifica" />
      <bpmn:sequenceFlow id="SP05_F15" name="No" sourceRef="SP05_GwModifica" targetRef="SP05_UAprob" />
      <bpmn:sequenceFlow id="SP05_F16" name="Sí" sourceRef="SP05_GwModifica" targetRef="SP05_Presentar" />
      <bpmn:sequenceFlow id="SP05_F17" sourceRef="SP05_Presentar" targetRef="SP05_GwCliente" />
      <bpmn:sequenceFlow id="SP05_F18" name="No" sourceRef="SP05_GwCliente" targetRef="SP05_RechCliente" />
      <bpmn:sequenceFlow id="SP05_F19" sourceRef="SP05_RechCliente" targetRef="SP05_UPend2" />
      <bpmn:sequenceFlow id="SP05_F20" name="Continuar la búsqueda" sourceRef="SP05_UPend2" targetRef="SP05_UPend" />
      <bpmn:sequenceFlow id="SP05_F21" name="Sí" sourceRef="SP05_GwCliente" targetRef="SP05_Autorizar" />
      <bpmn:sequenceFlow id="SP05_F22" sourceRef="SP05_Autorizar" targetRef="SP05_GwAdmin" />
      <bpmn:sequenceFlow id="SP05_F23" name="No" sourceRef="SP05_GwAdmin" targetRef="SP05_NoAut" />
      <bpmn:sequenceFlow id="SP05_F24" sourceRef="SP05_NoAut" targetRef="SP05_UPend2" />
      <bpmn:sequenceFlow id="SP05_F25" name="Sí" sourceRef="SP05_GwAdmin" targetRef="SP05_UAprob" />
      <bpmn:sequenceFlow id="SP05_F26" sourceRef="SP05_UAprob" targetRef="SP05_Anexo" />
      <bpmn:sequenceFlow id="SP05_F27" sourceRef="SP05_Anexo" targetRef="SP05_GwCosto" />
      <bpmn:sequenceFlow id="SP05_F28" name="No" sourceRef="SP05_GwCosto" targetRef="SP05_UConf" />
      <bpmn:sequenceFlow id="SP05_F29" name="Sí" sourceRef="SP05_GwCosto" targetRef="SP05_GwLimite" />
      <bpmn:sequenceFlow id="SP05_F30" name="No" sourceRef="SP05_GwLimite" targetRef="SP05_AlSaldo" />
      <bpmn:sequenceFlow id="SP05_F31" sourceRef="SP05_AlSaldo" targetRef="SP05_UConf" />
      <bpmn:sequenceFlow id="SP05_F32" name="Sí" sourceRef="SP05_GwLimite" targetRef="SP05_PagoAntes" />
      <bpmn:sequenceFlow id="SP05_F33" sourceRef="SP05_PagoAntes" targetRef="SP05_PagoRecibido" />
      <bpmn:sequenceFlow id="SP05_F34" sourceRef="SP05_PagoRecibido" targetRef="SP05_VerificarPago" />
      <bpmn:sequenceFlow id="SP05_F35" sourceRef="SP05_VerificarPago" targetRef="SP05_UConf" />
      <bpmn:sequenceFlow id="SP05_F36" sourceRef="SP05_UConf" targetRef="SP05_Confirmar" />
      <bpmn:sequenceFlow id="SP05_F37" sourceRef="SP05_Confirmar" targetRef="SP05_FinConfirmada" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="SP05_BCancelado" name="Evento cancelado" attachedToRef="SP05_Tramitar">
      <bpmn:documentation>Caso A (BN-008): la solicitud sigue en trámite cuando se cancela el Evento.</bpmn:documentation>
      <bpmn:outgoing>SP05_F38</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP05_BCancelado_def" signalRef="Signal_EventoCancelado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP05_CerrarCan" name="Cerrar la sustitución con el motivo «Evento cancelado» (Cerrada por evento cancelado)">
      <bpmn:documentation>BN-008, SE-007, CA-087: no se confirma ni se realiza.</bpmn:documentation>
      <bpmn:incoming>SP05_F38</bpmn:incoming>
      <bpmn:outgoing>SP05_F47</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="SP05_BIniciado" name="Evento iniciado" attachedToRef="SP05_Tramitar">
      <bpmn:documentation>CA-096: se registra que el reemplazo no se concretó: lo no confirmado antes del inicio se cierra.</bpmn:documentation>
      <bpmn:outgoing>SP05_F39</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP05_BIniciado_def" signalRef="Signal_EventoIniciado" />
    </bpmn:boundaryEvent>
    <bpmn:task id="SP05_CerrarIni" name="Cerrar la sustitución como «Cerrada por inicio del evento»">
      <bpmn:documentation>CA-096: se registra que el reemplazo no se concretó</bpmn:documentation>
      <bpmn:incoming>SP05_F39</bpmn:incoming>
      <bpmn:outgoing>SP05_F48</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="SP05_GwCancel" name="¿El Evento fue cancelado antes de reasignar el proveedor?">
      <bpmn:documentation>Se evalúa al aplicar la operación confirmada (BN-006, BN-008).</bpmn:documentation>
      <bpmn:incoming>SP05_F40</bpmn:incoming>
      <bpmn:outgoing>SP05_F41</bpmn:outgoing>
      <bpmn:outgoing>SP05_F44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP05_NoAplicar" name="No reasignar el proveedor en el Evento cancelado; la solicitud conserva su confirmación y su historial">
      <bpmn:documentation>Caso B (BN-008): no se modifica la configuración del Evento cancelado ni se cierra la solicitud.</bpmn:documentation>
      <bpmn:incoming>SP05_F41</bpmn:incoming>
      <bpmn:outgoing>SP05_F42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP05_Revision" name="Registrar para revisión que la operación no pudo aplicarse por la cancelación (registro técnico en «Revisión»)">
      <bpmn:documentation>Caso B (BN-008): sin devoluciones, nuevas obligaciones ni cambios en el saldo; rige la política de no reembolso (SE-012). «Revisión» es el estado técnico del registro del Outbox, no un estado de negocio ni un trámite humano adicional.</bpmn:documentation>
      <bpmn:incoming>SP05_F42</bpmn:incoming>
      <bpmn:outgoing>SP05_F43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP05_FinRevision" name="Confirmada, no aplicada: en revisión">
      <bpmn:incoming>SP05_F43</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="SP05_Aplicar" name="Reasignar el proveedor del servicio, aunque el Evento ya haya iniciado (O-02)">
      <bpmn:documentation>Caso C (BN-006, O-02): el Evento sigue activo; si ya inició, se aplica porque se confirmó antes del inicio.</bpmn:documentation>
      <bpmn:incoming>SP05_F44</bpmn:incoming>
      <bpmn:outgoing>SP05_F45</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP05_Comunicar" name="Comunicar la sustitución al proveedor y a las personas involucradas">
      <bpmn:documentation>BN-006</bpmn:documentation>
      <bpmn:incoming>SP05_F45</bpmn:incoming>
      <bpmn:outgoing>SP05_F46</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP05_FinAplicada" name="Confirmada y aplicada al Evento">
      <bpmn:incoming>SP05_F46</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP05_UCierre">
      <bpmn:incoming>SP05_F47</bpmn:incoming>
      <bpmn:incoming>SP05_F48</bpmn:incoming>
      <bpmn:outgoing>SP05_F49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SP05_DevImp" name="Resolver los importes de la operación no realizada (SE-012)" calledElement="Proc_SP08_Devolucion">
      <bpmn:documentation>Cobros exclusivos sin efecto; devolución solo si el Evento no está cancelado (SE-012).</bpmn:documentation>
      <bpmn:incoming>SP05_F49</bpmn:incoming>
      <bpmn:outgoing>SP05_F50</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="SP05_FinImportes" name="Solicitud cerrada sin realizarse: importes resueltos">
      <bpmn:incoming>SP05_F50</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SP05_F01" sourceRef="SP05_Inicio" targetRef="SP05_GwEstado" />
    <bpmn:sequenceFlow id="SP05_F02" name="Cancelado" sourceRef="SP05_GwEstado" targetRef="SP05_NoInicioCanc" />
    <bpmn:sequenceFlow id="SP05_F03" sourceRef="SP05_NoInicioCanc" targetRef="SP05_FinNoCanc" />
    <bpmn:sequenceFlow id="SP05_F04" name="En ejecución o finalizado" sourceRef="SP05_GwEstado" targetRef="SP05_FinNoEjec" />
    <bpmn:sequenceFlow id="SP05_F05" name="En organización" sourceRef="SP05_GwEstado" targetRef="SP05_Tramitar" />
    <bpmn:sequenceFlow id="SP05_F38" sourceRef="SP05_BCancelado" targetRef="SP05_CerrarCan" />
    <bpmn:sequenceFlow id="SP05_F39" sourceRef="SP05_BIniciado" targetRef="SP05_CerrarIni" />
    <bpmn:sequenceFlow id="SP05_F40" sourceRef="SP05_Tramitar" targetRef="SP05_GwCancel" />
    <bpmn:sequenceFlow id="SP05_F41" name="Sí (caso B)" sourceRef="SP05_GwCancel" targetRef="SP05_NoAplicar" />
    <bpmn:sequenceFlow id="SP05_F42" sourceRef="SP05_NoAplicar" targetRef="SP05_Revision" />
    <bpmn:sequenceFlow id="SP05_F43" sourceRef="SP05_Revision" targetRef="SP05_FinRevision" />
    <bpmn:sequenceFlow id="SP05_F44" name="No: Evento activo (caso C)" sourceRef="SP05_GwCancel" targetRef="SP05_Aplicar" />
    <bpmn:sequenceFlow id="SP05_F45" sourceRef="SP05_Aplicar" targetRef="SP05_Comunicar" />
    <bpmn:sequenceFlow id="SP05_F46" sourceRef="SP05_Comunicar" targetRef="SP05_FinAplicada" />
    <bpmn:sequenceFlow id="SP05_F47" sourceRef="SP05_CerrarCan" targetRef="SP05_UCierre" />
    <bpmn:sequenceFlow id="SP05_F48" sourceRef="SP05_CerrarIni" targetRef="SP05_UCierre" />
    <bpmn:sequenceFlow id="SP05_F49" sourceRef="SP05_UCierre" targetRef="SP05_DevImp" />
    <bpmn:sequenceFlow id="SP05_F50" sourceRef="SP05_DevImp" targetRef="SP05_FinImportes" />
    <bpmn:textAnnotation id="SP05_NotaEstado"><bpmn:text>El aviso del proveedor recibido después del inicio del evento está fuera del alcance del sistema (decisión del equipo). Dentro del alcance: una sustitución que sigue pendiente al iniciar el evento no se confirma y se cierra como «Cerrada por inicio del evento» (borde «Evento iniciado»).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
