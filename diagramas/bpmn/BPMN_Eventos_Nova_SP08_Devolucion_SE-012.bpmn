<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_SP08" targetNamespace="https://eventosnova.example/bpmn" exporter="Eventos Nova (generador del equipo)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_SP08">
    <bpmn:documentation>Cobros pendientes exclusivos sin efecto y devolución, dentro de 5 días hábiles, de lo recibido por una solicitud cerrada sin realizarse, solo si el Evento no está cancelado (BN-005, BN-006, SE-012; US-031; CA-070, CA-071, CA-096 a CA-098).</bpmn:documentation>
    <bpmn:participant id="Part_SP08_Cliente" name="Cliente" />
    <bpmn:participant id="Part_SP08_EN" name="Eventos Nova" processRef="Proc_SP08_Devolucion" />
    <bpmn:messageFlow id="SP08_M01" name="Devolución" sourceRef="SP08_Devolver" targetRef="Part_SP08_Cliente" />
    <bpmn:messageFlow id="SP08_M02" name="Resultado de la devolución" sourceRef="SP08_Comunicar" targetRef="Part_SP08_Cliente" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_SP08_Devolucion" name="Importes de una operación no realizada (SE-012)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SP08">
      <bpmn:lane id="Lane_SP08_Coord" name="Coordinador">
        <bpmn:flowNodeRef>SP08_Comunicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08_FinDevuelto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SP08_Admin" name="Administración">
        <bpmn:flowNodeRef>SP08_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08_SinEfecto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08_GwCancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08_NoReembolso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08_FinNoReembolso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08_GwRecibido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08_FinSinImporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08_VerificarImp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08_Devolver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08_Registrar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SP08_Inicio" name="Solicitud cerrada sin realizarse">
      <bpmn:outgoing>SP08_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="SP08_SinEfecto" name="Dejar sin efecto los importes pendientes de cobro exclusivos de la solicitud">
      <bpmn:documentation>SE-012, CA-097</bpmn:documentation>
      <bpmn:incoming>SP08_F01</bpmn:incoming>
      <bpmn:outgoing>SP08_F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="SP08_GwCancelado" name="¿El Evento está cancelado?">
      <bpmn:incoming>SP08_F02</bpmn:incoming>
      <bpmn:outgoing>SP08_F03</bpmn:outgoing>
      <bpmn:outgoing>SP08_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="SP08_NoReembolso" name="Aplicar la política de no reembolso de la cancelación: sin devolución">
      <bpmn:documentation>SE-012, BN-008</bpmn:documentation>
      <bpmn:incoming>SP08_F03</bpmn:incoming>
      <bpmn:outgoing>SP08_F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP08_FinNoReembolso" name="Sin devolución (Evento cancelado)">
      <bpmn:incoming>SP08_F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SP08_GwRecibido" name="¿Se recibieron importes exclusivos de la operación no realizada?">
      <bpmn:incoming>SP08_F05</bpmn:incoming>
      <bpmn:outgoing>SP08_F06</bpmn:outgoing>
      <bpmn:outgoing>SP08_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP08_FinSinImporte" name="Sin importes por devolver">
      <bpmn:incoming>SP08_F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="SP08_VerificarImp" name="Verificar el importe a devolver (en una sustitución, solo el importe adicional atribuible al reemplazo)">
      <bpmn:documentation>SE-001, SE-012, CA-097</bpmn:documentation>
      <bpmn:incoming>SP08_F07</bpmn:incoming>
      <bpmn:outgoing>SP08_F08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP08_Devolver" name="Efectuar la devolución en 5 días hábiles desde el cierre (o desde el registro del pago, si es posterior)">
      <bpmn:documentation>SE-012, CA-097, CA-098</bpmn:documentation>
      <bpmn:incoming>SP08_F08</bpmn:incoming>
      <bpmn:outgoing>SP08_F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP08_Registrar" name="Registrar concepto, solicitud, importe, motivo, fecha y comprobante, e informar al Coordinador">
      <bpmn:documentation>CA-098 (US-031)</bpmn:documentation>
      <bpmn:incoming>SP08_F09</bpmn:incoming>
      <bpmn:outgoing>SP08_F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP08_Comunicar" name="Comunicar el resultado al Cliente">
      <bpmn:documentation>CA-098</bpmn:documentation>
      <bpmn:incoming>SP08_F10</bpmn:incoming>
      <bpmn:outgoing>SP08_F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP08_FinDevuelto" name="Devolución efectuada">
      <bpmn:incoming>SP08_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SP08_F01" sourceRef="SP08_Inicio" targetRef="SP08_SinEfecto" />
    <bpmn:sequenceFlow id="SP08_F02" sourceRef="SP08_SinEfecto" targetRef="SP08_GwCancelado" />
    <bpmn:sequenceFlow id="SP08_F03" name="Sí" sourceRef="SP08_GwCancelado" targetRef="SP08_NoReembolso" />
    <bpmn:sequenceFlow id="SP08_F04" sourceRef="SP08_NoReembolso" targetRef="SP08_FinNoReembolso" />
    <bpmn:sequenceFlow id="SP08_F05" name="No" sourceRef="SP08_GwCancelado" targetRef="SP08_GwRecibido" />
    <bpmn:sequenceFlow id="SP08_F06" name="No" sourceRef="SP08_GwRecibido" targetRef="SP08_FinSinImporte" />
    <bpmn:sequenceFlow id="SP08_F07" name="Sí" sourceRef="SP08_GwRecibido" targetRef="SP08_VerificarImp" />
    <bpmn:sequenceFlow id="SP08_F08" sourceRef="SP08_VerificarImp" targetRef="SP08_Devolver" />
    <bpmn:sequenceFlow id="SP08_F09" sourceRef="SP08_Devolver" targetRef="SP08_Registrar" />
    <bpmn:sequenceFlow id="SP08_F10" sourceRef="SP08_Registrar" targetRef="SP08_Comunicar" />
    <bpmn:sequenceFlow id="SP08_F11" sourceRef="SP08_Comunicar" targetRef="SP08_FinDevuelto" />
    <bpmn:textAnnotation id="SP08_Nota"><bpmn:text>No se devuelven ni se modifican los pagos del contrato original ni otros conceptos independientes; el cierre de la solicitud no cancela esas obligaciones (SE-012, CA-096).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="SP08_Nota_A" associationDirection="None" sourceRef="SP08_VerificarImp" targetRef="SP08_Nota" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_SP08" name="Importes de una operación no realizada (SE-012)">
    <bpmndi:BPMNPlane id="Plane_SP08" bpmnElement="Collab_SP08">
      <bpmndi:BPMNShape id="Part_SP08_Cliente_di" bpmnElement="Part_SP08_Cliente" isHorizontal="true" bioc:fill="#D4E7FA" color:background-color="#D4E7FA" bioc:stroke="#1E5A9C" color:border-color="#1E5A9C"><dc:Bounds x="0" y="0" width="1892" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_SP08_EN_di" bpmnElement="Part_SP08_EN" isHorizontal="true" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" bioc:stroke="#263238" color:border-color="#263238"><dc:Bounds x="0" y="120" width="1892" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SP08_Coord_di" bpmnElement="Lane_SP08_Coord" isHorizontal="true" bioc:fill="#A9E0D8" color:background-color="#A9E0D8" bioc:stroke="#0F766E" color:border-color="#0F766E"><dc:Bounds x="36" y="120" width="1856" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SP08_Admin_di" bpmnElement="Lane_SP08_Admin" isHorizontal="true" bioc:fill="#D2C3F0" color:background-color="#D2C3F0" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="36" y="250" width="1856" height="390" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_Inicio_di" bpmnElement="SP08_Inicio" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" bioc:stroke="#263238" color:border-color="#263238"><dc:Bounds x="164" y="297" width="36" height="36" /><bpmndi:BPMNLabel color:color="#263238"><dc:Bounds x="127" y="337" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_SinEfecto_di" bpmnElement="SP08_SinEfecto" bioc:fill="#D6C9F1" color:background-color="#D6C9F1" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="302" y="270" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_GwCancelado_di" bpmnElement="SP08_GwCancelado" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" bioc:stroke="#263238" color:border-color="#263238"><dc:Bounds x="557" y="290" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="487" y="343" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_NoReembolso_di" bpmnElement="SP08_NoReembolso" bioc:fill="#D6C9F1" color:background-color="#D6C9F1" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="502" y="400" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_FinNoReembolso_di" bpmnElement="SP08_FinNoReembolso" bioc:fill="#F8CFC7" color:background-color="#F8CFC7" bioc:stroke="#B3261E" color:border-color="#B3261E"><dc:Bounds x="564" y="557" width="36" height="36" /><bpmndi:BPMNLabel color:color="#B3261E"><dc:Bounds x="610" y="563" width="130" height="24" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_GwRecibido_di" bpmnElement="SP08_GwRecibido" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" bioc:stroke="#263238" color:border-color="#263238"><dc:Bounds x="757" y="290" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="687" y="343" width="90" height="67" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_FinSinImporte_di" bpmnElement="SP08_FinSinImporte" bioc:fill="#F8CFC7" color:background-color="#F8CFC7" bioc:stroke="#B3261E" color:border-color="#B3261E"><dc:Bounds x="764" y="427" width="36" height="36" /><bpmndi:BPMNLabel color:color="#B3261E"><dc:Bounds x="810" y="433" width="130" height="24" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_VerificarImp_di" bpmnElement="SP08_VerificarImp" bioc:fill="#D6C9F1" color:background-color="#D6C9F1" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="902" y="270" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_Devolver_di" bpmnElement="SP08_Devolver" bioc:fill="#D6C9F1" color:background-color="#D6C9F1" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="1102" y="270" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_Registrar_di" bpmnElement="SP08_Registrar" bioc:fill="#D6C9F1" color:background-color="#D6C9F1" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="1302" y="270" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_Comunicar_di" bpmnElement="SP08_Comunicar" bioc:fill="#A6E1D8" color:background-color="#A6E1D8" bioc:stroke="#0F766E" color:border-color="#0F766E"><dc:Bounds x="1502" y="140" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_FinDevuelto_di" bpmnElement="SP08_FinDevuelto" bioc:fill="#CBEBD1" color:background-color="#CBEBD1" bioc:stroke="#2E7D32" color:border-color="#2E7D32"><dc:Bounds x="1764" y="167" width="36" height="36" /><bpmndi:BPMNLabel color:color="#2E7D32"><dc:Bounds x="1727" y="207" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP08_Nota_di" bpmnElement="SP08_Nota"><dc:Bounds x="902.0" y="545.0" width="470" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SP08_F01_di" bpmnElement="SP08_F01"><di:waypoint x="200" y="315" /><di:waypoint x="302" y="315" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_F02_di" bpmnElement="SP08_F02"><di:waypoint x="462" y="315" /><di:waypoint x="557" y="315" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_F03_di" bpmnElement="SP08_F03"><di:waypoint x="582" y="340" /><di:waypoint x="582" y="400" /><bpmndi:BPMNLabel><dc:Bounds x="588" y="356" width="150" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_F04_di" bpmnElement="SP08_F04"><di:waypoint x="582" y="490" /><di:waypoint x="582" y="557" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_F05_di" bpmnElement="SP08_F05"><di:waypoint x="607" y="315" /><di:waypoint x="757" y="315" /><bpmndi:BPMNLabel><dc:Bounds x="614" y="318" width="136" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_F06_di" bpmnElement="SP08_F06"><di:waypoint x="782" y="340" /><di:waypoint x="782" y="427" /><bpmndi:BPMNLabel><dc:Bounds x="788" y="370" width="150" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_F07_di" bpmnElement="SP08_F07"><di:waypoint x="807" y="315" /><di:waypoint x="902" y="315" /><bpmndi:BPMNLabel><dc:Bounds x="814" y="318" width="81" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_F08_di" bpmnElement="SP08_F08"><di:waypoint x="1062" y="315" /><di:waypoint x="1102" y="315" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_F09_di" bpmnElement="SP08_F09"><di:waypoint x="1262" y="315" /><di:waypoint x="1302" y="315" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_F10_di" bpmnElement="SP08_F10"><di:waypoint x="1462" y="315" /><di:waypoint x="1582" y="315" /><di:waypoint x="1582" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_F11_di" bpmnElement="SP08_F11"><di:waypoint x="1662" y="185" /><di:waypoint x="1764" y="185" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_M01_di" bpmnElement="SP08_M01" bioc:stroke="#5F6B73" color:border-color="#5F6B73"><di:waypoint x="1182" y="270" /><di:waypoint x="1182" y="70" /><bpmndi:BPMNLabel><dc:Bounds x="1187" y="75" width="95" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_M02_di" bpmnElement="SP08_M02" bioc:stroke="#5F6B73" color:border-color="#5F6B73"><di:waypoint x="1582" y="140" /><di:waypoint x="1582" y="70" /><bpmndi:BPMNLabel><dc:Bounds x="1587" y="75" width="95" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP08_Nota_A_di" bpmnElement="SP08_Nota_A"><di:waypoint x="982" y="360" /><di:waypoint x="912" y="545" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>