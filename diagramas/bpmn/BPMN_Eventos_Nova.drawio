or=#22242A;labelBackgroundColor=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP02_Politica" target="SP02_Firma"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_F16" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP02_Firma" target="SP02_RegFirma"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_F17" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP02_RegFirma" target="SP02_Espera"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_F18" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP02_Espera" target="SP02_Plazo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_F19" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP02_Espera" target="SP02_Anticipo"><mxGeometry