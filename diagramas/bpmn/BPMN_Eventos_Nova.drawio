trokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP02_EvT_Devolver" target="SP02_EvT_Fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SP01_EvT" value="Llegada de T con el Evento En gestión (inicio automático)" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#37474F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fillColor=none;strokeColor=#37474F;strokeWidth=2;container=1;collapsible=0;dashed=1;dashPattern=1 4;" vertex="1" parent="MAE_Propuesta"><mxGeometry x="10.0" y="286.0" width="460.0" height="170.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP01_EvT_Inicio" value="Llega la fecha y hora de inicio del Evento (T) sin contratación confirmada" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=timer;fillColor=#FFF2A8;strokeColor=#8F6C00;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#8F6C00;" vertex="1" parent="SP01_EvT"><mxGeometry x="30.0" y="57.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP01_EvT_Cerrar" value="Cerrar el proceso de contratación sin confirmar: el Evento En gestión pasa a Cerrado sin contratación (no Cancelado)" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#0F766E;fillColor=#A6E1D8;strokeColor=#0F766E;strokeWidth=2;spacing=6;" vertex="1" parent="SP01_EvT"><mxGeometry x="120.0" y="30.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP01_EvT_Fin" value="Cerrado sin contratación (no Cancelado)" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign