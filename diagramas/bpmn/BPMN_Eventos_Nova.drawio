metry></mxCell><mxCell id="SP04_SE_SP08_Nota_A" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0213;entryY=0.0000;entryDx=0;entryDy=0;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP04_SE_SP08_VerificarImp" target="SP04_SE_SP08_Nota"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SP05_SE_SP08_Nota_A" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0213;entryY=0.0000;entryDx=0;entryDy=0;endArrow=none;dashed=1;dashPattern=1 3;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP05_SE_SP08_VerificarImp" target="SP05_SE_SP08_Nota"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SP02_SinEfecto" value="Dejar sin efecto el anticipo pendiente (el Liquidado conserva su estado); la contratación cerrada no se reabre" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="MAE_Contratacion"><mxGeometry x="2430.0" y="796.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP02_GwRecibido" value="¿Se recibió algún importe como anticipo?" style="shape=mxgraph.bpmn.gateway2;html=1;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;fillColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#22242A;" vertex="1" parent="MAE_Contratacion"><mxGeometry x="2655.0" y="816.0" width="50.0" height="50.0" as="geometry"><mxPoint x="69.0" y="-22.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP02_DevA" value="Verificar y devolver el anticipo recibido (devolución A) en 5 días hábiles desde la fecha de referencia; registrarla" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="MAE_Contratacion"><mxGeometry x="2830.0" y="796.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP02_FinDevA" value="Cerrado sin contratación: anticipo devuelto" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="MAE_Contratacion"><mxGeometry x="3060.0" y="823.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP02_NotaDevA" value="Devolución A (distinta de SE-012): la fecha de referencia es el día del cierre si el pago ya estaba registrado, o el día del registro si es posterior; ese día no cuenta y el plazo vence al final del 5.º día hábil posterior (límite exclusivo a las 00:00). La verificación tardía no reinicia el plazo. Un pago posterior al cierre se registra y verifica sin reabrir ni aplicarse a la contratación; si el Cliente desea continuar, inicia un proceso nuevo (BN-009, CA-102 a CA-106)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="MAE_Contratacion"><mxGeometry x="2820.0" y="136.0" width="350.0" height="150.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP02_EvT" value="Llegada de T con el Evento En gestión (inicio automático)" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#37474F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fillColor=none;strokeColor=#37474F;strokeWidth=2;container=1;collapsible=0;dashed=1;dashPattern=1 4;" vertex="1" parent="MAE_Contratacion"><mxGeometry x="50.0" y="816.0" width="760.0" height="220.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP02_EvT_Inicio" value="Llega la fecha y hora de inicio del Evento (T) sin contratación confirmada" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=timer;fillColor=#FFF2A8;strokeColor=#8F6C00;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#8F6C00;" vertex="1" parent="SP02_EvT"><mxGeometry x="30.0" y="92.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP02_EvT_Cerrar" value="Cerrar la contratación sin confirmar: Evento Cerrado sin contratación; contrato En preparación o Firmado, Cerrado sin confirmar (D-3)" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="SP02_EvT"><mxGeometry x="120.0" y="65.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP02_EvT_Devolver" value="Dejar sin efecto el anticipo pendiente y devolver lo recibido (devolución A), aunque se verifique después de T" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="SP02_EvT"><mxGeometry x="340.0" y="65.0" width="160.0" height="90.0" as="geometry"/></mxCell><mxCell id="SP02_NotaEvT" value="Implementado (ADR-008): el trabajador aplica la llegada de T, cierra también el contrato Firmado y avisa a Cliente, Coordinador y Administración (decisiones internas, sin aprobación externa). Desde T no se confirma (CA-110)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="SP02_EvT"><mxGeometry x="120.0" y="178.0" width="620.0" height="36.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP02_EvT_Fin" value="Cerrado sin contratación (no Cancelado)" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="SP02_EvT"><mxGeometry x="560.0" y="92.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="MAE_F320" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP02_SinEfecto" target="SP02_GwRecibido"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_F321" value="No" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP02_GwRecibido" target="SP02_FinCerrado"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5203.0" y="985.0"/></Array><mxPoint x="28.0" y="-97.9" as="offset"/></mxGeometry></mxCell><mxCell id="MAE_F322" value="Sí" style="edgeStyle=none;html=1;rounded