line=catching;symbol=multiple;fillColor=#FFF2A8;strokeColor=#8F6C00;strokeWidth=2;" vertex="1" parent="MAE_Saldo"><mxGeometry x="867.0" y="36.0" width="50.0" height="50.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_FinCancelacion" value="Evento cancelado por falta de regularización" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=error;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="MAE_Saldo"><mxGeometry x="3274.0" y="173.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_FinLiquidado" value="Saldo liquidado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#CBEBD1;strokeColor=#2E7D32;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#2E7D32;" vertex="1" parent="MAE_Saldo"><mxGeometry x="1474.0" y="303.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_FinRegular" value="Saldo regularizado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#CBEBD1;strokeColor=#2E7D32;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#2E7D32;" vertex="1" parent="MAE_Saldo"><mxGeometry x="2874.0" y="173.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_GwLiquidado" value="¿El saldo pendiente quedó liquidado?" style="shape=mxgraph.bpmn.gateway2;html=1;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;fillColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#22242A;" vertex="1" parent="MAE_Saldo"><mxGeometry x="1267.0" y="296.0" width="50.0" height="50.0" as="geometry"><mxPoint x="-50.0" y="1.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_GwRegular" value="¿El Cliente pagó el saldo vencido y los cargos dentro de las 24 horas?" style="shape=mxgraph.bpmn.gateway2;html=1;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;fillColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#22242A;" vertex="1" parent="MAE_Saldo"><mxGeometry x="2067.0" y="296.0" width="50.0" height="50.0" as="geometry"><mxPoint x="-50.0" y="1.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_Inicio" value="Contratación confirmada" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=general;fillColor=#FFFFFF;strokeColor=#263238;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#263238;" vertex="1" parent="MAE_Saldo"><mxGeometry x="74.0" y="303.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_Moratorios" value="Comunicar al Cliente el saldo vencido y los cargos moratorios, registrados como concepto separado" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#0F766E;fillColor=#A6E1D8;strokeColor=#0F766E;strokeWidth=2;spacing=6;" vertex="1" parent="MAE_Saldo"><mxGeometry x="1412.0" y="146.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_NoRegular" value="Informar al Coordinador que el saldo y los cargos moratorios no se regularizaron" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="MAE_Saldo"><mxGeometry x="2012.0" y="406.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_PagoSaldo" value="Pago del saldo recibido" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=catching;symbol=message;fillColor=#FFF2A8;strokeColor=#8F6C00;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#8F6C00;" vertex="1" parent="MAE_Saldo"><mxGeometry x="1074.0" y="43.0" width="36.0" height="36.0" as="geometry"><mxPoint x="61.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_Plazo24" value="24 horas naturales desde la comunicación de los cargos: plazo del Cliente para pagar" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=catching;symbol=timer;fillColor=#FFF2A8;strokeColor=#8F6C00;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#8F6C00;" vertex="1" parent="MAE_Saldo"><mxGeometry x="1674.0" y="173.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="-126.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_Protocolo" value="Activar el protocolo de cobro: enviar un recordatorio amistoso y registrar el seguimiento" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#0F766E;fillColor=#A6E1D8;strokeColor=#0F766E;strokeWidth=2;spacing=6;" vertex="1" parent="MAE_Saldo"><mxGeometry x="1212.0" y="146.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_RegCancelacion" value="Registrar la cancelación del evento e indicar el motivo" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#0F766E;fillColor=#A6E1D8;strokeColor=#0F766E;strokeWidth=2;spacing=6;" vertex="1" parent="MAE_Saldo"><mxGeometry x="3012.0" y="146.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_RegLiquidacion" value="Registrar y verificar la liquidación, aunque sea después del plazo, e informar al Coordinador" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="MAE_Saldo"><mxGeometry x="2212.0" y="276.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_Retomar" value="Retomar la organización del evento y las solicitudes detenidas que cumplan sus condiciones" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#0F766E;fillColor=#A6E1D8;strokeColor=#0F766E;strokeWidth=2;spacing=6;" vertex="1" parent="MAE_Saldo"><mxGeometry x="2612.0" y="146.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_Revisar" value="Revisar los pagos y comprobar si el Cliente los efectuó dentro del plazo" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="MAE_Saldo"><mxGeometry x="1812.0" y="276.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_Senal" value="Saldo vencido regularizado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=throwing;symbol=signal;fillColor=#FFFFFF;strokeColor=#263238;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#263238;" vertex="1" parent="MAE_Saldo"><mxGeometry x="2474.0" y="303.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_UEsp" value="" style="shape=mxgraph.bpmn.gateway2;html=1;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;fillColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;" vertex="1" parent="MAE_Saldo"><mxGeometry x="667.0" y="36.0" width="50.0" height="50.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_Vence" value="Fecha límite vencida sin que el Cliente haya pagado el saldo" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=catching;symbol=timer;fillColor=#FFF2A8;strokeColor=#8F6C00;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#8F6C00;" vertex="1" parent="MAE_Saldo"><mxGeometry x="874.0" y="173.0" width="36.0" height="36.0" as="geometry"><mxPoint x="-72.5" y="-40.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_Verificar" value="Registrar y verificar el pago del saldo" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="MAE_Saldo"><mxGeometry x="1012.0" y="276.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_BCancEjec" value="Solicitud de cancelación con el evento iniciado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundNonint;symbol=message;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="MAE_Ejecucion"><mxGeometry x="62.0" y="72.0" width="36.0" height="36.0" as="geometry"><mxPoint x="-72.5" y="-12.0" as="offset"/></mxGeometry></mxCell><mxCell id="MAE_BCancSol" value="Solicitud de cancelación del Cliente" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundInt;symbol=message;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="MAE_Organizacion"><mxGeometry x="4454.0" y="884.0" width="36.0" height="36.0" as="geometry"><mxPoint x="-75.0" y="-10.0" as="offset"/></mxGeometry></mxCell><mxCell id="MAE_BFaltaReg" value="Cancelación registrada por falta de regularización" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundInt;symbol=error;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="MAE_Organizacion"><mxGeometry x="4214.0" y="884.0" width="36.0" height="36.0" as="geometry"><mxPoint x="-70.0" y="-10.0" as="offset"/></mxGeometry></mxCell><mxCell id="MAE_BInicio" value="Fecha y hora de inicio del evento" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundInt;symbol=timer;fillColor=#FFF2A8;strokeColor=#8F6C00;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#8F6C00;" vertex="1" parent="MAE_Organizacion"><mxGeometry x="4454.0" y="-18.0" width="36.0" height="36.0" as="geometry"><mxPoint x="63.0" y="-60.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP03_BCancelado" value="Evento cancelado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundInt;symbol=signal;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="SP03_Tramitar"><mxGeometry x="1074.0" y="-18.0" width="36.0" height="36.0" as="geometry"><mxPoint x="58.0" y="-60.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP03_BIniciado" value="Evento iniciado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundInt;symbol=signal;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="SP03_Tramitar"><mxGeometry x="1874.0" y="-18.0" width="36.0" height="36.0" as="geometry"><mxPoint x="-62.0" y="-60.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP04_BCancelado" value="Evento cancelado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundInt;symbol=signal;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="SP04_Tramitar"><mxGeometry x="969.0" y="-18.0" width="36.0" height="36.0" as="geometry"><mxPoint x="58.0" y="-60.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP04_BIniciado" value="Evento iniciado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundInt;symbol=signal;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="SP04_Tramitar"><mxGeometry x="2369.0" y="-18.0" width="36.0" height="36.0" as="geometry"><mxPoint x="-62.0" y="-60.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP05_BCancelado" value="Evento cancelado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundInt;symbol=signal;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="SP05_Tramitar"><mxGeometry x="369.0" y="-18.0" width="36.0" height="36.0" as="geometry"><mxPoint x="58.0" y="-60.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP05_BIniciado" value="Evento iniciado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundInt;symbol=signal;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="SP05_Tramitar"><mxGeometry x="2369.0" y="-18.0" width="36.0" height="36.0" as="geometry"><mxPoint x="-62.0" y="-60.0" as="offset"/></mxGeometry></mxCell><mxCell id="MAE_BandaA" value="A · Ciclo del Evento: registro, propuesta (SP-01), contratación (SP-02), organización con el seguimiento del saldo (SP-06), inicio, ejecución, finalización y cancelación (SP-07)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="125.0" y="260.0" width="900.0" height="60.0" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_BandaB" value="B · Solicitud de cambio (SP-03 desplegado). Instancia independiente iniciada por el Cliente. Mientras sigue en trámite, las señales «Evento iniciado» y «Evento cancelado» de la banda A la cierran; SE-012 (SP-08) desplegado." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="14125.0" y="260.0" width="900.0" height="60.0" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_BandaC" value="C · Solicitud de servicio adicional (SP-04 desplegado). Instancia independiente iniciada por el Cliente; el rechazo de Administración termina en «No autorizada»; SE-012 (SP-08) desplegado." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="23125.0" y="260.0" width="900.0" height="60.0" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_BandaD" value="D · Sustitución de proveedor (SP-05 desplegado). Instancia independiente iniciada por el aviso del Proveedor; se comprueba el estado del Evento y los rechazos vuelven a la búsqueda; SE-012 (SP-08) desplegado." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="31525.0" y="260.0" width="900.0" height="60.0" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_Leyenda" value="Leyenda de colores: azul claro = Cliente; turquesa = Coordinador; lavanda = Administración; ámbar = Proveedor; amarillo = temporizadores y esperas; verde = resultado satisfactorio; coral = rechazo, cancelación o resultado no procedente; blanco = inicios y compuertas. Los subprocesos SP-01 a SP-08 aparecen desplegados dentro de este diagrama." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="125.0" y="170.0" width="1300.0" height="60.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP02_NotaPago" value="El plazo de 24 horas es para que el Cliente efectúe el pago. Si pagó dentro de él, la contratación queda pendiente de que Administración registre y verifique el anticipo, aunque lo haga después; no se cierra por esa demora (BN-009, CA-021)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="MAE_Contratacion"><mxGeometry x="232.0" y="291.0" width="560.0" height="50.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_NotaCanc" value="La cancelación no es automática: la registra el Coordinador. Un pago efectuado después de las 24 horas no la evita; uno efectuado dentro de ellas cuenta aunque Administración lo registre o verifique después. Si el evento inicia antes de registrarla, ya no procede y el saldo vencido y los cargos moratorios se conservan como adeudo (BN-005)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="MAE_Saldo"><mxGeometry x="2612.0" y="9.0" width="440.0" height="100.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_NotaSol" value="Mientras exista saldo vencido, las nuevas solicitudes de cambio o de servicio adicional quedan detenidas (SE-006)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="MAE_Saldo"><mxGeometry x="1510.0" y="16.0" width="265.0" height="62.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_NotaSust" value="El costo adicional de una sustitución aprobada y autorizada se incorpora a este saldo (BN-005, CA-052)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="MAE_Saldo"><mxGeometry x="212.0" y="426.0" width="290.0" height="50.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_NotaSol" value="Con la señal «Evento cancelado» (BN-008): caso A, cada solicitud de cambio, servicio adicional o sustitución que sigue en trámite se cierra con el motivo «Evento cancelado»; caso B, una operación ya confirmada que todavía no se aplicó no se aplica al Evento cancelado, conserva su confirmación y queda registrada para revisión. Las operaciones ya aplicadas no cambian (ver SP-03, SP-04 y SP-05)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="MAE_Cancelacion"><mxGeometry x="907.0" y="146.0" width="560.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_NotaSaldo" value="La cancelación no anula el saldo pendiente del contrato original: queda registrado y su exigibilidad se rige por el contrato. No se crea un proceso de cobro adicional y no se generan reembolsos (BN-008, SE-012)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="MAE_Cancelacion"><mxGeometry x="812.0" y="546.0" width="470.0" height="70.0" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_NotaO02" value="Las operaciones confirmadas antes del inicio que todavía no se aplicaron se aplican aunque el Evento ya haya iniciado (O-02, BN-006): ver las bandas B, C y D." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="Lane_MAE_Coord"><mxGeometry x="11466.0" y="25.0" width="300.0" height="70.0" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_NotaBN005" value="Si el evento inicia antes de que el Coordinador registre la cancelación por falta de regularización, la cancelación ya no procede y el saldo vencido y los cargos moratorios se conservan como adeudo (BN-005)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="Lane_MAE_Admin"><mxGeometry x="6666.0" y="295.0" width="430.0" height="70.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP03_SE_SP08_Nota" value="No se devuelven ni se modifican los pagos del contrato original ni otros conceptos independientes; el cierre de la solicitud no cancela esas obligaciones (SE-012, CA-096)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="SP03_DevImp"><mxGeometry x="812.0" y="421.0" width="470.0" height="60.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP04_SE_SP08_Nota" value="No se devuelven ni se modifican los pagos del contrato original ni otros conceptos independientes; el cierre de la solicitud no cancela esas obligaciones (SE-012, CA-096)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="SP04_DevImp"><mxGeometry x="812.0" y="421.0" width="470.0" height="60.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP04_NotaEleg" value="Con la solicitud presentada a tiempo y la alternativa encontrada dentro del plazo, la elegibilidad se conserva durante la aprobación del Cliente y la autorización de Administración, siempre que el Evento no haya iniciado (CA-080)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="SP04_Tramitar"><mxGeometry x="3632.0" y="29.0" width="330.0" height="80.0" as="geometry"/></mxCell><mxCell id="SP05_NotaEstado" value="El aviso del proveedor recibido después del inicio del evento está fuera del alcance del sistema (decisión del equipo). Dentro del alcance: una sustitución que sigue pendiente al iniciar el evento no se confirma y se cierra como «Cerrada por inicio del evento» (borde «Evento iniciado»)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="Lane_MAE_Coord"><mxGeometry x="31506.0" y="50.0" width="360.0" height="84.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP05_SE_SP08_Nota" value="No se devuelven ni se modifican los pagos del contrato original ni otros conceptos independientes; el cierre de la solicitud no cancela esas obligaciones (SE-012, CA-096)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="SP05_DevImp"><mxGeometry x="812.0" y="421.0" width="470.0" height="60.0" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_F01" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP01_Inicio" target="SP01_Elaborar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="MAE_F02" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=1.00