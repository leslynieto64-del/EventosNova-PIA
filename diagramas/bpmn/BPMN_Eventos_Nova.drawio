etry></mxCell><mxCell id="MAE_F07" value="Acepta la&lt;br&gt;versión vigente" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP01_GwDecision" target="SP01_Aceptar"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="17.2" as="offset"/></mxGeometry></mxCell><mxCell id="MAE_F08" value="No acepta ni&lt;br&gt;solicita&lt;br&gt;cambios" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP01_GwDecision" target="SP01_Cerrar"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1815.0" y="725.0"/></Array><mxPoint x="73.5" y="59.8" as="offset"/></mxGeometry></mxCell><mxCell id="MAE_F09" value="Solicita&lt;br&gt;cambios" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP01_GwDecision" target="SP01_NuevaVersion"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1815.0" y="985.0"/></Array><mxPoint x="188.5" y="-52.8" as="offset"/></mxGeometry></mxCell><mxCell id="MAE_F10" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source=