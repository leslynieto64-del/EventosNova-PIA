<mxfile host="drawio" type="device" version="24.7.17"><diagram id="SP10" name="SP-10 · Llegada de T: inicio automático y finalización del evento"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="586" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="SP-10 · Llegada de T: inicio automático y finalización del evento" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#1F4E79;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1900" height="28" as="geometry"/></mxCell><mxCell id="c2" value="C-01, C-02, D-3, S-7 (ADR-008, ADR-009) · US-030, US-033 · BN-006, BN-010" style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1900" height="20" as="geometry"/></mxCell><mxCell id="n_lane_0" value="Sistema (trabajador)" style="swimlane;horizontal=0;startSize=34;fillColor=#7EA6D3;swimlaneFillColor=#EEF5FC;strokeColor=#7EA6D3;fontColor=#FFFFFF;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="96.0" width="1900.0" height="230.0" as="geometry"/></mxCell><mxCell id="n_lane_1" value="Coordinador" style="swimlane;horizontal=0;startSize=34;fillColor=#A68BC4;swimlaneFillColor=#F3EEF8;strokeColor=#A68BC4;fontColor=#FFFFFF;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="326.0" width="1900.0" height="230.0" as="geometry"/></mxCell><mxCell id="n_s" value="Ciclo cada 2 s" style="shape=mxgraph.bpmn.event;outline=standard;symbol=timer;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;fontSize=10;fontFamily=Arial;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="157.0" y="172.0" width="36.0" height="36.0" as="geometry"/></mxCell><mxCell id="n_t1" value="Buscar eventos cuya fecha y hora de inicio (T) ya llegó" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="275.0" y="160.0" width="150.0" height="62.0" as="geometry"/></mxCell><mxCell id="n_g1" value="Estado del evento en T" style="shape=mxgraph.bpmn.gateway2;gwType=exclusive;html=1;verticalLabelPosition=top;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=10;fontFamily=Arial;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="501.0" y="166.0" width="48.0" height="48.0" as="geometry"/></mxCell><mxCell id="n_t2" value="Iniciar el evento: «En ejecución» (EventoIniciado)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="625.0" y="120.0" width="150.0" height="62.0" as="geometry"/></mxCell><mxCell id="n_t3" value="Cerrar solicitudes de cambio, adicionales y sustituciones abiertas: causa «Inicio del evento»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="800.0" y="120.0" width="150.0" height="70.0" as="geometry"/></mxCell><mxCell id="n_t4" value="Cerrar sin contratación: Evento «Cerrado sin contratación»; contrato no confirmado «Cerrado sin confirmar»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="625.0" y="220.0" width="150.0" height="70.0" as="geometry"/></mxCell><mxCell id="n_e00" value="Proceso de contratación cerrado" style="shape=mxgraph.bpmn.event;outline=end;symbol=general;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;fontSize=10;fontFamily=Arial;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3.5;" vertex="1" parent="1"><mxGeometry x="857.0" y="232.0" width="36.0" height="36.0" as="geometry"/></mxCell><mxCell id="n_c1" value="Inicio manual de respaldo (solo si el automático no actualizó el estado y nunca antes de T)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="625.0" y="390.0" width="150.0" height="74.0" as="geometry"/></mxCell><mxCell id="n_c2" value="Ejecutar el evento con los proveedores" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1150.0" y="390.0" width="150.0" height="62.0" as="geometry"/></mxCell><mxCell id="n_g2" value="¿El evento se realizó y concluyó?" style="shape=mxgraph.bpmn.gateway2;gwType=exclusive;html=1;verticalLabelPosition=top;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=10;fontFamily=Arial;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1376.0" y="396.0" width="48.0" height="48.0" as="geometry"/></mxCell><mxCell id="n_c3" value="Registrar finalización con fecha: «Finalizado»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1500.0" y="390.0" width="150.0" height="62.0" as="geometry"/></mxCell><mxCell id="n_e1" value="Evento finalizado" style="shape=mxgraph.bpmn.event;outline=end;symbol=general;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;fontSize=10;fontFamily=Arial;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3.5;" vertex="1" parent="1"><mxGeometry x="1732.0" y="402.0" width="36.0" height="36.0" as="geometry"/></mxCell><mxCell id="n_n" value="Los pagos pendientes al inicio se conservan (H-09). Un evento Cancelado nunca pasa a Finalizado; solo se finaliza un evento «En ejecución» (CA-094, CA-095)." style="shape=note;size=12;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=10;fill